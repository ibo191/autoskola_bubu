---
export const prerender = true;
import Base from '../layouts/Base.astro';
import FinalCta from '../components/FinalCta.astro';
import { branches } from '../lib/catalog';

const phoneLabel = (phone: string) => phone.replace('+420', '+420 ');
---

<Base
  title="Kontakt a pobočky"
  description="Kontakty na Autoškolu BuBu. Telefon, e-mail a otevírací hodiny poboček Střížkov, Kladno a Statenice, včetně obecného kontaktního formuláře."
>
  <section class="page-hero contact-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Drobečková navigace">
        <a href="/">Domů</a><span>/</span><span>Kontakt</span>
      </nav><span class="eyebrow">Kontakty a pobočky</span><h1>
        Ozvěte se.<br />Pomůžeme vám vybrat správný kurz.
      </h1><p class="lead">
        Zavolejte na konkrétní pobočku, napište e-mail, nebo nám pošlete obecný dotaz přes formulář.
        Odpovíme lidsky a bez nátlaku.
      </p><div class="actions">
        <a class="btn primary" href="tel:+420725717755">Zavolat na Střížkov</a><a
          class="btn secondary"
          href="#formular">Napsat dotaz</a
        >
      </div>
    </div>
  </section>

  <section class="section" id="pobocky">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Pobočky Autoškoly BuBu</span><h2>
            Telefon, e-mail a otevírací hodiny.
          </h2><p>
            Každá pobočka řeší svoje zápisy a lokální výuku. Když si nejste jistí, napište přes
            obecný formulář níže.
          </p>
        </div>
      </div>
      <div class="contact-grid">
        {
          branches.map((branch) => (
            <article class="contact-card">
              <span class="eyebrow">{branch.locality}</span>
              <h3>{branch.name}</h3>
              <dl>
                <div>
                  <dt>Adresa</dt>
                  <dd>{branch.address}</dd>
                </div>
                <div>
                  <dt>Telefon</dt>
                  <dd>
                    <a href={`tel:${branch.phone}`}>{phoneLabel(branch.phone)}</a>
                  </dd>
                </div>
                <div>
                  <dt>E-mail</dt>
                  <dd>
                    <a href={`mailto:${branch.email}`}>{branch.email}</a>
                  </dd>
                </div>
                <div>
                  <dt>Otevírací hodiny</dt>
                  <dd>{branch.hours ?? 'Otevírací dobu si prosím ověřte telefonicky.'}</dd>
                </div>
              </dl>
              <div class="card-actions">
                <a class="text-link" href={`mailto:${branch.email}`}>
                  Napsat na pobočku →
                </a>
                <a class="text-link" href={`tel:${branch.phone}`}>
                  Zavolat →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section tinted" id="formular">
    <div class="container contact-split">
      <div>
        <span class="eyebrow">Obecný dotaz</span><h2>Napište nám, co potřebujete vyřešit.</h2><p
          class="lead"
        >
          Hodí se pro otázky k výběru kurzu, cenám, zápisu, dokumentům nebo organizaci výuky. Pokud
          už víte pobočku, napište ji rovnou do zprávy.
        </p>
        <div class="notice contact-note">
          <strong>Chcete se rovnou přihlásit?</strong><br />Nejrychlejší cesta je přes tlačítko
          „Přihlásit se“, kde si vyberete kurz i termín osobního zápisu.
        </div>
      </div>
      <form class="form-card" data-general-contact>
        <label>Jméno a příjmení<input name="name" autocomplete="name" required /></label>
        <label>E-mail<input name="email" type="email" autocomplete="email" required /></label>
        <label>Telefon<input name="phone" type="tel" autocomplete="tel" /></label>
        <label>Předmět<input name="subject" value="Dotaz k autoškole" /></label>
        <label>Vaše zpráva<textarea name="message" rows="6" required></textarea></label>
        <label class="hp">Web<input name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="btn primary" type="submit">Odeslat dotaz</button>
        <p class="small" data-contact-status role="status"></p>
      </form>
    </div>
  </section>

  <FinalCta />
  <script src="../scripts/contact.ts"></script>
</Base>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }
  .contact-card,
  .form-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    padding: 30px;
    box-shadow: var(--shadow);
  }
  .contact-card h3 {
    font-size: 1.8rem;
  }
  .contact-card dl {
    display: grid;
    gap: 18px;
    margin: 24px 0 0;
  }
  .contact-card dt {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .contact-card dd {
    margin: 5px 0 0;
    color: var(--ink);
    font-weight: 650;
  }
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 26px;
  }
  .contact-split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: 42px;
    align-items: start;
  }
  .contact-note {
    margin-top: 28px;
  }
  .form-card {
    display: grid;
    gap: 16px;
  }
  .form-card label {
    display: grid;
    gap: 7px;
    font-weight: 700;
    color: var(--ink);
  }
  .form-card input,
  .form-card textarea {
    width: 100%;
    border: 1px solid #cbd9d9;
    border-radius: 0.75rem;
    padding: 13px 14px;
    background: #fff;
    color: var(--ink);
  }
  .form-card textarea {
    resize: vertical;
  }
  .form-card .hp {
    position: absolute;
    left: -10000px;
  }
  .form-card .small {
    min-height: 1.5em;
  }
  @media (max-width: 900px) {
    .contact-grid,
    .contact-split {
      grid-template-columns: 1fr;
    }
  }
</style>
