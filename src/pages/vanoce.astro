---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { christmasCampaign, campaignCourseOptions } from '../lib/campaigns/config';
import { branches, money } from '../lib/catalog';
import { campaignConsent } from '../lib/campaigns/requests';

const courses = campaignCourseOptions();
const heroPerex = `Vánoční poukaz na kurz Autoškoly BUBU. Zaplatíte pouze zálohu ${money(christmasCampaign.depositCzk)} a my vám připravíme fyzický poukaz jako dárek.`;
---

<Base
  title="Vánoční poukaz Autoškola BuBu – darujte řidičák bez stresu"
  description="Vánoční poukaz Autoškoly BuBu. Rezervujte dárek se zálohou 5 000 Kč, dárkovým balením a bonusem až 1 800 Kč."
>
  <main class="christmas-page" data-campaign="vanoce">
    <section class="xmas-hero">
      <div class="snow snow-a">❄</div><div class="snow snow-b">❄</div><div class="snow snow-c">
        ✦
      </div>
      <div class="container xmas-hero-grid">
        <div class="xmas-copy">
          <span class="xmas-kicker">Vánoce v BUBU</span>
          <h1>Darujte letos <span>řidičák bez stresu.</span></h1>
          <p class="xmas-lead">{heroPerex}</p>
          <div class="deposit-box">
            <span class="coin-icon">▣</span>
            <div>
              <strong
                >{money(christmasCampaign.depositCzk)} záloha na kurz + {
                  money(christmasCampaign.packagingAndDeliveryCzk)
                } dárkové balení a doručení</strong
              ><small>Zálohu následně v plné výši odečteme z ceny kurzu.</small>
            </div>
          </div>
          <div class="xmas-actions">
            <a class="btn primary gift-btn" href="#poukaz-form">Chci darovat řidičák →</a>
            <a class="bonus-pill" href="#bonusy"
              ><span>🎁</span> + Vánoční bonus <strong>až {money(1800)}</strong></a
            >
          </div>
          <div class="mini-proof" aria-label="Výhody poukazu">
            <span>Fyzický poukaz jako dárek</span><span>Platí na všechny pobočky</span><span
              >Snadné objednání</span
            >
          </div>
        </div>
        <div class="hero-visual" aria-label="Dárkový poukaz Autoškola BuBu">
          <div class="winter-window"></div>
          <div class="voucher-scene">
            <div class="envelope"></div>
            <article class="voucher-paper">
              <img src="/brand/logo.png" alt="Autoškola BuBu" />
              <span>DÁRKOVÝ POUKAZ</span>
              <strong>na kurz autoškoly</strong>
              <p>Splňte si své cíle</p>
              <small>♡</small>
            </article>
            <div class="car-key"><span>▣</span><span>⌁</span><span>▣</span></div>
            <img
              class="bubak-gift"
              src="/brand/bubak.png"
              alt="Maskot Autoškoly BuBu s vánočním poukazem"
            />
            <div class="gift-box"></div>
            <p class="hero-note">VÍCE NEŽ JEN ŘIDIČÁK.<br />SVOBODA NA DOSAH.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="xmas-section soft-blue">
      <div class="container">
        <h2 class="center-title">Proč je to dobrý dárek</h2>
        <div class="reason-grid">
          <article>
            <span>🎁</span><h3>Praktický dárek s dlouhodobou hodnotou</h3><p>
              Nejen radost, ale i investice do budoucnosti.
            </p>
          </article>
          <article>
            <span>🗓</span><h3>Nemusíte znát přesný termín zahájení</h3><p>
              Obdarovaný si vybere, kdy začne.
            </p>
          </article>
          <article>
            <span>☝</span><h3>Jednoduché objednání</h3><p>Vše vyřídíte online za pár minut.</p>
          </article>
          <article>
            <span>☆</span><h3>Bonus navíc před zkouškou</h3><p>
              Ještě větší jistota na závěrečné zkoušce.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="xmas-section">
      <div class="container">
        <h2 class="center-title">Co dostanete</h2>
        <div class="what-grid">
          <article>
            <div class="mini-asset voucher-mini"><span>DÁRKOVÝ POUKAZ</span></div><h3>
              Fyzický vánoční poukaz
            </h3><p>Kvalitní tištěný poukaz s vánočním designem.</p>
          </article>
          <article>
            <div class="mini-asset envelope-mini"></div><h3>Dárkové balení</h3><p>
              Elegantní obálka s vánočním motivem.
            </p>
          </article>
          <article>
            <div class="mini-asset note-mini">
              Protože velké cesty začínají malými rozhodnutími. ♡
            </div><h3>Možnost osobního věnování</h3><p>
              Přidejte vlastní přání, my ho krásně vytiskneme.
            </p>
          </article>
          <article>
            <div class="mini-asset bubak-mini"><img src="/brand/bubak.png" alt="" /></div><h3>
              Speciální bonus před zkouškou
            </h3><p>Vybere si jeden ze dvou užitečných bonusů.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="xmas-section bonus-section" id="bonusy">
      <div class="container narrow">
        <h2 class="center-title">Vyberte si bonus</h2>
        <div class="bonus-choice-grid">
          {
            christmasCampaign.bonusVariants.map((bonus, index) => (
              <label class:list={['bonus-choice', index === 1 && 'selected']}>
                <input type="radio" name="visualBonus" checked={index === 1} />
                <span class="bonus-icon">{index === 0 ? '🚙' : '☑'}</span>
                <span class="bonus-copy">
                  <>
                    <strong>
                      {index === 0 ? 'Více času za volantem' : 'Zkouška bez překvapení'}
                    </strong>
                    <small>{bonus.title}</small>
                    <em>Hodnota {money(bonus.valueCzk)}</em>
                  </>
                </span>
              </label>
            ))
          }
        </div>
        <p class="bonus-note">ⓘ Obdarovaný si bonus vybere později.</p>
      </div>
    </section>

    <section class="xmas-section">
      <div class="container">
        <h2 class="center-title">Jak to funguje</h2>
        <div class="how-grid">
          <article>
            <span>⌕</span><h3>1. Vyberete kurz a pobočku</h3><p>Zvolte typ kurzu a naši pobočku.</p>
          </article>
          <article>
            <span>✎</span><h3>2. Vyplníte údaje k poukazu</h3><p>
              Zadáte kontakt a případné věnování.
            </p>
          </article>
          <article>
            <span>🛒</span><h3>3. Odešlete objednávku</h3><p>
              Zatím bez online platby; ozveme se s potvrzením.
            </p>
          </article>
          <article>
            <span>🎁</span><h3>4. Obdarovaný dokončí přihlášení</h3><p>
              A vyrazí za svým řidičákem s naší podporou.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="xmas-section faq-lite">
      <div class="container narrow">
        <h2 class="center-title">Časté dotazy</h2>
        <div class="faq-grid">
          <details>
            <summary>Jak funguje záloha 5 000 Kč?</summary><p>
              Záloha se následně v plné výši odečte z ceny vybraného kurzu.
            </p>
          </details>
          <details>
            <summary>Musím znát termín zahájení kurzu?</summary><p>
              Nemusíte. Obdarovaný si termín a další detaily domluví později.
            </p>
          </details>
          <details>
            <summary>Co je zahrnuto v částce 200 Kč?</summary><p>
              Dárkové balení a doručení fyzického poukazu.
            </p>
          </details>
          <details>
            <summary>Kdy si obdarovaný vybírá svůj bonus?</summary><p>
              Bonus si vybere později při domluvě kurzu s autoškolou.
            </p>
          </details>
        </div>
      </div>
    </section>

    <section class="xmas-bottom-cta">
      <div class="container bottom-card">
        <img src="/brand/bubak.png" alt="Autoškola BuBu" />
        <div>
          <h2>Připravte letos dárek, který má skutečnou hodnotu.</h2><p>
            Vánoční poukaz na kurz Autoškoly BUBU – více než jen řidičák.
          </p>
        </div>
        <a class="btn secondary cta-white" href="#poukaz-form">Objednat vánoční poukaz →</a>
      </div>
    </section>

    <section class="xmas-section voucher-form-section" id="poukaz-form">
      <div class="container form-wrap">
        <div class="form-copy">
          <span class="xmas-kicker">Rezervace poukazu</span>
          <h2>Objednat vánoční poukaz</h2>
          <p>
            Vyplňte údaje a my se ozveme s potvrzením. Online platbu dopojíme až po finálním
            schválení platebního procesu.
          </p>
          <div class="price-chip">
            <strong>{money(christmasCampaign.onlineTotalCzk)}</strong><span
              >{money(christmasCampaign.depositCzk)} záloha + {
                money(christmasCampaign.packagingAndDeliveryCzk)
              } balení a doručení</span>
          </div>
        </div>
        <form class="voucher-form" id="voucher-form" novalidate>
          <div class="form-grid">
            <label
              >Jméno kupujícího<input name="firstName" autocomplete="given-name" required /></label
            >
            <label
              >Příjmení kupujícího<input
                name="lastName"
                autocomplete="family-name"
                required
              /></label
            >
            <label>E-mail<input name="email" type="email" autocomplete="email" required /></label>
            <label>Telefon<input name="phone" autocomplete="tel" required /></label>
            <label>Jméno obdarovaného<input name="recipientFirstName" required /></label>
            <label>Příjmení obdarovaného<input name="recipientLastName" /></label>
            <label
              >Kurz<select name="course"
                ><option value="">Domluvíme později</option>{
                  courses.map((course) => (
                    <option value={course.id}>
                      {course.label} – {course.name}
                    </option>
                  ))
                }</select
              ></label
            >
            <label
              >Pobočka<select name="branch"
                ><option value="">Domluvíme později</option>{
                  branches.map((branch) => <option value={branch.id}>{branch.name}</option>)
                }</select
              ></label
            >
            <label class="wide"
              >Vybraný bonus<select name="bonusVariant" required
                >{
                  christmasCampaign.bonusVariants.map((bonus) => (
                    <option value={bonus.id}>{bonus.title}</option>
                  ))
                }</select
              ></label
            >
            <label class="wide"
              >Osobní vzkaz na poukaz<textarea
                name="message"
                rows="3"
                maxlength="300"
                placeholder="Volitelné"></textarea></label
            >
            <label>Doručovací ulice<input name="street" required /></label>
            <label>Město<input name="city" required /></label>
            <label>PSČ<input name="zip" required /></label>
          </div>
          <label class="check-row"
            ><input type="checkbox" name="terms" required /><span
              >Seznámil/a jsem se s <a href="/obchodni-podminky" target="_blank" rel="noreferrer"
                >Všeobecnými obchodními podmínkami</a
              > a souhlasím s nimi.</span
            ></label
          >
          <p class="privacy-note">
            Odesláním formuláře potvrzujete, že jste se seznámil/a s <a
              href="/ochrana-osobnich-udaju"
              target="_blank"
              rel="noreferrer">Informacemi o zpracování osobních údajů</a
            >. Vaše údaje zpracováváme za účelem vyřízení poptávky, rezervace kampaně a navazující
            komunikace.
          </p>
          <label class="check-row"
            ><input type="checkbox" name="marketing" /><span
              >{campaignConsent.marketing.wording}</span
            ></label
          >
          <button class="btn primary" type="submit">Odeslat rezervaci poukazu →</button>
          <p class="form-status" id="voucher-status" role="status"></p>
        </form>
      </div>
    </section>
  </main>
</Base>

<script>
  const voucherForm = document.querySelector<HTMLFormElement>('#voucher-form');
  const voucherStatus = document.querySelector<HTMLElement>('#voucher-status');
  const campaignName = 'vanoce';
  window.dispatchEvent(
    new CustomEvent('bubu:tracking', { detail: { name: 'campaign_view', campaign: campaignName } }),
  );
  document.querySelectorAll('a[href="#poukaz-form"], a[href="#bonusy"]').forEach((element) => {
    element.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('bubu:tracking', {
          detail: { name: 'campaign_cta_click', campaign: campaignName },
        }),
      );
    });
  });
  function collect(form: HTMLFormElement, name: string) {
    const control = form.elements.namedItem(name);
    return control instanceof HTMLInputElement ||
      control instanceof HTMLSelectElement ||
      control instanceof HTMLTextAreaElement
      ? control.value.trim()
      : '';
  }
  function checked(form: HTMLFormElement, name: string) {
    const control = form.elements.namedItem(name);
    return control instanceof HTMLInputElement ? control.checked : false;
  }
  voucherForm?.addEventListener('input', () => {
    if (!voucherForm || voucherForm.dataset.started) return;
    voucherForm.dataset.started = 'true';
    window.dispatchEvent(
      new CustomEvent('bubu:tracking', {
        detail: { name: 'campaign_form_start', campaign: campaignName },
      }),
    );
  });
  voucherForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!voucherForm || !voucherStatus) return;
    const form = voucherForm;
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!submit) return;
    submit.disabled = true;
    voucherStatus.textContent = 'Odesíláme rezervaci…';
    const body = {
      campaignId: 'vanoce',
      contact: {
        firstName: collect(form, 'firstName'),
        lastName: collect(form, 'lastName'),
        email: collect(form, 'email'),
        phone: collect(form, 'phone'),
      },
      selection: {
        course: collect(form, 'course') || undefined,
        branch: collect(form, 'branch') || undefined,
        bonusVariant: collect(form, 'bonusVariant'),
      },
      payload: {
        recipientFirstName: collect(form, 'recipientFirstName'),
        recipientLastName: collect(form, 'recipientLastName'),
        message: collect(form, 'message'),
        delivery: {
          street: collect(form, 'street'),
          city: collect(form, 'city'),
          zip: collect(form, 'zip'),
        },
      },
      termsAccepted: checked(form, 'terms'),
      marketingAccepted: checked(form, 'marketing'),
    };
    try {
      const response = await fetch('/api/campaign-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const result = await response.json();
      if (!response.ok || !result.ok)
        throw new Error(result.message || 'Formulář se nepodařilo odeslat.');
      window.dispatchEvent(
        new CustomEvent('bubu:tracking', {
          detail: {
            name: 'campaign_form_submit',
            campaign: campaignName,
            course: body.selection.course,
            branch: body.selection.branch,
          },
        }),
      );
      form.reset();
      voucherStatus.textContent = 'Děkujeme. Rezervaci poukazu máme a ozveme se s potvrzením.';
    } catch (error) {
      voucherStatus.textContent =
        error instanceof Error ? error.message : 'Formulář se nepodařilo odeslat.';
    } finally {
      submit.disabled = false;
    }
  });
</script>

<style>
  :global(.christmas-page) {
    --xblue: #078bc2;
    --xblue-dark: #086994;
    --xice: #eff9ff;
    --xgold: #e5b34a;
    --xnavy: #101b35;
    background: #fff;
    color: var(--xnavy);
    overflow: hidden;
  }
  :global(.christmas-page .btn.primary) {
    background: linear-gradient(135deg, #0797c9, #03a9d6);
    color: #fff;
    border: 0;
    box-shadow: 0 14px 30px #0690c02a;
  }
  :global(.christmas-page .btn.primary:hover) {
    background: linear-gradient(135deg, #067cad, #0499c4);
  }
  .xmas-hero {
    position: relative;
    padding: 72px 0 34px;
    background:
      radial-gradient(circle at 83% 8%, #dff2ff 0, transparent 28rem),
      linear-gradient(90deg, #fff 0%, #fff 42%, #eff8ff 100%);
  }
  .xmas-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
    gap: 42px;
    align-items: center;
  }
  .xmas-kicker {
    display: block;
    color: #087eaa;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.82rem;
    margin-bottom: 14px;
  }
  .xmas-copy h1 {
    font-size: clamp(3rem, 6vw, 5.9rem);
    color: #080c16;
    max-width: 760px;
  }
  .xmas-copy h1 span {
    display: block;
    color: #0688b8;
  }
  .xmas-lead {
    max-width: 690px;
    color: #0d1627;
    font-size: clamp(1.08rem, 1.6vw, 1.42rem);
    line-height: 1.55;
  }
  .deposit-box {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 15px;
    max-width: 720px;
    margin-top: 24px;
    padding: 16px 20px;
    border-radius: 18px;
    background: #dff4ff;
    color: #10213c;
    box-shadow: 0 14px 34px #087eaa17;
  }
  .coin-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #fff;
    color: #078bc2;
    font-weight: 900;
  }
  .deposit-box strong,
  .deposit-box small {
    display: block;
  }
  .deposit-box small {
    color: #4d6378;
    margin-top: 3px;
  }
  .xmas-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 26px;
    align-items: center;
  }
  .gift-btn {
    min-height: 64px;
    border-radius: 14px;
    padding-inline: 34px;
    font-size: 1.02rem;
  }
  .bonus-pill {
    min-height: 64px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: 14px;
    padding: 12px 20px;
    background: #e8f7ff;
    color: #0b6993;
    text-decoration: none;
    font-weight: 800;
  }
  .bonus-pill span {
    font-size: 1.45rem;
  }
  .bonus-pill strong {
    color: #0b1427;
  }
  .mini-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 24px;
    color: #52647b;
    font-size: 0.9rem;
  }
  .mini-proof span::before {
    content: '✓';
    color: #078bc2;
    font-weight: 900;
    margin-right: 8px;
  }
  .hero-visual {
    position: relative;
    min-height: 540px;
    border-radius: 0 0 0 56px;
    overflow: hidden;
  }
  .winter-window {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 78% 18%, #fff 0 0.2rem, transparent 0.25rem),
      radial-gradient(circle at 55% 16%, #fff 0 0.18rem, transparent 0.24rem),
      linear-gradient(135deg, #f5fbff 0%, #dfeff8 52%, #ffffff 100%);
  }
  .winter-window::after {
    content: '';
    position: absolute;
    right: 30px;
    top: 58px;
    width: 120px;
    height: 120px;
    border-radius: 24px;
    background: linear-gradient(#8a5c2b, #b78947);
    opacity: 0.22;
    box-shadow: 0 0 0 18px #fff8;
  }
  .voucher-scene {
    position: absolute;
    inset: 42px 26px 18px;
  }
  .envelope {
    position: absolute;
    right: 110px;
    top: 74px;
    width: 430px;
    height: 280px;
    border-radius: 16px;
    background: linear-gradient(135deg, #083b78, #115ca0);
    transform: rotate(-5deg);
    box-shadow: 0 24px 50px #0c2b4f30;
  }
  .envelope::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, transparent 48%, #ffffff22 49% 51%, transparent 52%);
  }
  .voucher-paper {
    position: absolute;
    right: 62px;
    top: 105px;
    width: min(490px, 72vw);
    min-height: 285px;
    padding: 36px 42px;
    border-radius: 10px;
    background: #fff;
    transform: rotate(4deg);
    box-shadow: 0 24px 55px #10213c38;
    text-align: center;
  }
  .voucher-paper::before {
    content: '';
    position: absolute;
    left: -24px;
    top: 18px;
    width: 85px;
    height: 190px;
    border-radius: 999px;
    background: linear-gradient(#047ebb, #08a6d2);
    transform: rotate(44deg);
    box-shadow: 0 0 0 15px #ffffffbb;
  }
  .voucher-paper img {
    width: 118px;
    margin: 0 auto 20px;
  }
  .voucher-paper span {
    display: block;
    color: #1264a3;
    font-size: 1.58rem;
    font-weight: 950;
    letter-spacing: 0.06em;
  }
  .voucher-paper strong {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.72rem;
    color: #1d2f49;
    margin-top: 2px;
  }
  .voucher-paper p {
    margin-top: 25px;
    font-family: cursive;
    color: #2d405d;
    font-size: 1.28rem;
  }
  .voucher-paper small {
    font-size: 2rem;
    color: #233a5d;
  }
  .car-key {
    position: absolute;
    right: 22px;
    top: 235px;
    width: 92px;
    height: 170px;
    border-radius: 26px;
    background: linear-gradient(145deg, #151d2a, #3c4657);
    color: #fff;
    display: grid;
    place-items: center;
    padding: 16px 0;
    box-shadow: 0 20px 35px #0004;
    transform: rotate(-10deg);
  }
  .bubak-gift {
    position: absolute;
    left: 88px;
    bottom: 55px;
    width: 176px;
