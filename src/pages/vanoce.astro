    color: #eaf7ff;
  }
  .xmas-nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgba(255, 255, 255, 0.92);
    border-bottom: 1px solid #deedf5;
    backdrop-filter: blur(16px);
    box-shadow: 0 10px 26px #12365a0b;
  }
  .nav-inner {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .xmas-logo {
    display: inline-flex;
    align-items: center;
    width: 168px;
    text-decoration: none;
