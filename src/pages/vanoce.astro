---
export const prerender = true;
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import voucherImage from '../assets/christmas-voucher.png';
import { christmasCampaign, campaignCourseOptions } from '../lib/campaigns/config';
import { branches, money } from '../lib/catalog';
import { campaignConsent } from '../lib/campaigns/requests';

const courses = campaignCourseOptions();
const pickupBranches = branches.filter(({ id }) =>
  christmasCampaign.pickupBranches.some((branch) => branch === id),
);
const deposit = money(christmasCampaign.depositCzk);
const { bonus } = christmasCampaign;
---

<Base
  title="Vánoční poukaz Autoškola BuBu – darujte řidičák bez stresu"
  description="Vánoční poukaz Autoškoly BuBu. Vyzvednutí na Střížkově nebo v Kladně, záloha 5 000 Kč na místě a dvě výcvikové hodiny před zkouškou zdarma."
  hideHeader
  hideFooter
>
  <div class="christmas-page" data-campaign="vanoce">
    <div class="xmas-topbar">
      <div class="container topbar-inner">
        <span><span aria-hidden="true">🎁</span> VÁNOČNÍ NABÍDKA</span>
        <strong>Řidičák bez stresu i pod stromeček</strong>
        <span><span aria-hidden="true">⏳</span> Platí jen omezenou dobu</span>
      </div>
    </div>
    <nav class="xmas-nav" aria-label="Vánoční landing navigace">
      <div class="container nav-inner">
        <a class="xmas-logo" href="/">
          <img src="/brand/logo.webp" alt="Autoškola BuBu" />
        </a>
        <div class="nav-links">
          <a href="#bonusy">Bonus</a>
          <a href="#jak-to-funguje">Jak to funguje</a>
          <a href="#poukaz-form">Objednat</a>
        </div>
        <a class="btn primary nav-cta" href="#poukaz-form">Darovat řidičák</a>
      </div>
    </nav>
    <section class="xmas-hero">
      <div class="snow snow-a" aria-hidden="true">❄</div><div
        class="snow snow-b"
        aria-hidden="true"
      >
        ❄
      </div><div class="snow snow-c" aria-hidden="true">✦</div>
      <div class="container xmas-hero-grid">
        <div class="xmas-copy">
          <span class="xmas-kicker">Vánoce v BUBU</span>
          <h1>Darujte letos <span>řidičák bez stresu.</span></h1>
          <p class="xmas-lead">
            Vánoční poukaz na kurz Autoškoly BuBu si vyzvednete během otevírací doby na Střížkově
            nebo v Kladně.
          </p>
          <div class="deposit-box">
            <span class="coin-icon" aria-hidden="true">💰</span>
            <div>
              <strong>{deposit} nevratná záloha na kurz</strong>
              <small>Zaplatíte osobně při vyzvednutí poukazu.</small>
            </div>
          </div>
          <div class="xmas-actions">
            <a class="btn primary gift-btn" href="#poukaz-form">Chci darovat řidičák →</a>
            <a class="bonus-pill" href="#bonusy"><span aria-hidden="true">⭐</span> {bonus.title}</a
            >
          </div>
        </div>
        <div class="hero-visual">
          <Image
            src={voucherImage}
            alt="Vánoční dárkový poukaz Autoškoly BuBu s červenou stuhou"
            widths={[400, 640, 900]}
            sizes="(max-width: 1080px) 90vw, 48vw"
            format="webp"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="hero-strip" aria-label="Výhody vánočního poukazu">
      <div class="container hero-strip-grid">
        <article>
          <span aria-hidden="true">🎁</span><strong>Fyzický poukaz</strong><small
            >osobní převzetí</small
          >
        </article>
        <article>
          <span aria-hidden="true">📍</span><strong>Vyzvednutí</strong><small
            >Střížkov nebo Kladno v otevírací době</small
          >
        </article>
        <article>
          <span aria-hidden="true">🚗</span><strong>Skupina B</strong><small
            >manuál, automat i L17</small
          >
        </article>
        <article>
          <span aria-hidden="true">💰</span><strong>Platba na místě</strong><small
            >nevratná záloha {deposit}</small
          >
        </article>
      </div>
    </section>

    <section class="xmas-section soft-blue">
      <div class="container">
        <h2 class="center-title">Proč je to dobrý dárek</h2>
        <div class="reason-grid">
          <article>
            <span aria-hidden="true">🎁</span><h3>Praktický dárek s dlouhodobou hodnotou</h3><p>
              Nejen radost, ale i investice do budoucnosti.
            </p>
          </article>
          <article>
            <span aria-hidden="true">📅</span><h3>Nemusíte znát přesný termín zahájení</h3><p>
              Obdarovaný si vybere, kdy začne.
            </p>
          </article>
          <article>
            <span aria-hidden="true">📝</span><h3>Jednoduché objednání</h3><p>
              Poukaz si rezervujete online a zaplatíte při převzetí.
            </p>
          </article>
          <article>
            <span aria-hidden="true">⭐</span><h3>Bonus navíc před zkouškou</h3><p>
              Ještě větší jistota na závěrečné zkoušce.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="xmas-section soft-blue" id="bonusy">
      <div class="container narrow bonus-summary">
        <span class="xmas-kicker">Bonus ke každému poukazu</span>
        <h2 class="center-title">{bonus.title}</h2>
        <p>
          Obdarovaný získá automaticky {bonus.lessons} × {bonus.minutesPerLesson} minut jízdy navíc na
          doladění před závěrečnou zkouškou.
        </p>
      </div>
    </section>

    <section class="xmas-section" id="jak-to-funguje">
      <div class="container">
        <h2 class="center-title">Jak to funguje</h2>
        <div class="how-grid">
          <article>
            <span aria-hidden="true">📍</span><h3>1. Vyberete kurz a pobočku</h3><p>
              Zvolte kurz a místo, kde poukaz vyzvednete.
            </p>
          </article>
          <article>
            <span aria-hidden="true">📝</span><h3>2. Vyplníte údaje k poukazu</h3><p>
              Zadáte kontakt a případné věnování.
            </p>
          </article>
          <article>
            <span aria-hidden="true">📤</span><h3>3. Odešlete rezervaci</h3><p>
              Zobrazíme číslo poukazu a ozveme se kvůli převzetí. Poukaz vyzvednete v otevírací době
              a zálohu zaplatíte na místě.
            </p>
          </article>
          <article>
            <span aria-hidden="true">🚗</span><h3>4. Obdarovaný dokončí přihlášení</h3><p>
              A vyrazí za svým řidičákem s naší podporou.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="xmas-section faq-lite">
      <div class="container narrow">
        <h2 class="center-title">Časté dotazy</h2>
        <div class="faq-grid">
          <details>
            <summary>Jak funguje záloha 5 000 Kč?</summary><p>
              Nevratnou zálohu zaplatíte při vyzvednutí. Celých 5 000 Kč se započítá do ceny kurzu.
              Zákonná práva spotřebitele zůstávají zachována.
            </p>
          </details>
          <details>
            <summary>Musím znát termín zahájení kurzu?</summary><p>
              Nemusíte. Obdarovaný si termín a další detaily domluví později.
            </p>
          </details>
          <details>
            <summary>Kde a kdy si vyzvednu poukaz?</summary>
            <p>
              Osobně během otevírací doby vybrané pobočky. Otevírací dobu a telefon najdete v <a
                href="/kontakt">kontaktech na pobočky</a
              >.
            </p>
          </details>
          <details>
            <summary>Jak funguje bonus před zkouškou?</summary>
            <p>Dvě výcvikové hodiny (2 × 45 minut) má obdarovaný automaticky zdarma.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="xmas-bottom-cta">
      <div class="container bottom-card">
        <img src="/brand/bubak.webp" alt="Autoškola BuBu" />
        <div>
          <h2>Připravte letos dárek, který má skutečnou hodnotu.</h2><p>
            Vánoční poukaz na kurz Autoškoly BUBU – více než jen řidičák.
          </p>
        </div>
        <a class="btn secondary cta-white" href="#poukaz-form">Objednat vánoční poukaz →</a>
      </div>
    </section>

    <section class="xmas-section voucher-form-section" id="poukaz-form">
      <div class="container form-wrap">
        <div class="form-copy">
          <span class="xmas-kicker">Rezervace poukazu</span>
          <h2>Objednat vánoční poukaz</h2>
          <p>
            Vyplňte údaje a vyberte pobočku. Po potvrzení rezervace si poukaz vyzvednete v její
            otevírací době.
          </p>
          <div class="price-chip">
            <strong>{deposit}</strong><span>Nevratná záloha při vyzvednutí poukazu</span>
          </div>
        </div>
        <form class="voucher-form" id="voucher-form" novalidate>
          <div class="form-grid">
            <label
              >Jméno kupujícího<input name="firstName" autocomplete="given-name" required /></label
            >
            <label
              >Příjmení kupujícího<input
                name="lastName"
                autocomplete="family-name"
                required
              /></label
            >
            <label>E-mail<input name="email" type="email" autocomplete="email" required /></label>
            <label>Telefon<input name="phone" autocomplete="tel" required /></label>
            <label
              >Jméno obdarovaného<input name="recipientFirstName" maxlength="80" required /></label
            >
            <label>Příjmení obdarovaného<input name="recipientLastName" maxlength="80" /></label>
            <label
              >Kurz<select name="course"
                ><option value="">Domluvíme později</option>{
                  courses.map((course) => (
                    <option value={course.id}>
                      {course.label} – {course.name}
                    </option>
                  ))
                }</select
              ></label
            >
            <label
              >Pobočka pro vyzvednutí<select name="branch" required>
                <option value="">Vyberte pobočku</option>
                {pickupBranches.map((branch) => <option value={branch.id}>{branch.name}</option>)}
              </select></label
            >
            <label class="wide"
              >Osobní vzkaz na poukaz<textarea
                name="message"
                rows="3"
                maxlength="300"
                placeholder="Volitelné"></textarea></label
            >
          </div>
          <label class="check-row"
            ><input type="checkbox" name="terms" required /><span
              >Seznámil/a jsem se s <a href="/obchodni-podminky" target="_blank" rel="noreferrer"
                >Všeobecnými obchodními podmínkami</a
              > a souhlasím s nimi.</span
            ></label
          >
          <p class="privacy-note">
            Odesláním formuláře potvrzujete, že jste se seznámil/a s <a
              href="/ochrana-osobnich-udaju"
              target="_blank"
              rel="noreferrer">Informacemi o zpracování osobních údajů</a
            >. Vaše údaje zpracováváme za účelem vyřízení poptávky, rezervace kampaně a navazující
            komunikace.
          </p>
          <label class="check-row"
            ><input type="checkbox" name="marketing" /><span
              >{campaignConsent.marketing.wording}</span
            ></label
          >
          <button class="btn primary" type="submit">Odeslat rezervaci poukazu →</button>
          <p class="form-status" id="voucher-status" role="status"></p>
        </form>
      </div>
    </section>
    <footer class="xmas-footer">
      <div class="container footer-inner">
        <a class="xmas-logo" href="/"><img src="/brand/logo.webp" alt="Autoškola BuBu" /></a>
        <div class="footer-links">
          <a href="/kurzy">Kurzy</a><a href="/#pobocky">Pobočky</a><a href="/o-nas">O nás</a><a
            href="/kontakt">Kontakt</a
          >
        </div>
        <p>VÍCE NEŽ JEN ŘIDIČÁK. <span>♡</span></p>
      </div>
    </footer>
  </div>
</Base>

<script>
  import { getRecaptchaToken } from '../scripts/recaptcha';

  const voucherForm = document.querySelector<HTMLFormElement>('#voucher-form');
  const voucherStatus = document.querySelector<HTMLElement>('#voucher-status');
  const campaignName = 'vanoce';
  window.dispatchEvent(
    new CustomEvent('bubu:tracking', { detail: { name: 'campaign_view', campaign: campaignName } }),
  );
  document.querySelectorAll('a[href="#poukaz-form"], a[href="#bonusy"]').forEach((element) => {
    element.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('bubu:tracking', {
          detail: { name: 'campaign_cta_click', campaign: campaignName },
        }),
      );
    });
  });
  function collect(form: HTMLFormElement, name: string) {
    const control = form.elements.namedItem(name);
    return control instanceof HTMLInputElement ||
      control instanceof HTMLSelectElement ||
      control instanceof HTMLTextAreaElement
      ? control.value.trim()
      : '';
  }
  function checked(form: HTMLFormElement, name: string) {
    const control = form.elements.namedItem(name);
    return control instanceof HTMLInputElement ? control.checked : false;
  }
  voucherForm?.addEventListener('input', () => {
    if (!voucherForm || voucherForm.dataset.started) return;
    voucherForm.dataset.started = 'true';
    window.dispatchEvent(
      new CustomEvent('bubu:tracking', {
        detail: { name: 'campaign_form_start', campaign: campaignName },
      }),
    );
  });
  voucherForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!voucherForm || !voucherStatus) return;
    const form = voucherForm;
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!submit) return;
    submit.disabled = true;
    voucherStatus.textContent = 'Odesíláme rezervaci…';
    try {
      const recaptchaToken = await getRecaptchaToken('campaign_request');
      const body = {
        campaignId: 'vanoce',
        contact: {
          firstName: collect(form, 'firstName'),
          lastName: collect(form, 'lastName'),
          email: collect(form, 'email'),
          phone: collect(form, 'phone'),
        },
        selection: {
          course: collect(form, 'course') || undefined,
          branch: collect(form, 'branch') || undefined,
        },
        payload: {
          recipientFirstName: collect(form, 'recipientFirstName'),
          recipientLastName: collect(form, 'recipientLastName'),
          message: collect(form, 'message'),
        },
        termsAccepted: checked(form, 'terms'),
        marketingAccepted: checked(form, 'marketing'),
        recaptchaToken,
      };
      const response = await fetch('/api/campaign-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const result = await response.json();
      if (!response.ok || !result.ok)
        throw new Error(
          result.code === 'CAPTCHA_FAILED'
            ? 'Odeslání se nepodařilo. Zkuste to prosím znovu.'
            : result.message || 'Formulář se nepodařilo odeslat.',
        );
      window.dispatchEvent(
        new CustomEvent('bubu:tracking', {
          detail: {
            name: 'campaign_form_submit',
            campaign: campaignName,
            course: body.selection.course,
            branch: body.selection.branch,
          },
        }),
      );
      form.reset();
      voucherStatus.textContent = `Děkujeme. Číslo vašeho poukazu je ${result.voucherNumber}. Ozveme se vám s potvrzením a domluvíme převzetí.`;
    } catch (error) {
      voucherStatus.textContent =
        error instanceof Error ? error.message : 'Formulář se nepodařilo odeslat.';
    } finally {
      submit.disabled = false;
    }
  });
</script>

<style>
  :global(.christmas-page) {
    --xblue: #078bc2;
    --xblue-dark: #086994;
    --xice: #eff9ff;
    --xgold: #e5b34a;
    --xnavy: #101b35;
    background: #fff;
    color: var(--xnavy);
    overflow: hidden;
  }
  :global(.christmas-page .btn.primary) {
    background: linear-gradient(135deg, #0797c9, #03a9d6);
    color: #fff;
    border: 0;
    box-shadow: 0 14px 30px #0690c02a;
