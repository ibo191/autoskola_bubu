---
export const prerender = true;
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CourseFaq from '../../components/CourseFaq.astro';
import GoogleReviewsBanner from '../../components/GoogleReviewsBanner.astro';
import car from '../../assets/courses/b-manual-fabia.png';
import { branches, getCourse } from '../../lib/catalog';
---

<Base
  title="Kondiční jízdy Praha 8, Kladno a Statenice – manuál i automat"
  description="Získejte zpět jistotu za volantem s Autoškolou BuBu. Kondiční jízdy za 800 Kč / 45 minut, vždy v 90minutových blocích. Manuál i automat na Střížkově."
>
  <section class="page-hero">
    <div class="container hero-grid">
      <div>
        <nav class="breadcrumbs" aria-label="Drobečková navigace">
          <a href="/">Domů</a><span>/</span><a href="/kurzy">Kurzy</a><span>/</span><span
            >Kondiční jízdy</span
          >
        </nav>
        <span class="eyebrow">Kondiční jízdy pro držitele skupiny B</span>
        <h1>Zpátky za volant.<br />S klidem a jistotou.</h1>
        <p class="lead">
          Dlouho jste neřídili nebo si chcete procvičit parkování, křižovatky či jízdu v provozu?
          Tempo a náplň přizpůsobíme Vašim zkušenostem.
        </p>
        <div class="actions">
          <button class="btn primary" data-order data-course="kondicni" disabled
            >Objednat kondiční jízdy ↗</button
          ><a class="btn secondary" href="#cena">Cena a pobočky</a>
        </div>
      </div>
      <Image
        src={car}
        alt="Škoda Fabia Autoškoly BuBu pro kondiční jízdy"
        width={720}
        height={540}
        loading="eager"
      />
    </div>
  </section>
  <section class="section" id="cena">
    <div class="container">
      <div class="price-panel">
        <div>
          <span class="eyebrow">Víc jistoty. Vaše tempo.</span>
          <h2>Věnujte 90 minut tomu,<br />co Vám za volantem chybí.</h2>
          <p class="lead">
            Žádný nový řidičák. Prostor pro Vás, instruktora a situace, které si chcete osvojit.
            Začněte jednou jízdou a vyberte si rozsah, který Vám sedne.
          </p>
          <ul class="price-benefits">
            <li>Parkování, křižovatky i běžný provoz</li><li>
              Klidný přístup a náplň podle Vašich potřeb
            </li><li>Manuál nebo automat podle pobočky</li>
          </ul>
        </div>
        <div class="price-highlight">
          <span class="eyebrow">Váš první krok zpátky za volant</span>
          <strong class="price-main">1 600 Kč</strong>
          <p class="price-duration">90 minut s instruktorem</p>
          <p>
            800 Kč za vyučovací hodinu (45 minut). Každá jízda má dvě vyučovací hodiny — dost času
            vyzkoušet si věci v klidu.
          </p>
          <button class="btn primary" data-order data-course="kondicni" disabled
            >Vybrat rozsah jízd ↗</button
          >
          <a class="text-link" href="/cenik">Spočítat cenu v ceníku →</a>
        </div>
      </div>
      <div class="branch-heading">
        <span class="eyebrow">Blízko Vás</span><h2>Kde se vrátíte za volant?</h2><p>
          Stejná cena na všech pobočkách. Vyberte si tu svou.
        </p>
      </div>
      <div class="branch-grid">
        {
          branches.map((branch) => (
            <article class="branch-card">
              <>
                <h3>{branch.name}</h3>
                <p>{branch.id === 'strizkov' ? 'Manuál i automat' : 'Pouze manuál'}</p>
                <p class="branch-price">
                  <strong>1 600 Kč</strong> / 90 minut
                </p>
                <button
                  class="btn primary"
                  data-order
                  data-course="kondicni"
                  data-branch={branch.id}
                  disabled
                >
                  Vybrat {branch.name} ↗
                </button>
              </>
            </article>
          ))
        }
      </div>
      <p>
        Potřebujete platný řidičský průkaz skupiny B. Zápis a termíny jízd jsou dvě různé věci: při
        zápisu spolu domluvíme samotné jízdy i platbu.
      </p>
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <div class="booking-cta">
        <div>
          <span class="eyebrow">Další jízda může být začátek</span><h2>
            Řidičák máte.<br />Teď si vraťte jistotu.
          </h2><p>
            Vyberte pobočku, převodovku a počet jízd. Termíny samotných jízd domluvíme společně.
          </p>
        </div>
        <div class="booking-actions">
          <button class="btn primary" data-order data-course="kondicni" disabled
            >Chci znovu řídit s jistotou ↗</button
          ><a href="tel:+420725717755">Raději se nejdřív zeptám: 725 717 755</a>
        </div>
      </div>
    </div>
  </section>
  <GoogleReviewsBanner />
  <CourseFaq course={getCourse('kondicni')} />
</Base>
<style>
  .price-panel {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .price-benefits {
    padding-left: 22px;
    line-height: 1.9;
    margin-top: 24px;
  }
  .price-highlight {
    background: var(--brand-soft);
    border: 1px solid #c8e5dc;
    padding: 36px;
    border-radius: var(--radius-lg);
  }
  .price-main {
    display: block;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--ink);
    margin-top: 20px;
    line-height: 1.2;
  }
  .price-duration {
    font-size: 1.25rem;
    color: var(--ink);
    font-weight: 600;
    margin-bottom: 18px;
  }
  .price-highlight .btn {
    margin-top: 24px;
  }
  .price-highlight .text-link {
    display: block;
    margin-top: 16px;
  }
  .branch-heading {
    margin-top: 64px;
  }
  .branch-price strong {
    font-size: 1.8rem;
    color: var(--ink);
  }
  .booking-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    background: linear-gradient(120deg, #173b71, #102b54);
    color: #fff;
    padding: 44px;
    border-radius: var(--radius-lg);
  }
  .booking-cta h2 {
    color: #fff;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }
  .booking-cta p {
    color: #d7e4f5;
    max-width: 580px;
    margin-top: 18px;
  }
  .booking-cta .eyebrow {
    color: #a1e5db;
  }
  .booking-actions {
    flex-shrink: 0;
    max-width: 320px;
  }
  .booking-actions a {
    display: block;
    color: #fff;
    margin-top: 20px;
    font-size: 0.9rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero-grid img {
    width: 100%;
    height: auto;
    border-radius: 24px;
  }
  .branch-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 32px 0;
  }
  .branch-card {
    padding: 28px;
    border: 1px solid var(--line, #dcebea);
    border-radius: 18px;
    background: white;
  }
  @media (max-width: 800px) {
    .hero-grid,
    .branch-grid,
    .price-panel {
      grid-template-columns: 1fr;
    }
    .booking-cta {
      display: block;
      padding: 28px;
    }
    .booking-actions {
      margin-top: 28px;
    }
  }
</style>
