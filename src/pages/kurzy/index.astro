---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import FinalCta from '../../components/FinalCta.astro';
import { branches, courses, availableAt, displayPrice, money } from '../../lib/catalog';

const categoryLabels = {
  auto: 'Auto',
  moto: 'Motorka',
  prives: 'Přívěs',
} as const;
---

<Base
  title="Kurzy autoškoly"
  description="Přehled kurzů Autoškoly BuBu. Vyberte si řidičák na auto, L17, automat, motorku nebo přívěs podle pobočky Praha 8 Střížkov, Kladno a Statenice."
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Drobečková navigace">
        <a href="/">Domů</a><span>/</span><span>Kurzy</span>
      </nav>
      <span class="eyebrow">Všechny kurzy na jednom místě</span><h1>
        Vyberte si kurz,<br />který vám sedne.
      </h1><p class="lead">
        Nejdřív si projděte možnosti. Ceník a objednávka vás potom navedou jen přes otázky, které
        jsou pro váš kurz důležité.
      </p><div class="actions">
        <a class="btn primary" href="/cenik">Otevřít ceník ↗</a><a
          class="btn secondary"
          href="#prehled-kurzu">Prohlédnout kurzy</a
        >
      </div>
    </div>
  </section>
  <section class="section" id="prehled-kurzu">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Filtr podle pobočky</span><h2>Co můžete studovat kde?</h2><p>
            Motorky a přívěsy jsou dostupné jen na Střížkově. Kladno a Statenice nabízí kurzy
            skupiny B a L17 s manuální převodovkou.
          </p>
        </div>
      </div>
      <div
        class="tabs branch-tabs course-filter"
        role="group"
        aria-label="Filtrovat kurzy podle pobočky"
      >
        <button type="button" data-course-branch="all" aria-pressed="true">Všechny kurzy</button>
        {
          branches.map((branch) => (
            <button type="button" data-course-branch={branch.id} aria-pressed="false">
              {branch.name}
            </button>
          ))
        }
      </div>
      <div class="course-tile-grid" id="course-tile-grid">
        {
          courses.map((course) => {
            const availableBranches = branches.filter((branch) => availableAt(course, branch.id));
            const price = Math.min(
              ...availableBranches.map((branch) => displayPrice(course, branch.id)),
            );
            return (
              <article
                class="course-tile"
                data-branches={availableBranches.map((branch) => branch.id).join(' ')}
              >
                <span class="eyebrow">{categoryLabels[course.category]}</span>
                <h3>
                  <a href={`/kurzy/${course.slug}`}>{course.label}</a>
                </h3>
                <p class="tile-name">{course.name}</p>
                <p>{course.description}</p>
                <div class="tile-meta">
                  <span>
                    {course.category === 'moto' ? 'od ' : ''}
                    {money(price)}*
                  </span>
                  <small>{availableBranches.map((branch) => branch.name).join(' · ')}</small>
                </div>
                <div class="tile-actions">
                  <a class="text-link" href={`/kurzy/${course.slug}`}>
                    Detail kurzu →
                  </a>
                  <button class="btn secondary" data-order disabled data-course={course.id}>
                    Přihlásit se
                  </button>
                </div>
              </article>
            );
          })
        }
      </div>
      <p class="small fee-note">
        * Cena kurzu nezahrnuje poplatky za zkoušku. Přesnou cenu podle pobočky a varianty najdete v
        ceníku.
      </p>
    </div>
  </section>
  <section class="section tinted">
    <div class="container split">
      <div>
        <span class="eyebrow">Nevíte, kde začít?</span><h2>Vyberte kurz bez tlaku.</h2>
      </div><div>
        <p class="lead">
          Pokud přesně nevíte, jestli zvolit klasické B, automat, L17 nebo moto rozšíření, ceník vás
          provede rozhodnutím krok po kroku. Když narazíte na kombinaci, která potřebuje lidské
          ověření, raději vás pošleme na pobočku.
        </p>
        <div class="actions">
          <a class="btn primary" href="/cenik">Najít správnou variantu ↗</a><a
            class="btn secondary"
            href="/kontakt">Zeptat se</a
          >
        </div>
      </div>
    </div>
  </section>
  <FinalCta />
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-course-branch]');
    const tiles = document.querySelectorAll<HTMLElement>('.course-tile');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const branch = button.dataset.courseBranch ?? 'all';
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        tiles.forEach((tile) => {
          tile.hidden =
            branch !== 'all' && !(tile.dataset.branches ?? '').split(' ').includes(branch);
        });
      });
    });
  </script>
</Base>
<style>
  .course-filter {
    margin-bottom: 28px;
  }
  .course-tile-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
  }
  .course-tile {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    background: #fff;
    display: grid;
    gap: 14px;
    min-height: 100%;
    transition:
      transform var(--ease),
      border-color var(--ease),
      box-shadow var(--ease);
  }
  .course-tile:hover {
    transform: translateY(-4px);
    border-color: #a8d8d1;
    box-shadow: var(--shadow);
  }
  .course-tile h3 {
    font-size: 2rem;
  }
  .course-tile h3 a {
    text-decoration: none;
  }
  .tile-name {
    color: var(--ink);
    font-weight: 750;
  }
  .tile-meta {
    border-top: 1px solid var(--line);
    padding-top: 16px;
    margin-top: auto;
    display: grid;
    gap: 4px;
  }
  .tile-meta span {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .tile-meta small {
    color: var(--muted);
  }
  .tile-actions {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .tile-actions .btn {
    min-height: 42px;
    padding: 9px 14px;
  }
  .fee-note {
    margin-top: 20px;
  }
  @media (max-width: 940px) {
    .course-tile-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .course-tile-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
