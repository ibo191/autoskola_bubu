---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CourseFaq from '../../components/CourseFaq.astro';
import GoogleReviewsBanner from '../../components/GoogleReviewsBanner.astro';
import { courseFaqs } from '../../lib/course-faq';
import {
  courses,
  branches,
  availableAt,
  displayPrice,
  money,
  type Course,
  motoEnrollmentPaused,
  motoEnrollmentPausedMessage,
} from '../../lib/catalog';
import manualCar from '../../assets/courses/b-manual-fabia.png';
import automaticCar from '../../assets/courses/b-automatic-scala.png';
import studentLicense from '../../assets/courses/student-license.jpg';
import moto from '../../assets/moto.jpeg';
import trailer from '../../assets/trailer.jpeg';

export const prerender = true;
export function getStaticPaths() {
  return courses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}
interface Props {
  course: Course;
}
const { course } = Astro.props;
const isMoto = course.category === 'moto';
const photo =
  course.id === 'b-automat'
    ? automaticCar
    : course.category === 'auto'
      ? manualCar
      : course.category === 'moto'
        ? moto
        : trailer;
const availableBranches = branches.filter((branch) => availableAt(course, branch.id));
const minPrice = Math.min(...availableBranches.map((branch) => displayPrice(course, branch.id)));
const category =
  course.category === 'auto'
    ? 'ŘIDIČÁK NA AUTO'
    : course.category === 'moto'
      ? 'ŘIDIČÁK NA MOTORKU'
      : 'ŘIDIČÁK S PŘÍVĚSEM';
const details = {
  b: [
    'Řidičák skupiny B bez chaosu.',
    'Kurz pro začátečníky, kteří chtějí jasný plán, klidný přístup a přípravu na reálný provoz.',
    'Sedí vám, pokud chcete začít od nuly a postupně se dostat od prvních rozjezdů k samostatné jízdě.',
  ],
  'b-automat': [
    'Řidičák na automat bez zbytečného stresu.',
    'Soustreďte se na provoz, přednosti a bezpečnou jízdu. Řazení nechte na autě.',
    'Sedí vám, pokud víte, že budete jezdit automatem, nebo chcete klidnější start za volantem.',
  ],
  l17: [
    'Řidičák L17 pro bezpečný začátek.',
    'Skupina B už od 17 let: více času na zkušenosti, ale s oporou mentora.',
    'Sedí studentům, kteří chtějí řídit dřív a mají mentora, se kterým budou po získání řidičáku jezdit.',
  ],
  am: [
    'Skupina AM: první kilometry na motorce.',
    'Bezpečný začátek na dvou kolech s důrazem na ovládání a jistotu v provozu.',
    'Sedí vám, pokud chcete začít bezpečně a potřebujete si osvojit ovládání motorky od základů.',
  ],
  a1: [
    'Skupina A1 pro lehkou motorku.',
    'Motocyklový kurz s důrazem na ovládání stroje, cvičiště a jistotu v provozu.',
    'Pokud je A1 váš první řidičák, nabídneme Moto Jistotu prvořidičák s rozšířenou teoretickou přípravou.',
  ],
  a2: [
    'Skupina A2 jako další krok na motorce.',
    'Kurz nebo rozšíření podle toho, jaké oprávnění už držíte a jak dlouho.',
    'Pomůžeme vám zvolit správnou cestu mezi kurzem, rozšířením a doplňovací zkouškou.',
  ],
  a: [
    'Skupina A pro velkou motorku.',
    'Kurz pro velké motocykly s výběrem správného postupu podle předchozího oprávnění.',
    'Sedí zkušenějším jezdcům i žadatelům, kteří potřebují jasně ověřit správný postup.',
  ],
  b96: [
    'Rozšíření B96 pro větší soupravu.',
    'Praktické rozšíření pro situace, kdy vám běžná skupina B už nestačí.',
    'Sedí vám, pokud potřebujete tahat větší přívěs, ale nemusíte jít rovnou do skupiny B+E.',
  ],
  be: [
    'Skupina B+E pro auto s přívěsem.',
    'Příprava na řízení soupravy s přívěsem: prakticky, klidně a s jasným plánem.',
    'Sedí vám, pokud potřebujete jezdit s těžším přívěsem, vozíkem, karavanem nebo pracovní soupravou.',
  ],
}[course.id];
const [headline, lead, fit] = details;
const seo = {
  b: {
    title: 'Řidičák skupiny B – cena a průběh kurzu',
    description:
      'Řidičák skupiny B s jasným plánem výuky, klidným přístupem a přípravou na běžný provoz v Praze, Kladně i okolí Statenic.',
  },
  'b-automat': {
    title: 'Řidičák na automat – skupina B',
    description:
      'Kurz skupiny B na automat na Střížkově. Soustřeďte se na provoz, přednosti a bezpečnou jízdu bez řazení.',
  },
  l17: {
    title: 'L17 – řidičák od 17 let',
    description:
      'Kurz L17 pro budoucí řidiče od 17 let. Získejte skupinu B a do osmnácti jezděte se zapsaným mentorem.',
  },
  am: {
    title: 'Řidičák skupiny AM',
    description:
      'Kurz skupiny AM pro první kilometry na motorce. Informace o výcviku na pobočce Praha 8 – Střížkov.',
  },
  a1: {
    title: 'Řidičák skupiny A1',
    description:
      'Kurz skupiny A1 s důrazem na bezpečné ovládání motorky, cvičiště a jistotu v provozu na Praze 8 – Střížkov.',
  },
  a2: {
    title: 'Řidičák skupiny A2',
    description:
      'Kurz nebo rozšíření řidičského oprávnění skupiny A2. Pomůžeme určit postup podle vašeho současného oprávnění.',
  },
  a: {
    title: 'Řidičák skupiny A',
    description:
      'Kurz nebo rozšíření řidičského oprávnění skupiny A pro velké motocykly na pobočce Praha 8 – Střížkov.',
  },
  b96: {
    title: 'Rozšíření B96 – kurz s přívěsem',
    description:
      'Rozšíření B96 pro větší jízdní soupravu. Praktický výcvik s jasným postupem na pobočce Praha 8 – Střížkov.',
  },
  be: {
    title: 'Řidičák skupiny B+E – auto s přívěsem',
    description:
      'Kurz skupiny B+E pro řízení soupravy s těžším přívěsem, vozíkem nebo karavanem na pobočce Praha 8 – Střížkov.',
  },
}[course.id];
const checklist =
  course.category === 'moto'
    ? [
        'Výcvik na pobočce Praha 8 – Střížkov.',
        'Balíček Moto Základ nebo Moto Jistota podle zkušeností.',
        'Cvičiště, ovládání motorky a příprava na zkoušku.',
        'Trpělivý přístup od prvních metrů.',
      ]
    : course.category === 'prives'
      ? [
          'Výcvik přívěsů na pobočce Praha 8 – Střížkov.',
          'Praktická příprava na manipulaci se soupravou.',
          'Pomůžeme ověřit, zda potřebujete B96 nebo B+E.',
          'Jasný postup od zápisu po zkoušku.',
        ]
      : [
          'Jasný plán od zápisu po zkoušku.',
          'Teorie propojená s reálným provozem.',
          'Řidičák skupiny B – manuál nebo automat a možnost absolvovat kurz v režimu L17.',
          'Vstřícný a trpělivý přístup.',
        ];
const valueCards = [
  [
    'graduation',
    'Jasný postup',
    course.id === 'b'
      ? 'Naše teoretická a praktická výuka má jasný směr. Osnovy jsme upravovali podle potřeb studentů a v provozu jdeme i nad zákonné minimum.'
      : 'Výuka a praktický výcvik na sebe navazují od základů až ke složitějším situacím.',
  ],
  [
    'idea',
    'Klidné vysvětlení',
    'Když něco nejde napoprvé, vrátíme se k tomu. Bez křiku a bez shazování.',
  ],
  [
    'hands-wheel',
    'Příprava na realitu',
    'Trénujeme situace, které potkáte u zkoušky i při běžném řízení po kurzu.',
  ],
];
const included = [
  [
    'settings',
    'Propracovaný plán výuky',
    'Výuka a praktický výcvik na sebe navazují podle propracované osnovy.',
  ],
  [
    'classroom-outline',
    'Učební materiály v ceně',
    'Od začátku máte jasné materiály, ke kterým se můžete vracet.',
  ],
  [
    'download',
    'Výukové materiály online',
    'Studijní obsah máte vždy po ruce ve svém tempu i mezi přednáškami.',
  ],
  [
    'phone',
    'Online učebnice kdekoliv',
    'Doma, cestou do školy i v MHD. Na mobilu, tabletu nebo počítači.',
  ],
];
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.name,
  description: lead,
  provider: {
    '@type': 'Organization',
    name: 'Autoškola BuBu',
    url: 'https://www.autoskolabubu.cz',
  },
  offers: {
    '@type': 'Offer',
    price: minPrice,
    priceCurrency: 'CZK',
    availability: 'https://schema.org/InStock',
  },
};
const courseUrl = `https://www.autoskolabubu.cz/kurzy/${course.slug}`;
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Domů', item: 'https://www.autoskolabubu.cz/' },
    { '@type': 'ListItem', position: 2, name: 'Kurzy', item: 'https://www.autoskolabubu.cz/kurzy' },
    { '@type': 'ListItem', position: 3, name: course.name, item: courseUrl },
  ],
};
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: courseFaqs(course).map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<Base
  title={seo.title}
  description={seo.description}
  schema={[courseSchema, breadcrumbSchema, faqSchema]}
>
  <main class="course-page">
    <section class="product-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">{category} · {course.label}</span>
          <h1>{headline}</h1><p class="lead">{lead}</p>
          <div class="actions">
            {
              isMoto && motoEnrollmentPaused ? (
                <span class="moto-pause" role="status">
                  {motoEnrollmentPausedMessage}
                </span>
              ) : (
                <button class="btn primary" data-order disabled data-course={course.id}>
                  Přihlásit se do kurzu ↗
                </button>
              )
            }<a class="btn secondary" href="#cena">Zobrazit cenu</a>
          </div>
          <div class="hero-signals">
            <span>♧ Už 10+ let pomáháme řidičům</span><span>♡ Individuální a klidný přístup</span
            ><span>◈ Příprava na reálný provoz</span>
          </div>
        </div>
        <div class="hero-image">
          <Image
            src={photo}
            alt={course.id === 'b-automat'
              ? 'Černá Škoda Scala Autoškoly BuBu pro výcvik na automat'
              : course.category === 'auto'
                ? 'Bílá Škoda Fabia Autoškoly BuBu pro manuální výcvik'
                : course.category === 'moto'
                  ? 'Výcvikový motocykl Autoškoly BuBu'
                  : 'Výcvik s přívěsem Autoškoly BuBu'}
            widths={[480, 800]}
            sizes="(max-width: 720px) 100vw, 46vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
          <span class="hand-note">Učíme v přátelské<br />atmosféře a v reálném<br />provozu.</span
          ><span class="fleet-badge"
            >▱ <b>Moderní vozový park</b><small>Pohodlně a bezpečně</small></span
          >
        </div>
      </div>
    </section>

    <section class="section fit-section">
      <div class="container fit-grid">
        <div>
          <span class="eyebrow">Je to pro vás?</span><h2>Kurz bez zbytečného tlaku.</h2><p
            class="fit-lead"
          >
            {fit}
          </p><div class="fit-photo">
            <Image
              src={studentLicense}
              alt="Žákyně Autoškoly BuBu s nově získaným řidičským průkazem"
              widths={[400, 650]}
              sizes="(max-width: 720px) 100vw, 30vw"
              format="webp"
              loading="lazy"
            /><span>Váš cíl je blíž,<br />než si myslíte.</span>
          </div>
        </div>
        <div class="checklist">
          {
            checklist.map((item) => (
              <div>
                <>
                  <b>✓</b>
                  <p>{item}</p>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <GoogleReviewsBanner
      heading="Co o výcviku říkají naši žáci."
      profileLabel="Autoškola BuBu Střížkov"
    />

    <section class="section value-section">
      <div class="container">
        <div class="section-head">
          <div><span class="eyebrow">Co získáte</span><h2>Výcvik, který má směr.</h2></div><p>
            Nejde jen o odchozený kurz. Cílem je, abyste rozuměli tomu, co na silnici děláte, a
            cítili se za volantem bezpečně.
          </p>
        </div>
        <div class="value-grid">
          {
            valueCards.map(([icon, title, text]) => (
              <article>
                <>
                  <img
                    src={`/icons/ui/blue-${icon}.webp`}
                    alt=""
                    width="192"
                    height="192"
                    loading="lazy"
                  />
                  <h3>{title}</h3>
                  <p>{text}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section included-section">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">V kurzu máte mnohem víc</span><h2>
              V kurzu máte mnohem víc než jen jízdy.
            </h2>
          </div><p>
            Od prvního dne máte k dispozici materiály a přípravu, které vám pomohou zvládnout
            autoškolu systematicky.
          </p>
        </div>
        <div class="included-grid">
          <div class="included-cards">
            {
              included.map(([icon, title, text]) => (
                <article>
                  <>
                    <img
                      src={`/icons/ui/mint-${icon}.webp`}
                      alt=""
                      width="192"
                      height="192"
                      loading="lazy"
                    />
                    <div>
                      <>
                        <h3>{title}</h3>
                        <p>{text}</p>
                      </>
                    </div>
                  </>
                </article>
              ))
            }
          </div><aside class="etesty">
            <span>VELKÁ VÝHODA</span><b>▤</b><h3>Oficiální testové otázky přímo ve vašem účtu</h3><p
            >
              Ve studentském systému máte integrované eTesty s oficiálními testovými otázkami
              Ministerstva dopravy.
            </p><strong>✓ 100 kreditů na testy v ceně</strong><small
              >1 kredit = 1 test. Další test stojí 1 Kč.</small
            >
          </aside>
        </div>
      </div>
    </section>

    <section class="section price-section" id="cena">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Cena a dostupnost</span><h2>
              Vyberte pobočku, která dává smysl.
            </h2>
          </div><a class="text-link" href="/cenik">Kompletní ceník ↗</a>
        </div>
        <div class="branch-grid">
          {
            availableBranches.map((branch, index) => (
              <article class:list={{ featured: index === 1 }}>
                <span class="eyebrow">{branch.locality}</span>
                {index === 1 && <em>Nejlepší cena</em>}
                <h3>{branch.name}</h3>
                <>
                  <strong>
                    {course.category === 'moto' && 'od '}
                    {money(displayPrice(course, branch.id))}
                  </strong>
                  <p>
                    {course.category === 'moto'
                      ? 'Moto Základ nebo Moto Jistota podle vašich zkušeností.'
                      : course.category === 'prives'
                        ? 'Cena kurzu nezahrnuje poplatky za zkoušku.'
                        : 'Jedna cena kurzu na zvolené pobočce. Bez matoucích balíčků.'}
                  </p>
                  {isMoto && motoEnrollmentPaused ? (
                    <span class="moto-pause" role="status">
                      {motoEnrollmentPausedMessage}
                    </span>
                  ) : (
                    <button
                      class="btn primary"
                      data-order
                      disabled
                      data-course={course.id}
                      data-branch={branch.id}
                    >
                      Vybrat {branch.name} ↗
                    </button>
                  )}
                  <a class="text-link branch-page-link" href={`/${branch.id}`}>
                    Autoškola {branch.name} →
                  </a>
                </>
              </article>
            ))
          }
        </div>
        <p class="fee-note">
          * Ceny kurzů nezahrnují poplatky za zkoušku. Ty najdete přehledně v <a href="/cenik"
            >ceníku</a
          >.
        </p>
      </div>
    </section>

    <section class="next-step">
      <div class="container next-grid">
        <div>
          <span>DALŠÍ KROK</span><h2>Stačí si vybrat termín zápisu.</h2><p>
            Pokud vám kurz sedí, objednávka vás provede výběrem pobočky a termínu zápisu.
          </p>
        </div><div>
          <div class="actions">
            {
              isMoto && motoEnrollmentPaused ? (
                <span class="moto-pause" role="status">
                  {motoEnrollmentPausedMessage}
                </span>
              ) : (
                <button class="btn primary" data-order disabled data-course={course.id}>
                  Přihlásit se ↗
                </button>
              )
            }<a class="btn secondary" href="/kontakt">Zeptat se</a>
          </div><p class="next-contact">
            ☎ <a href="tel:+420725717755">725 717 755</a>
            <i>·</i> ✉
            <a href="mailto:info@autoskolabubu.cz">info@autoskolabubu.cz</a>
          </p>
        </div>
      </div>
    </section>
    <CourseFaq course={course} />
  </main>
</Base>

<style>
  .course-page {
    overflow: hidden;
  }
  .product-hero {
    background:
      radial-gradient(circle at 75% 10%, #d9f4ef 0, transparent 34%),
      linear-gradient(135deg, #f8fcfb, #fff 76%);
    border-bottom: 1px solid #e3f0ed;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(390px, 1.08fr);
    gap: 68px;
    align-items: center;
    padding: 68px 0 52px;
  }
  .hero-copy h1 {
    max-width: 610px;
    font-size: clamp(3.25rem, 5.65vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }
  .hero-copy .lead {
    max-width: 520px;
    margin-top: 20px;
    font-size: 1.11rem;
    line-height: 1.52;
    color: var(--muted);
  }
  .actions {
    margin-top: 25px;
  }
  .hero-signals {
    display: flex;
    gap: 20px;
    margin-top: 32px;
    color: var(--blue);
    font-size: 0.68rem;
    font-weight: 700;
  }
  .hero-signals span {
    max-width: 145px;
    line-height: 1.35;
  }
  .hero-image {
    position: relative;
  }
  .hero-image :global(img) {
    width: 100%;
    aspect-ratio: 1.36;
    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 20px 44px #17335f21;
  }
  .hand-note {
    position: absolute;
    top: 24px;
    left: -28px;
    padding: 14px 18px;
    border-radius: 10px;
    background: #fffffff2;
    color: #21457f;
    box-shadow: 0 12px 25px #17335f1c;
    font-family: cursive;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.3;
    transform: rotate(-5deg);
  }
  .fleet-badge {
    position: absolute;
    right: -23px;
    bottom: 17px;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 8px;
    padding: 11px 15px;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 12px 25px #17335f1a;
    color: #204276;
    font-size: 0.7rem;
  }
  .fleet-badge:first-letter {
    color: var(--brand);
    font-size: 1.3rem;
  }
  .fleet-badge b {
    font-size: 0.7rem;
  }
  .fleet-badge small {
    grid-column: 2;
    font-size: 0.62rem;
    color: var(--muted);
  }
  .fit-section {
    padding: 78px 0;
  }
  .fit-grid {
    display: grid;
    grid-template-columns: 0.92fr 1fr;
    gap: 22px;
    align-items: start;
  }
  .fit-grid h2,
  .section-head h2 {
    max-width: 610px;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.03;
    letter-spacing: -0.045em;
  }
  .fit-lead {
    max-width: 390px;
    margin-top: 15px;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--muted);
  }
  .fit-photo {
    position: relative;
    margin-top: 22px;
    overflow: hidden;
    border-radius: 13px;
  }
  .fit-photo :global(img) {
    width: 100%;
    height: 245px;
    object-fit: cover;
  }
  .fit-photo span {
    position: absolute;
    right: 12px;
    top: 13px;
    padding: 10px;
    background: #fffffff0;
    border-radius: 8px;
    color: #21457f;
    font-family: cursive;
