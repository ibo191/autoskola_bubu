---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Roadmap from '../../components/Roadmap.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import {
  courses,
  branches,
  availableAt,
  displayPrice,
  money,
  type Course,
} from '../../lib/catalog';
import car from '../../assets/car.jpg';
import moto from '../../assets/moto.jpeg';
import trailer from '../../assets/trailer.jpeg';
export const prerender = true;
export function getStaticPaths() {
  return courses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}
interface Props {
  course: Course;
}
const { course } = Astro.props;
const photo = course.category === 'auto' ? car : course.category === 'moto' ? moto : trailer;
const availableBranches = branches.filter((b) => availableAt(course, b.id));
const minPrice = Math.min(...availableBranches.map((b) => displayPrice(course, b.id)));
const categoryLabel =
  course.category === 'auto'
    ? 'Řidičák na auto'
    : course.category === 'moto'
      ? 'Motocyklový kurz'
      : 'Kurz na přívěs';
const hero = {
  b: {
    h1: 'Řidičák skupiny B bez chaosu.',
    lead: 'Kurz pro začátečníky, kteří chtějí jasný plán, klidný přístup a přípravu na reálný provoz.',
    fit: 'Sedí vám, pokud chcete začít od nuly a postupně se dostat od prvních rozjezdů k samostatné jízdě.',
  },
  'b-automat': {
    h1: 'Řidičák na automat bez zbytečného stresu.',
    lead: 'Výcvik pro ty, kteří chtějí řešit provoz, přednosti a bezpečnost bez starostí s řazením.',
    fit: 'Sedí vám, pokud víte, že budete jezdit automatem, nebo chcete klidnější start za volantem.',
  },
  l17: {
    h1: 'Řidičák L17 pro bezpečný začátek.',
    lead: 'Skupina B už od 17 let s mentorem po zkoušce. Dává čas získat zkušenosti dřív, ale s oporou.',
    fit: 'Sedí studentům, kteří chtějí řídit dřív a mají mentora, se kterým budou po získání řidičáku jezdit.',
  },
  am: {
    h1: 'Skupina AM: první krok na motorce.',
    lead: 'Kurz pro lehké motocykly a první zkušenost s provozem na dvou kolech.',
    fit: 'Sedí vám, pokud chcete začít bezpečně a potřebujete si osvojit ovládání motorky od základů.',
  },
  a1: {
    h1: 'Skupina A1 pro lehkou motorku.',
    lead: 'Motocyklový kurz s důrazem na ovládání stroje, cvičiště a jistotu v provozu.',
    fit: 'Pokud je A1 váš první řidičák, nabídneme Moto Jistotu prvořidičák s rozšířenou teoretickou přípravou.',
  },
  a2: {
    h1: 'Skupina A2 jako další krok na motorce.',
    lead: 'Kurz nebo rozšíření podle toho, jaké oprávnění už držíte a jak dlouho.',
    fit: 'Sedí vám, pokud chcete silnější motorku a potřebujete zvolit správnou cestu mezi kurzem, rozšířením a doplňovací zkouškou.',
  },
  a: {
    h1: 'Skupina A pro velkou motorku.',
    lead: 'Kurz pro velké motocykly s výběrem správného postupu podle předchozího oprávnění.',
    fit: 'Sedí zkušenějším jezdcům i žadatelům, kteří potřebují jasně ověřit, zda jdou na rozšíření nebo doplňovací zkoušku.',
  },
  b96: {
    h1: 'Rozšíření B96 pro větší soupravu.',
    lead: 'Praktické rozšíření pro situace, kdy vám běžná skupina B už nestačí.',
    fit: 'Sedí vám, pokud potřebujete tahat větší přívěs, ale nemusíte jít rovnou do skupiny B+E.',
  },
  be: {
    h1: 'Skupina B+E pro auto s přívěsem.',
    lead: 'Výcvik pro řízení soupravy s přívěsem, která už přesahuje možnosti běžného oprávnění B.',
    fit: 'Sedí vám, pokud potřebujete jezdit s těžším přívěsem, vozíkem, karavanem nebo pracovní soupravou.',
  },
}[course.id];
const benefits =
  course.category === 'moto'
    ? [
        'Výcvik pouze na pobočce Praha 8 Střížkov.',
        'Výběr balíčku podle zkušeností a oprávnění.',
        'Cvičiště, ovládání motorky a příprava na zkoušku.',
      ]
    : course.category === 'prives'
      ? [
          'Výcvik přívěsů pouze na Střížkově.',
          'Praktická příprava na manipulaci se soupravou.',
          'Pomůžeme ověřit, zda potřebujete B96 nebo B+E.',
        ]
      : [
          'Jasný plán od zápisu po zkoušku.',
          'Teorie propojená s reálným provozem.',
          'Možnost klasického B, L17 i automatu podle pobočky.',
        ];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.name,
  description: hero.lead,
  provider: {
    '@type': 'Organization',
    name: 'Autoškola BuBu',
    url: 'https://www.autoskolabubu.cz',
  },
  offers: {
    '@type': 'Offer',
    price: minPrice,
    priceCurrency: 'CZK',
    availability: 'https://schema.org/InStock',
  },
};
---

<Base
  title={`${course.label} – ${course.name}`}
  description={`${hero.h1} ${hero.lead} Autoškola BuBu Praha 8, Kladno a Statenice.`}
  schema={schema}
>
  <section class="page-hero course-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Drobečková navigace">
        <a href="/">Domů</a><span>/</span><a href="/kurzy">Kurzy</a><span>/</span><span
          >{course.label}</span
        >
      </nav>
      <div class="split">
        <div>
          <span class="eyebrow">{categoryLabel} · {course.label}</span><h1>{hero.h1}</h1><p
            class="lead"
          >
            {hero.lead}
          </p>
          <div class="actions">
            <button class="btn primary" data-order disabled data-course={course.id}
              >Přihlásit se do kurzu ↗</button
            ><a class="btn secondary" href="#cena">Zobrazit cenu</a>
          </div>
          <p class="microcopy">
            Objednávka je nezávazný první krok. Termín zápisu si vyberete až v posledním kroku.
          </p>
        </div><Image
          src={photo}
          alt={course.category === 'moto'
            ? 'Výcvikové motocykly Autoškoly BuBu'
            : course.category === 'prives'
              ? 'Výcviková souprava s přívěsem'
              : 'Auto Autoškoly BuBu pro praktický výcvik'}
          widths={[480, 800]}
          sizes="(max-width:640px) 90vw,45vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div><span class="eyebrow">Je to pro vás?</span><h2>Kurz bez zbytečného tlaku.</h2></div>
      <div>
        <p class="lead">{hero.fit}</p><ul class="checklist course-benefits">
          {benefits.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>
  <section class="section tinted">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Co získáte</span><h2>Výcvik, který má směr.</h2><p>
            Nejde jen o odchozený kurz. Cílem je, abyste rozuměli tomu, co na silnici děláte.
          </p>
        </div>
      </div>
      <div class="grid includes">
        <article class="card">
          <h3>Jasný postup</h3><p>
            Víte, co vás čeká: online objednávka, osobní zápis, teorie, jízdy a závěrečná zkouška.
          </p>
        </article>
        <article class="card">
          <h3>Klidné vysvětlení</h3><p>
            Když něco nejde napoprvé, vrátíme se k tomu. Bez křiku a bez shazování.
          </p>
        </article>
        <article class="card">
          <h3>Příprava na realitu</h3><p>
            Trénujeme situace, které potkáte u zkoušky i při běžném řízení po kurzu.
          </p>
        </article>
      </div>
    </div>
  </section>
  <Roadmap />
  <section class="section tinted" id="cena">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Cena a dostupnost</span><h2>Vyberte pobočku, která dává smysl.</h2>
        </div><a class="text-link" href="/cenik">Kompletní ceník ↗</a>
      </div>
      <div class="grid">
        {
          availableBranches.map((b) => (
            <article class="card price-card">
              <>
                <span class="eyebrow">{b.locality}</span>
                <h3>{b.name}</h3>
                <div class="price">
                  {course.category === 'moto' && <small>od </small>}
                  {money(displayPrice(course, b.id))}
                  <small>*</small>
                </div>
              </>
              <p>
                {course.category === 'moto'
                  ? 'Moto Základ 24 900 Kč / Moto Jistota 31 900 Kč. Správnou variantu nabídneme podle vašich zkušeností a oprávnění.'
                  : course.category === 'prives'
                    ? 'Cena kurzu nezahrnuje poplatky za zkoušku.'
                    : 'Jedna cena kurzu na zvolené pobočce. Bez matoucích balíčků.'}
              </p>
              <button
                class="btn primary"
                data-order
                disabled
                data-course={course.id}
                data-branch={b.id}
              >
                Vybrat {b.name} ↗
              </button>
            </article>
          ))
        }
      </div><p class="fee-note">
        * Ceny kurzů nezahrnují poplatky za zkoušku. Ty najdete přehledně v <a href="/cenik"
          >ceníku</a
        >.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container split soft-close">
      <div><span class="eyebrow">Další krok</span><h2>Stačí si vybrat termín zápisu.</h2></div>
      <div>
        <p class="lead">
          Pokud vám kurz sedí, objednávka vás provede výběrem pobočky a termínu zápisu. Pokud si
          nejste jistí, klidně nám nejdřív zavolejte nebo napište.
        </p><div class="actions">
          <button class="btn primary" data-order disabled data-course={course.id}
            >Přihlásit se ↗</button
          ><a class="btn secondary" href="/kontakt">Zeptat se</a>
        </div>
      </div>
    </div>
  </section>
  <Faq /><FinalCta />
</Base>
<style>
  .microcopy {
    margin-top: 18px;
    font-size: 0.82rem;
  }
  .includes {
    margin-top: 32px;
  }
  .course-benefits {
    margin-top: 24px;
  }
  .price-card .btn {
    margin-top: 22px;
  }
  .fee-note {
    font-size: 0.8rem;
    margin-top: 28px;
  }
  .soft-close {
    align-items: start;
  }
</style>
