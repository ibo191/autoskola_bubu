---
export const prerender = true;
import Base from '../layouts/Base.astro';
import BranchCards from '../components/BranchCards.astro';
import FinalCta from '../components/FinalCta.astro';
import { Image } from 'astro:assets';
import automaticScala from '../assets/courses/b-automatic-scala.png';
import manualFabia from '../assets/courses/b-manual-fabia.png';
import storyDriving from '../assets/about-story-driving.png';

const partners = [
  { name: 'Kvalty', text: 'Portál pro výběr a hodnocení autoškol.' },
  { name: 'Motovšem', text: 'Partner pro motorkářskou komunitu a vybavení.' },
  {
    name: 'Optiscont optika',
    text: 'Optika pro studenty, kteří řeší zrak před kurzem nebo zdravotním posudkem.',
  },
  {
    name: 'Autoškola testy',
    text: 'Online testy a příprava pro budoucí řidiče.',
    href: 'https://www.autoskola-testy.cz',
    logo: 'https://www.autoskola-testy.cz/images/logo-264x76.jpg',
    alt: 'Autoškola testy – eTesty',
  },
  {
    name: 'Moje autoškola',
    text: 'Software pro autoškoly.',
    href: 'https://www.moje-autoskola.cz',
    logo: 'https://www.moje-autoskola.cz/img/logo_moje_autoskola-264x76.jpg',
    alt: 'MOJE AUTOŠKOLA',
  },
];

const fleet = [
  {
    id: 'automat',
    label: 'Automat',
    title: 'Škoda Scala ve verzi automat',
    text: 'Klidný start pro studenty, kteří se chtějí soustředit hlavně na provoz, značky, přednosti a bezpečné rozhodování bez řazení.',
    meta: 'Skupina B automat',
    image: automaticScala,
    alt: 'Černá Škoda Scala Autoškoly BuBu pro výcvik na automat',
  },
  {
    id: 'manual',
    label: 'Manuál',
    title: 'Škoda Fabia 3. generace v manuálu',
    text: 'Pro manuální výcvik používáme více vozů Škoda Fabia třetí generace. Studenti tak jezdí v přehledném autě, které se dobře ovládá i při prvních jízdách.',
    meta: 'Skupina B a L17',
    image: manualFabia,
    alt: 'Bílá Škoda Fabia Autoškoly BuBu pro manuální výcvik skupiny B',
  },
];

const fleetGroups = [
  {
    title: 'Motorky',
    text: 'A1 Honda 125, A2 Kawasaki, skupina A Suzuki Bandit a 2× Kawasaki Z650.',
  },
  {
    title: 'Přívěsy a větší auta',
    text: 'Pro výcvik s přívěsnými vozíky a většími auty máme přívěsný vozík a Seat Alhambra.',
  },
];
---

<Base
  title="O nás"
  description="Autoškola BuBu vznikla s myšlenkou vychovávat bezpečné a zodpovědné řidiče. Za školou stojí lidé se zkušeností z provozu i policie."
>
  <section class="about-hero">
    <div class="about-hero-shape about-hero-shape-left" aria-hidden="true"></div>
    <div class="about-hero-shape about-hero-shape-right" aria-hidden="true"></div>
    <div class="container about-hero-inner">
      <nav class="breadcrumbs" aria-label="Drobečková navigace">
        <a href="/">Domů</a><span>/</span><span>O nás</span>
      </nav>
      <div class="about-hero-copy">
        <span class="eyebrow">Autoškola BuBu</span><h1>Nechceme jen odučit kurz.</h1><p
          class="lead"
        >
          Chceme vychovávat řidiče, které se nebudeme bát pustit do provozu.
        </p>
      </div>
      <img class="about-hero-bubak" src="/brand/bubak.webp" alt="" aria-hidden="true" />
      <p class="about-hero-note" aria-hidden="true">
        Lepší řidiči<br />dělají klidnější<br />silnice.
      </p>
    </div>
  </section>
  <section class="section about-story-section">
    <div class="container about-story-grid">
      <div class="content about-story-copy">
        <span class="eyebrow">Proč jsme vznikli</span><h2>Více bezpečnosti na cestách.</h2>
        <p>
          Naše autoškola byla založená s myšlenkou přinést na cesty více bezpečnosti a přejít od
          přístupu „odučit kurz“ k tomu, abychom vychovávali skutečné řidiče, kteří se na cestě cítí
          bezpečně a zodpovědně.
        </p>
        <p>
          Autoškolu založila skupina bývalých a současných příslušníků policie, aby předávala své
          zkušenosti další generaci řidičů. Nechceme z vás udělat člověka, který jen projde
          zkouškou. Chceme, abyste rozuměli provozu a zvládli v něm fungovat s klidem.
        </p>
        <a class="btn primary about-story-cta" href="#hodnoty"
          >Poznejte náš přístup <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="about-story-image">
        <Image
          src={storyDriving}
          alt="Instruktor Autoškoly BuBu podporuje studentku při jízdě autem"
          widths={[640, 960, 1280]}
          sizes="(max-width: 860px) 92vw, 54vw"
          format="webp"
        />
        <div class="about-story-message">
          <strong>Bez stresu.<br />Bez křiku.<br />S respektem.</strong>
          <span>Protože lepší řidiči dělají klidnější silnice.</span>
        </div>
      </div>
    </div>
  </section>
  <section class="section about-values" id="hodnoty">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">Naše hodnoty</span><h2>Bez křiku. S odpovědností.</h2></div>
      </div>
      <div class="about-value-grid">
        <article class="about-value-card">
          <span class="about-value-icon" aria-hidden="true">⛨</span><div>
            <span class="eyebrow">01 / Bezpečnost</span><h3>Nejdřív člověk, potom zkouška.</h3><p>
              Bezpečnost je pro nás na prvním místě. Nejde jen o splnění testu, ale o to, abyste se
              na silnici cítili jistě i po kurzu.
            </p>
          </div>
        </article>
        <article class="about-value-card">
          <span class="about-value-icon" aria-hidden="true">▰</span><div>
            <span class="eyebrow">02 / Praxe</span><h3>Zkušenosti z reálného provozu.</h3><p>
              Učíme na situacích, které skutečně potkáte. Předáváme reálné zkušenosti z každodenního
              provozu, nejen teorii z učebnic.
            </p>
          </div>
        </article>
        <article class="about-value-card">
          <span class="about-value-icon" aria-hidden="true">●</span><div>
            <span class="eyebrow">03 / Klid</span><h3>Respekt k tomu, že se učíte.</h3><p>
              Chyby patří k výcviku. Důležité je klidně si je přiznat, pochopit a postupovat vaším
              tempem.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="section fleet-section" id="nas-vozovy-park">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Náš vozový park</span><h2>Auta a motorky, na kterých se učí.</h2><p>
            Výcvik stavíme na technice, která studentům dává jistotu od prvních rozjezdů až po
            závěrečnou zkoušku.
          </p>
        </div>
      </div>
      <div class="fleet-switcher" aria-label="Vozový park Autoškoly BuBu">
        {
          fleet.map((vehicle, index) => (
            <>
              <input id={`fleet-${vehicle.id}`} type="radio" name="fleet" checked={index === 0} />
              <label for={`fleet-${vehicle.id}`}>{vehicle.label}</label>
            </>
          ))
        }
        <div class="fleet-panels">
          {
            fleet.map((vehicle) => (
              <article class="fleet-panel" data-fleet-panel={vehicle.id}>
                <div class="fleet-photo">
                  <Image
                    src={vehicle.image}
                    alt={vehicle.alt}
                    widths={[480, 760, 1040]}
                    sizes="(max-width: 760px) 92vw, 48vw"
                    format="webp"
                    loading="lazy"
                  />
                </div>
                <div class="fleet-copy">
                  <span class="eyebrow">{vehicle.meta}</span>
                  <h3>{vehicle.title}</h3>
                  <p>{vehicle.text}</p>
                  <ul class="checklist compact-list">
                    <li>Vhodné pro běžný městský provoz.</li>
                    <li>Přehledné ovládání pro začátečníky.</li>
                    <li>Výcvik bez zbytečného stresu.</li>
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
      <div class="fleet-more-grid">
        {
          fleetGroups.map((item) => (
            <article class="card fleet-more-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section partners-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Naši partneři</span><h2>
            Spolupracujeme s lidmi, kteří dávají smysl.
          </h2>
        </div>
      </div>
      <div class="grid partner-grid">
        {
          partners.map((partner) => (
            <article class="card partner-card">
              <>
                {partner.logo && partner.href ? (
                  <a href={partner.href} target="_blank" rel="noopener noreferrer">
                    <img
                      src={partner.logo}
                      alt={partner.alt}
                      width="264"
                      height="76"
                      loading="lazy"
                    />
                  </a>
                ) : (
                  <h3>{partner.name}</h3>
                )}
                <p>{partner.text}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <BranchCards /><FinalCta />
</Base>
<style>
  .about-hero {
    position: relative;
    overflow: hidden;
    min-height: 330px;
    background:
      radial-gradient(circle at 63% 48%, #d2f2ef 0 12%, transparent 12.4%),
      linear-gradient(105deg, #f9fdfc 0%, #edfafa 48%, #d8f3f0 100%);
  }
  .about-hero::after {
    content: '';
    position: absolute;
    right: -8%;
    bottom: -125px;
    width: 62%;
    height: 260px;
    border: 2px dashed #7dcac6;
    border-width: 2px 0 0;
    border-radius: 52% 48% 0 0;
    opacity: 0.5;
    transform: rotate(-7deg);
  }
  .about-hero-inner {
    position: relative;
    z-index: 1;
    min-height: 330px;
    padding-top: 24px;
    padding-bottom: 44px;
  }
  .about-hero-copy {
    position: relative;
    z-index: 2;
    max-width: 610px;
    margin-top: 26px;
  }
  .about-hero h1 {
    max-width: 620px;
    margin: 10px 0 12px;
    color: var(--ink);
    font-size: clamp(3rem, 5vw, 5.25rem);
    line-height: 0.97;
    letter-spacing: -0.07em;
  }
  .about-hero .lead {
    max-width: 510px;
    font-size: 1.03rem;
  }
  .about-hero-bubak {
    position: absolute;
    z-index: 1;
    right: 28%;
    bottom: -10px;
    width: min(190px, 16vw);
    filter: drop-shadow(0 18px 16px #102e5a1a);
    transform: rotate(7deg);
  }
  .about-hero-note {
    position: absolute;
    z-index: 2;
    right: 12%;
    top: 88px;
    margin: 0;
    color: #4bafa7;
    font-size: clamp(1.25rem, 2.2vw, 2rem);
    font-weight: 700;
    line-height: 1.05;
    transform: rotate(-7deg);
  }
  .about-hero-shape {
    position: absolute;
    bottom: -116px;
    border-radius: 50% 50% 0 0;
    background: #e4f8f5;
  }
  .about-hero-shape-left {
    left: 43%;
    width: 40%;
    height: 230px;
    transform: rotate(-13deg);
  }
  .about-hero-shape-right {
    right: -14%;
    width: 44%;
    height: 360px;
    background: #d1efed;
    transform: rotate(12deg);
  }
  .about-story-section {
    padding-block: clamp(58px, 8vw, 100px);
  }
  .about-story-grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.8fr) minmax(420px, 1.35fr);
    gap: clamp(40px, 7vw, 100px);
    align-items: center;
  }
  .about-story-copy {
    max-width: 500px;
  }
  .about-story-copy h2 {
    margin: 12px 0 18px;
    font-size: clamp(2.3rem, 3.5vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }
  .about-story-copy p {
    font-size: 1rem;
    line-height: 1.55;
  }
  .about-story-cta {
    margin-top: 12px;
  }
  .about-story-cta span {
    margin-left: 18px;
    font-size: 1.25em;
  }
  .about-story-image {
    position: relative;
    min-height: 470px;
    overflow: hidden;
    border-radius: 24px;
    background: #e6f4f3;
    box-shadow: 0 24px 60px #12335d1c;
  }
  .about-story-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 470px;
    object-fit: cover;
  }
  .about-story-message {
    position: absolute;
    top: 28px;
    left: 28px;
    display: grid;
    gap: 26px;
    width: min(225px, calc(100% - 56px));
    padding: 26px;
    border-radius: 20px;
    background: linear-gradient(145deg, #55c8bd, #2ca89f);
    color: #fff;
    box-shadow: 0 16px 32px #166f682e;
  }
  .about-story-message strong {
    font-size: clamp(1.45rem, 2.1vw, 2.1rem);
    line-height: 1.04;
  }
  .about-story-message span {
    font-size: 0.88rem;
    line-height: 1.35;
  }
  .about-values {
    position: relative;
    overflow: hidden;
    background: linear-gradient(120deg, #edfafa, #dff5f2);
  }
  .about-values::before {
    content: '';
    position: absolute;
    left: -70px;
    bottom: -145px;
    width: 340px;
    height: 300px;
    border-radius: 50%;
    background: #d3eeec;
  }
  .about-values .container {
    position: relative;
    z-index: 1;
  }
  .about-values h2 {
    font-size: clamp(2rem, 3vw, 3.25rem);
    letter-spacing: -0.055em;
  }
  .about-value-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .about-value-card {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 18px;
    min-height: 220px;
    padding: 28px;
    border: 1px solid #dcebea;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 12px 30px #153c6020;
  }
  .about-value-icon {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border-radius: 50%;
    background: #ddf5f1;
    color: var(--brand-dark);
    font-size: 1.7rem;
    font-weight: 800;
  }
  .about-value-card h3 {
    margin: 6px 0 7px;
    font-size: 1.1rem;
    line-height: 1.14;
  }
  .about-value-card p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .fleet-switcher {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content)) 1fr;
    gap: 12px;
    align-items: center;
  }
  .fleet-switcher > input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .fleet-switcher > label {
    min-height: 46px;
    padding: 12px 20px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-weight: 800;
    cursor: pointer;
    transition:
      background var(--ease),
      border-color var(--ease),
      color var(--ease),
      box-shadow var(--ease);
  }
  .fleet-switcher > input:focus-visible + label {
    outline: 3px solid #9dd9dc;
    outline-offset: 3px;
  }
  #fleet-automat:checked + label,
  #fleet-manual:checked + label {
    border-color: transparent;
    background: var(--brand);
    color: #fff;
    box-shadow: 0 14px 32px rgba(77, 174, 182, 0.22);
  }
  .fleet-panels {
    grid-column: 1 / -1;
    margin-top: 14px;
    border: 1px solid var(--line);
    border-radius: 30px;
    background: linear-gradient(135deg, #ffffff 0%, #f2fbfa 100%);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .fleet-panel {
    display: none;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: 0;
    align-items: stretch;
  }
  #fleet-automat:checked ~ .fleet-panels [data-fleet-panel='automat'],
  #fleet-manual:checked ~ .fleet-panels [data-fleet-panel='manual'] {
    display: grid;
  }
  .fleet-photo {
    min-height: 390px;
    background: #e8f3f4;
  }
  .fleet-photo img {
    width: 100%;
    height: 100%;
    min-height: 390px;
    object-fit: cover;
    display: block;
  }
  .fleet-copy {
    padding: clamp(28px, 4vw, 52px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .fleet-copy h3 {
    font-size: clamp(2rem, 3vw, 3.2rem);
    margin-bottom: 14px;
  }
  .compact-list {
    margin-top: 22px;
  }
  .fleet-more-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 22px;
  }
  .fleet-more-card {
    background: #fff;
  }
  .partner-card h3 {
    font-size: 1.7rem;
  }
  .partner-card a {
    display: inline-flex;
    align-items: center;
    min-height: 76px;
  }
  .partner-card img {
    display: block;
    width: min(100%, 264px);
    height: auto;
    max-height: 76px;
    object-fit: contain;
    object-position: left center;
  }
  @media (max-width: 860px) {
    .about-hero,
    .about-hero-inner {
      min-height: 300px;
    }
    .about-hero-bubak {
      right: 27%;
      width: 145px;
    }
    .about-hero-note {
      right: 7%;
      top: 118px;
    }
    .about-story-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .about-story-copy {
      max-width: 620px;
    }
    .about-story-image,
    .about-story-image :global(img) {
      min-height: min(62vw, 480px);
    }
    .about-value-grid {
      grid-template-columns: 1fr;
    }
    .about-value-card {
      min-height: 0;
    }
    .fleet-switcher {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .fleet-switcher > label {
      text-align: center;
    }
    .fleet-panel {
      grid-template-columns: 1fr;
    }
    .fleet-photo,
    .fleet-photo img {
      min-height: 280px;
    }
    .fleet-more-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .about-hero,
    .about-hero-inner {
      min-height: 315px;
    }
    .about-hero-inner {
      padding-top: 18px;
    }
    .about-hero-copy {
      margin-top: 20px;
      max-width: 72%;
    }
    .about-hero h1 {
      font-size: clamp(2.65rem, 13vw, 3.5rem);
    }
    .about-hero .lead {
      font-size: 0.92rem;
    }
    .about-hero-bubak {
      right: 6%;
      bottom: 6px;
      width: 118px;
    }
    .about-hero-note {
      display: none;
    }
    .about-story-section {
      padding-block: 52px;
    }
    .about-story-image,
    .about-story-image :global(img) {
      min-height: 340px;
    }
    .about-story-message {
      top: 16px;
      left: 16px;
      gap: 14px;
      width: min(190px, calc(100% - 32px));
      padding: 18px;
    }
    .about-story-message span {
      font-size: 0.76rem;
    }
    .about-value-card {
      grid-template-columns: 46px 1fr;
      gap: 14px;
      padding: 22px;
    }
    .about-value-icon {
      width: 46px;
      height: 46px;
      font-size: 1.35rem;
    }
    .fleet-switcher {
      gap: 10px;
    }
    .fleet-switcher > label {
      padding-inline: 14px;
    }
    .fleet-panels {
      border-radius: 24px;
    }
    .fleet-photo,
    .fleet-photo img {
      min-height: 220px;
    }
  }
</style>
