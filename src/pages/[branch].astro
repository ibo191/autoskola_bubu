---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Roadmap from '../components/Roadmap.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import GoogleReviewsBanner from '../components/GoogleReviewsBanner.astro';
import KladnoBranch from '../components/KladnoBranch.astro';
import StateniceBranch from '../components/StateniceBranch.astro';
import { branches, money, type Branch } from '../lib/catalog';
import manualCar from '../assets/courses/b-manual-fabia.png';
export const prerender = true;
export function getStaticPaths() {
  return branches.map((branch) => ({ params: { branch: branch.id }, props: { branch } }));
}
interface Props {
  branch: Branch;
}
const { branch } = Astro.props;
const isStrizkov = branch.id === 'strizkov';
const isKladno = branch.id === 'kladno';
const isStatenice = branch.id === 'statenice';
const phoneFormatted = branch.phone.replace(/(\+420)(\d{3})(\d{3})(\d{3})/, '$1 $2 $3 $4');
const mapQuery = encodeURIComponent(`Autoškola BuBu ${branch.address}`);
const localBoxes = [
  {
    title: 'Kde se jezdí?',
    text: 'Z pobočky na Střížkově jezdíme na Praze 8 a 9: Střížkov, Prosek, Kobylisy, Letňany, Ládví, Ďáblice a okolité lokality.',
  },
  {
    title: 'Kde probíhá teorie?',
    text: 'Teorie probíhá na naší pobočce na Praze 8: U Kapliček 34, Střížkov. Teorie probíhají srozumitelně, prakticky a bez zahlcení.',
  },
  {
    title: 'Jak se k nám dostanete?',
    text: 'Metro C Střížkov je přibližně 10 minut od pobočky. Navazují také autobusy a MHD z Proseku, Kobylis, Letňan, Ládví, Ďáblic a Vysočan.',
  },
  {
    title: 'Pro koho je pobočka vhodná?',
    text: 'Začátečníci, lidé, kteří nikdy neřídili, kondiční jízdy, studenti i zájemci o motorku, kteří chtějí lidský přístup.',
  },
];
const strizkovFaq = [
  {
    q: 'Kde se jezdí na Střížkově?',
    a: 'Jízdy plánujeme primárně na Praze 8 a 9: Střížkov, Prosek, Kobylisy, Letňany, Ládví, Ďáblice a navazující pražský provoz. První jízda probíhá na našem cvičišti v Čakovicích, kde si studenti procvičí ovládání auta a rozjezdy před výjezdem do provozu. Následně jezdíme i v mírnějším provozu v okolí Prahy. Během výcviku si vyzkoušíte centrum Prahy, dálnici, tankování, myčku, garáže i McDrive.',
  },
  {
    q: 'Kde a jak probíhají teorie?',
    a: 'Teorie probíhají prezenčně na pobočce U Kapliček 34, Praha 8 Střížkov. V kurzu skupiny B absolvujete 4 bloky teorií, které probíhají pravidelně během pracovního týdne.',
  },
  {
    q: 'Jak se dostanete na pobočku na Střížkově?',
    a: 'Nejjednodušší je metro C, stanice Střížkov, která je přibližně 10 minut chůze od pobočky. Využít můžete také autobusové spojení z Proseku, Kobylis, Letňan, Ládví, Ďáblic a Vysočan.',
  },
  {
    q: 'Kolik stojí řidičák skupiny B na Střížkově?',
    a: 'Cena kurzu skupiny B je 25 900 Kč za výuku a výcvik v autoškole. Před první zkouškou se zvlášť hradí poplatek autoškole za organizaci zkoušky 1 000 Kč a úřední poplatek podle aktuálního ceníku příslušného úřadu. Za každý opakovaný termín zkoušky se autoškole hradí 800 Kč; případný úřední poplatek se řídí opakovanou částí zkoušky.',
  },
  {
    q: 'Pro koho je pobočka Střížkov vhodná?',
    a: 'Pobočka je vhodná pro studenty z okolních středních škol, pracující dospělé, lidi bez řidičáku i zájemce o kondiční jízdy. Na Střížkově učíme také všechny skupiny motorek, takže se hodí i pro motorkáře. Je vhodná pro nervózní studenty, kteří chtějí klidný přístup bez křiku a stresu.',
  },
  {
    q: 'Jak se můžu přihlásit do autoškoly?',
    a: 'Online vyplníte objednávku na našem webu a v posledním kroku si zvolíte termín zápisu. Na zápis přijdete se zdravotním posudkem od praktického lékaře, oboustranně vytištěnou a vyplněnou žádostí o přijetí k výcviku a výuce a občanským průkazem. Pokud žádáte o řidičák v režimu L17, přijďte i se zákonným zástupcem. Na pobočce proběhne zápis a zařadíme vás do kurzu podle vaší časové preference.',
  },
];
const branchSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `https://www.autoskolabubu.cz/${branch.id}#localbusiness`,
  name: `Autoškola BuBu ${branch.name}`,
  url: `https://www.autoskolabubu.cz/${branch.id}`,
  telephone: branch.phone,
  email: branch.email,
  address: branch.address,
  parentOrganization: {
    '@type': 'Organization',
    name: 'Autoškola BuBu',
    url: 'https://www.autoskolabubu.cz',
  },
};
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Domů', item: 'https://www.autoskolabubu.cz/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: `Autoškola ${branch.name}`,
      item: `https://www.autoskolabubu.cz/${branch.id}`,
    },
  ],
};
---

<Base
  title={isStrizkov
    ? 'Autoškola Praha 8 – Střížkov'
    : isKladno
      ? 'Autoškola Kladno | Řidičák bez stresu'
      : isStatenice
        ? 'Autoškola Statenice a okolí'
        : `Autoškola ${branch.name}`}
  description={isStrizkov
    ? 'Autoškola Praha 8 Střížkov. Řidičák skupiny B s jasným plánem výcviku, přípravou na pražský provoz a lidským přístupem bez křiku.'
    : isKladno
      ? `Autoškola Kladno: řidičák skupiny B na manuálu za ${money(branch.bPrice)}, také v režimu L17. Přihlášení online bez osobního zápisu a výcvik bez zbytečného stresu.`
      : isStatenice
        ? 'Autoškola Statenice s postupným výcvikem bez stresu. Řidičák skupiny B pro Statenice, Horoměřice, Velké Přílepy a okolí Prahy-západ.'
        : `Autoškola BuBu ${branch.name}. ${branch.address}. Kurz B za ${money(branch.bPrice)}. Osobní zápis a výcvik s lidským přístupem.`}
  schema={[branchSchema, breadcrumbSchema]}
>
  <section class:list={['page-hero', { 'kladno-hero': isKladno }]}>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Drobečková navigace">
        <a href="/">Domů</a><span>/</span><span>{branch.name}</span>
      </nav><div class="split">
        <div>
          <span class="eyebrow"
            >{isStrizkov ? 'Praha 8 · Střížkov' : `Vaše autoškola · ${branch.locality}`}</span
          ><h1>
            {
              isStrizkov
                ? 'Autoškola Praha 8 – Střížkov. Řidičák bez stresu.'
                : isKladno
                  ? 'Autoškola Kladno. Řidičák bez stresu.'
                  : isStatenice
                    ? 'Autoškola Statenice'
                    : `Za řidičákem do ${branch.name}.`
            }
          </h1><p class="lead">
            {
              isStrizkov
                ? 'Řidičák skupiny B – manuál nebo automat a možnost absolvovat kurz v režimu L17. Výcvik má jasný plán, přípravu na reálný pražský provoz a lidský přístup bez křiku.'
                : isKladno
                  ? 'Manuál nebo režim L17. Začnete na cvičišti a do provozu vyjedete postupně, bez křiku a zbytečného stresu.'
                  : isStatenice
                    ? 'Naučíme vás řídit postupně – od prvních metrů na cvičišti až po samostatnější jízdu v běžném provozu. Ve Statenicích a okolí trénujeme rozjezdy do kopce, menší ulice, zóny 30, zatáčky i jízdu mimo obec.'
                    : 'Začínáte od nuly? To je v pořádku. V BuBu vás provedeme od prvního rozjezdu až k závěrečné zkoušce.'
            }
          </p>{
            isStrizkov && (
              <p class="hero-copy">
                Střížkov je hlavní pobočka Autoškoly BuBu pro Prahu 8 a okolí. Hodí se pro studenty
                ze Střížkova, Proseku, Kobylis, Letňan, Ládví, Ďáblic i Prahy 9, kteří chtějí výcvik
                bez křiku a s přípravou na reálnou zkoušku.
              </p>
            )
          }{
            isStatenice && (
              <p class="hero-copy">
                Výcvik probíhá ve Statenicích a okolních obcích na Praze-západ. Trasy přizpůsobujeme
                zkušenostem žáka, aby náročnost rostla postupně.
              </p>
            )
          }{isKladno && (
            <div class="kladno-hero-offer" aria-label="Cena a možnosti kurzu">
              <div><span>Skupina B na manuálu</span><strong>{money(branch.bPrice)}</strong></div>
              <span class="kladno-hero-l17">Také pro L17</span>
            </div>
          )}<div class="actions">
            <button class="btn primary" data-order disabled data-branch={branch.id} data-course="b">
              {
                isKladno
                  ? 'Vyplnit přihlášku v Kladně ↗'
                  : isStrizkov
                    ? 'Přihlásit se do kurzu ↗'
                    : 'Chci začít řidičák ↗'
              }
            </button>
            {
              isStrizkov ? (
                <a class="btn secondary" href={`tel:${branch.phone}`}>
                  Zavolat a zeptat se
                </a>
              ) : isStatenice ? (
                <a class="btn secondary" href="#vycvik">
                  Zjistit více o výcviku
                </a>
              ) : (
                <a class="btn secondary" href="#pobocka">
                  Kde nás najdete
                </a>
              )
            }
          </div><p class="branch-price">
            {
              isKladno ? (
                'Online přihláška · pokyny e-mailem · bez osobního zápisu'
              ) : (
                <>
                  Skupina B <strong>{money(branch.bPrice)}</strong> · jedna cena, bez balíčků
                </>
              )
            }
          </p>
          {isKladno && (
            <p class="hero-copy">
              Přihlášku odešlete online hned teď. V Kladně nečekáte na osobní zápis; pokyny k
              zahájení kurzu dostanete e-mailem.
            </p>
          )}
        </div><div class:list={['branch-hero-image', { 'kladno-hero-image': isKladno }]}><Image
          src={manualCar}
          alt="Bílá Škoda Fabia Autoškoly BuBu pro manuální výcvik"
          widths={[480, 800]}
          sizes="(max-width:640px) 90vw, 45vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />{isKladno && <span class="kladno-image-caption">Začnete v klidu. Jízdy přizpůsobíme vašemu tempu.</span>}</div>
      </div>
    </div>
  </section>
  <div class:list={['local-trust', { 'kladno-trust': isKladno }]}>
    <div class="container">
      <span>✓ Skupina B – manuál{branch.id === 'strizkov' ? ' i automat' : ''}</span><span
        >✓ Možnost kurzu v režimu L17</span
      ><span>{isKladno ? '✓ Přihlášení online, pokyny e-mailem' : '✓ Osobní zápis na pobočce'}</span
      >{isStrizkov && <span>✓ Motorky pouze Praha</span>}
    </div>
  </div>

  {!isKladno && !isStatenice && <Roadmap />}

  {
    isStrizkov ? (
      <>
        <section class="section" id="lokalni-informace">
          <div class="container">
            <>
              <div class="section-heading">
                <div>
                  <>
                    <span class="eyebrow">Lokální informace</span>
                    <h2>Výcvik z Prahy 8 do reálného provozu.</h2>
                    <p>
                      Střížkov používáme jako praktický výchozí bod pro Prahu 8, Prahu 9 i klidnější
                      začátky mimo hustý provoz.
                    </p>
                  </>
                </div>
              </div>
              <div class="grid local-info-grid">
                {localBoxes.map((item) => (
                  <article class="card">
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))}
              </div>
            </>
          </div>
        </section>
        <section class="section tinted" id="pobocka">
          <div class="container split">
            <>
              <div>
                <>
                  <span class="eyebrow">Pobočka Praha 8 Střížkov</span>
                  <h2>
                    U Kapliček 34.
                    <br />
                    Sem přijdete na zápis i teorii.
                  </h2>
                  <p class="lead">{branch.address}</p>
                  <dl>
                    <>
                      <dt>Kdy nás zastihnete</dt>
                      <dd>{branch.hours}</dd>
                      <dt>Telefon</dt>
                      <dd>
                        <a href={`tel:${branch.phone}`}>{phoneFormatted}</a>
                      </dd>
                      <dt>E-mail</dt>
                      <dd>
                        <a href={`mailto:${branch.email}`}>{branch.email}</a>
                      </dd>
                    </>
                  </dl>
                </>
              </div>
              <div class="map-panel">
                <iframe
                  title="Mapa pobočky Autoškola BuBu Praha 8 Střížkov"
                  src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                />
              </div>
            </>
          </div>
        </section>
        <GoogleReviewsBanner
          heading="Zkušenosti žáků Autoškoly BuBu Střížkov."
          profileLabel="Autoškola BuBu Střížkov"
        />
        <section class="section tinted" id="faq">
          <div class="container faq-layout">
            <>
              <div>
                <>
                  <span class="eyebrow">FAQ Praha 8</span>
                  <h2>Nejčastější otázky ke Střížkovu.</h2>
                  <p>Praktické odpovědi před zápisem do kurzu.</p>
                </>
              </div>
              <div>
                {strizkovFaq.map((item) => (
                  <details>
                    <summary>
                      {item.q}
                      <span aria-hidden="true">+</span>
                    </summary>
                    <p>{item.a}</p>
                  </details>
                ))}
              </div>
            </>
          </div>
        </section>
        <section class="section" id="dotaz">
          <div class="container split contact-split">
            <>
              <div>
                <>
                  <span class="eyebrow">Dotaz na pobočku</span>
                  <h2>Napište nám přímo na Střížkov.</h2>
                  <p class="lead">
                    Nejste si jistí kurzem, termínem zápisu nebo tím, jestli je pro vás lepší
                    manuál, automat, L17 nebo motorka? Pošlete dotaz přímo pobočce Praha 8.
                  </p>
                </>
              </div>
              <form class="contact-card" data-branch-contact data-branch={branch.id}>
                <label>
                  Jméno a příjmení
                  <input name="name" autocomplete="name" required maxlength="120" />
                </label>
                <label>
                  E-mail
                  <input type="email" name="email" autocomplete="email" required maxlength="254" />
                </label>
                <label>
                  Telefon
                  <input type="tel" name="phone" autocomplete="tel" maxlength="20" />
                </label>
                <label>
                  Dotaz
                  <textarea name="message" required maxlength="2000" rows="6" />
                </label>
                <input
                  class="sr-only"
                  name="website"
                  tabindex="-1"
                  autocomplete="off"
                  aria-label="Nevyplňujte"
                />
                <button class="btn primary" type="submit">
                  Odeslat dotaz
                </button>
                <p class="small" data-contact-status role="status" />
              </form>
            </>
          </div>
        </section>
        <script src="../scripts/branch-contact.ts" />
      </>
    ) : isKladno ? (
      <KladnoBranch branch={branch} />
    ) : isStatenice ? (
      <StateniceBranch branch={branch} />
    ) : (
      <>
        <section class="section tinted" id="pobocka">
          <div class="container split">
            <>
              <div>
                <dl>
                  <>
                    <dt>Kdy nás zastihnete</dt>
                    <dd>{branch.hours ?? 'Otevírací dobu si prosím ověřte telefonicky.'}</dd>
                    <dt>Telefon</dt>
                    <dd>
                      <a href={`tel:${branch.phone}`}>{phoneFormatted}</a>
                    </dd>
                    <dt>E-mail</dt>
                    <dd>
                      <a href={`mailto:${branch.email}`}>{branch.email}</a>
                    </dd>
                  </>
                </dl>
                {branch.id === 'kladno' && (
                  <p class="small">Přesné místo osobního zápisu vám potvrdí pobočka.</p>
                )}
              </div>
              <div class="location-panel">
                <>
                  <span aria-hidden="true">↗</span>
                  <span class="eyebrow">{branch.locality}</span>
                  <h3>{branch.name}</h3>
                  <p>{branch.address}</p>
                  <a
                    class="btn secondary"
                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Autoškola BuBu ' + branch.address)}`}
                    rel="noreferrer"
                  >
                    Otevřít v mapách ↗
                  </a>
                  <p class="small">Mapa se načte až po otevření odkazu.</p>
                </>
              </div>
            </>
          </div>
        </section>
        <>
          <section class="section">
            <div class="container">
              <>
                <div class="section-heading">
                  <div>
                    <>
                      <span class="eyebrow">V BuBu na to nejste sami</span>
                      <h2>
                        Místo pro otázky.
                        <br />
                        Prostor získat jistotu.
                      </h2>
                    </>
                  </div>
                </div>
                <div class="grid">
                  <>
                    <article class="card">
                      <>
                        <h3>Začínáme základy</h3>
                        <p>Nečekáme, že už umíte řídit. Od toho je tu výcvik.</p>
                      </>
                    </article>
                    <article class="card">
                      <>
                        <h3>Propojujeme teorii s jízdou</h3>
                        <p>Pravidla dostanou smysl ve skutečných situacích na silnici.</p>
                      </>
                    </article>
                    <article class="card">
                      <>
                        <h3>Průběh znáte předem</h3>
                        <p>Online výběr, osobní zápis, teorie, jízdy a zkouška.</p>
                      </>
                    </article>
                  </>
                </div>
              </>
            </div>
          </section>
          <Faq />
        </>
      </>
    )
  }
  <FinalCta branch={branch.id} />
</Base>
<style>
  .kladno-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 93% 5%, #a9e5dd 0, transparent 31%),
      linear-gradient(125deg, #f0faf8 0%, #e7f4f2 48%, #e2eef9 100%);
  }
  .kladno-hero::before {
    content: '';
    position: absolute;
    width: 410px;
    height: 410px;
    left: -230px;
    bottom: -260px;
    border: 90px solid #4ab9ab22;
    border-radius: 50%;
    pointer-events: none;
  }
  .kladno-hero .container {
    position: relative;
  }
  .kladno-hero .split {
    gap: clamp(34px, 5vw, 72px);
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
  }
  .kladno-hero .eyebrow {
    display: inline-flex;
    border-radius: 999px;
    border: 1px solid #89cbc2;
    background: #ffffffc9;
    padding: 9px 15px;
    margin-bottom: 20px;
  }
  .kladno-hero h1 {
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    max-width: 760px;
  }
  .kladno-hero .lead {
    font-size: clamp(1.06rem, 1.5vw, 1.25rem);
    line-height: 1.6;
  }
  .kladno-hero .hero-copy {
    max-width: 590px;
    font-size: 0.9rem;
  }
  .kladno-hero-offer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
  }
  .kladno-hero-offer > div {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding: 11px 17px;
    border-radius: 13px;
    background: var(--ink);
    color: #fff;
    box-shadow: 0 13px 27px #17335f25;
  }
  .kladno-hero-offer div span {
    font-size: 0.78rem;
    font-weight: 650;
  }
  .kladno-hero-offer strong {
    font-size: clamp(1.55rem, 2.2vw, 2rem);
    line-height: 1.1;
    white-space: nowrap;
  }
  .kladno-hero-l17 {
    border-radius: 999px;
    background: #c8eee8;
    color: #0e5f57;
    font-size: 0.76rem;
    font-weight: 750;
    padding: 10px 13px;
  }
  .kladno-hero .actions {
    margin-top: 25px;
  }
  .kladno-hero .btn.primary {
    box-shadow: 0 12px 25px #126b6029;
  }
  .kladno-hero-image {
    position: relative;
    padding: 16px;
    border-radius: 32px;
    background: #ffffff9c;
    border: 1px solid #ffffffd9;
    box-shadow: 0 24px 65px #17335f1c;
    transform: rotate(1.3deg);
  }
  .kladno-hero-image :global(img) {
    width: 100%;
    border-radius: 22px;
    transform: rotate(-1.3deg);
  }
  .kladno-image-caption {
    position: absolute;
    left: 0;
    bottom: 10%;
    max-width: 245px;
    padding: 14px 17px;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    box-shadow: 0 12px 25px #17335f33;
    font-size: 0.8rem;
    font-weight: 650;
    line-height: 1.45;
