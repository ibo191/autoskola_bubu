---
export const prerender = true;
import Base from '../layouts/Base.astro';
---

<Base
  title="Informace o zpracování osobních údajů"
  description="Informace o zpracování osobních údajů Autoškoly BuBu s.r.o."
  noindex
>
  <section class="section">
    <div class="container content legal-document">
      <span class="eyebrow">Osobní údaje</span>
      <h1>Informace o zpracování osobních údajů</h1>
      <div class="notice">
        Správcem osobních údajů je Autoškola BuBu s.r.o., IČ 214 441 61, se sídlem V Lukách 103,
        Statenice, 252 62 Statenice.
      </div>
      <div class="document-card">
        <div>
          <h2>Aktuální znění dokumentu</h2>
          <p>Poslední aktualizace: září 2026</p>
        </div>
        <a
          class="btn primary"
          href="/dokumenty/informace-o-zpracovani-osobnich-udaju.pdf"
          target="_blank"
          rel="noreferrer">Otevřít nebo stáhnout PDF</a
        >
      </div>
      <object
        class="document-preview"
        data="/dokumenty/informace-o-zpracovani-osobnich-udaju.pdf"
        type="application/pdf"
        aria-label="Informace o zpracování osobních údajů"
      >
        <p>
          Náhled PDF se nepodařilo zobrazit. Dokument otevřete přes
          <a
            href="/dokumenty/informace-o-zpracovani-osobnich-udaju.pdf"
            target="_blank"
            rel="noreferrer">tento odkaz</a
          >.
        </p>
      </object>
      <p>
        Smluvní podmínky najdete také na stránce <a href="/obchodni-podminky">Obchodní podmínky</a>.
      </p>
      <a class="text-link" href="/">Zpět na úvod</a>
    </div>
  </section>
</Base>

<style>
  .document-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 28px 0 18px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--brand-soft);
  }
  .document-card h2 {
    font-size: 1.25rem;
  }
  .document-card p {
    margin-top: 5px;
    color: var(--muted);
  }
  .document-preview {
    width: 100%;
    height: min(78vh, 920px);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
  }
  @media (max-width: 640px) {
    .document-card {
      display: grid;
    }
    .document-card .btn {
      width: 100%;
      text-align: center;
    }
    .document-preview {
      height: 65vh;
    }
  }
</style>
