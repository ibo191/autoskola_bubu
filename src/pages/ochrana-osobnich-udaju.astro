---
export const prerender = true;
import { readFileSync } from 'node:fs';
import Base from '../layouts/Base.astro';

const termsText = readFileSync('src/content/legal/vop.txt', 'utf8');
const gdprText =
  termsText
    .match(/IX\.\s+Souhlas se zpracováním osobních údajů[\s\S]*?(?=\n\s*X\.)/)?.[0]
    ?.trim() ??
  'Informace o zpracování osobních údajů jsou součástí všeobecných obchodních podmínek.';
---

<Base
  title="Ochrana osobních údajů"
  description="Informace o zpracování osobních údajů Autoškoly BuBu s.r.o."
  noindex
>
  <section class="section">
    <div class="container content legal-document">
      <span class="eyebrow">Osobní údaje</span>
      <h1>Ochrana osobních údajů</h1>
      <div class="notice">
        Správcem osobních údajů je Autoškola BuBu s.r.o., IČ 214 441 61, se sídlem V Lukách 103,
        Statenice, 252 62 Statenice.
      </div>
      <pre>{gdprText}</pre>
      <p>
        Kompletní znění navazujících smluvních podmínek najdete na stránce
        <a href="/obchodni-podminky">Obchodní podmínky</a>.
      </p>
      <a class="text-link" href="/">Zpět na úvod</a>
    </div>
  </section>
</Base>

<style>
  .legal-document pre {
    white-space: pre-wrap;
    font: inherit;
    line-height: 1.7;
    color: var(--muted);
    background: transparent;
    border: 0;
    padding: 0;
    margin: 32px 0;
  }
</style>
