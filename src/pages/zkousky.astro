---
export const prerender = false;
import Base from '../layouts/Base.astro';
import { examFaq } from '../lib/exam-faq';

const examSteps = [
  {
    title: 'Výuka a výcvik dokončeny',
    summary: 'Máte odježděno. Teď přichází zkouška.',
    detail:
      'Právě jste dokončili výuku a výcvik a máte odježděné jízdy v rámci kurzu. Pokud si před zkouškou chcete přikoupit další jízdy, obraťte se na svého instruktora. Ten vám je objedná.',
    icon: 'car',
  },
  {
    title: 'Žádost o termín zkoušky',
    summary: 'O termín požádáme příslušný úřad.',
    detail:
      'Autoškola požádá příslušný úřad o termín závěrečné zkoušky. Konkrétní datum neurčujeme my; čekáme, až nám ho úřad přidělí.',
    icon: 'pencil',
  },
  {
    title: 'Přidělený termín',
    summary: 'Jakmile ho známe, dáme vám vědět.',
    detail:
      'Jakmile nám úřad termín oznámí, ihned vás informujeme o datu, čase a dalších důležitých pokynech. Termín si můžete zkontrolovat také v systému Moje Autoškola.',
    icon: 'calendar',
  },
  {
    title: 'Závěrečná zkouška',
    summary: 'Čeká vás teorie a praktická jízda.',
    detail:
      'Teoretický test na počítači probíhá na příslušném úřadě. Místo praktické zkoušky přiděluje úřad: může být u autoškoly nebo v okolí úřadu. Přesné místo a čas se dozvíte v SMS ke svému termínu.',
    icon: 'graduation',
  },
  {
    title: 'Výsledek a další krok',
    summary: 'Po zkoušce víte, jak jste dopadli.',
    detail:
      'Výsledek jednotlivých částí se dozvíte po jejich skončení. Pokud zkoušku úspěšně složíte, můžete požádat o vydání řidičského průkazu. Když některá část nevyjde, informace o opravném termínu najdete v častých otázkách níže.',
    icon: 'thumbs-up',
  },
];

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<Base
  title="Vše ke zkoušce na jednom místě"
  description="Informace pro studenty Autoškoly BuBu k závěrečným a opravným zkouškám."
  noindex
>
  <section class="exam-hero">
    <div class="exam-hero-shape exam-hero-shape-left" aria-hidden="true"></div>
    <div class="exam-hero-shape exam-hero-shape-right" aria-hidden="true"></div>
    <div class="container exam-hero-inner">
      <div class="exam-hero-copy">
        <span class="eyebrow">Pro studenty Autoškoly BuBu</span>
        <h1>Vše ke zkoušce<br />na jednom místě.</h1>
        <p class="lead">
          Výuka a výcvik jsou za vámi. Teď vás čeká závěrečná zkouška – a tady zjistíte, co se bude
          dít dál.
        </p>
        <a class="btn primary" href="#exam-process-title">Podívat se na další kroky ↗</a>
        <p class="exam-hero-hint">Termíny, průběh zkoušky i odpovědi na vaše otázky.</p>
      </div>
      <img class="exam-hero-bubak" src="/brand/bubak.webp" alt="" aria-hidden="true" />
      <p class="exam-hero-note" aria-hidden="true">V klidu až<br />ke zkoušce.</p>
    </div>
  </section>

  <section class="section exam-process" aria-labelledby="exam-process-title">
    <div class="container">
      <div class="exam-process-heading">
        <span class="eyebrow">Co vás teď čeká</span>
        <h2 id="exam-process-title">Jak to vypadá po dokončení výuky a výcviku?</h2>
        <p>Vyberte krok a podívejte se, co se v něm děje.</p>
      </div>
      <ol class="exam-steps" data-exam-progress="0">
        {
          examSteps.map((step, index) => (
            <li class:list={{ active: index === 0 }}>
              <button
                type="button"
                data-exam-step={index}
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-expanded={index === 0 ? 'true' : 'false'}
                aria-controls={`exam-step-detail-${index}`}
              >
                <span class="exam-step-top">
                  <img
                    src={`/icons/ui/blue-${step.icon}.webp`}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                  />
                  <span>0{index + 1}</span>
                </span>
                <strong>{step.title}</strong>
                <small>{step.summary}</small>
              </button>
            </li>
          ))
        }
      </ol>
      <div class="exam-step-details" aria-live="polite">
        {
          examSteps.map((step, index) => (
            <article
              id={`exam-step-detail-${index}`}
              data-exam-step-detail={index}
              hidden={index !== 0}
            >
              <span class="exam-detail-number">0{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
      <div class="exam-notice notice">
        Máte otázku k termínu nebo organizaci zkoušky? Neřešte ji prosím se svým instruktorem.
        Podívejte se do častých otázek níže, případně nám napište přes formulář.
      </div>
    </div>
  </section>

  <section class="section tinted exam-faq" aria-labelledby="exam-faq-title">
    <div class="container exam-narrow">
      <span class="eyebrow">Rychlé odpovědi</span>
      <h2 id="exam-faq-title">Co potřebujete vědět ke zkoušce?</h2>
      <label for="exam-search">Hledat v častých otázkách</label>
      <input
        id="exam-search"
        data-exam-search
        type="search"
        autocomplete="off"
        placeholder="Např. termín zkoušky, opravná zkouška, doklady…"
      />
      <div class="exam-chips" aria-label="Častá témata">
        {
          ['Termín zkoušky', 'Opravná zkouška', 'Co s sebou', 'Průběh zkoušky', 'Další jízda'].map(
            (topic) => (
              <button type="button" data-exam-chip={topic}>
                {topic}
              </button>
            ),
          )
        }
      </div>
      <p class="exam-count" data-exam-count role="status">Zobrazeno {examFaq.length} otázek</p>
      <div class="exam-list" data-exam-list>
        {
          examFaq.map((item) => (
            <details data-exam-id={item.id}>
              <summary aria-expanded="false">
                {item.question}
                <span aria-hidden="true">+</span>
              </summary>
              <p class="exam-answer">{item.answer}</p>
            </details>
          ))
        }
      </div>
      <div class="exam-empty" data-exam-empty hidden>
        <h3>Nenašli jsme odpověď na váš dotaz.</h3>
        <p>Pošlete nám ho prostřednictvím formuláře a ozveme se vám.</p>
        <a class="btn primary" href="#exam-form">Položit dotaz</a>
      </div>
    </div>
  </section>

  <section class="section exam-contact" id="exam-form" aria-labelledby="exam-contact-title">
    <div class="container exam-narrow">
      <span class="eyebrow">Jsme tu pro vás</span>
      <h2 id="exam-contact-title">Nenašli jste odpověď?</h2>
      <p class="lead">
        Pošlete nám svůj dotaz. Dotazy ke zkouškám řešíme centrálně, aby se k vám dostala správná
        informace co nejrychleji.
      </p>
      <form class="exam-form" data-exam-form>
        <div class="exam-fields">
          <label
            >Jméno *<input
              name="firstName"
              autocomplete="given-name"
              required
              maxlength="80"
            /></label
          >
          <label
            >Příjmení *<input
              name="lastName"
              autocomplete="family-name"
              required
              maxlength="80"
            /></label
          >
          <label
            >E-mail *<input
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
            /></label
          >
          <label
            >Telefon *<input
              name="phone"
              type="tel"
              autocomplete="tel"
              required
              maxlength="30"
            /></label
          >
          <label
            >Pobočka *
            <select name="branch" required>
              <option value="">Vyberte pobočku</option>
              <option value="strizkov">Praha – Střížkov</option>
              <option value="kladno">Kladno</option>
              <option value="statenice">Statenice</option>
            </select>
          </label>
        </div>
        <label
          >Váš dotaz *<textarea name="message" rows="6" required maxlength="2500"></textarea></label
        >
        <label class="exam-hp">Web<input name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="btn primary" type="submit">Odeslat dotaz</button>
        <p data-exam-form-error role="alert" hidden>
          Dotaz se nepodařilo odeslat. Zkuste to prosím znovu.
        </p>
      </form>
      <div class="exam-success" data-exam-success role="status" hidden>
        <h3>✓ Dotaz jsme přijali</h3>
        <p>Potvrzení jsme poslali také na váš e-mail. Jakmile dotaz zpracujeme, odpovíme vám.</p>
      </div>
    </div>
  </section>
  <script src="../scripts/exam-page.ts"></script>
</Base>

<style>
  .exam-hero {
    position: relative;
    overflow: hidden;
    background: var(--canvas);
  }
  .exam-hero::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: linear-gradient(90deg, transparent 45%, rgba(72, 190, 178, 0.12));
  }
  .exam-hero-inner {
    position: relative;
    z-index: 1;
    min-height: 450px;
    display: flex;
    align-items: center;
  }
  .exam-narrow {
    max-width: 900px;
  }
  .exam-hero-copy {
    position: relative;
    z-index: 3;
    max-width: 760px;
    padding: 4.5rem 0;
  }
  .exam-hero h1 {
    max-width: 760px;
  }
  .exam-hero .lead {
    margin: 1.5rem 0 1.8rem;
    max-width: 570px;
  }
  .exam-hero-hint {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .exam-hero-shape {
    position: absolute;
    bottom: -150px;
    border-radius: 48% 52% 0 0;
    background: #d9f3ef;
  }
  .exam-hero-shape-left {
    right: 22%;
    width: 380px;
    height: 350px;
    transform: rotate(-15deg);
  }
  .exam-hero-shape-right {
    right: -7%;
    width: 550px;
    height: 450px;
    transform: rotate(18deg);
  }
  .exam-hero-bubak {
    position: absolute;
    z-index: 2;
    right: 12%;
    bottom: 0;
    width: auto;
    height: 285px;
    object-fit: contain;
    transform: rotate(-4deg);
  }
  .exam-hero-note {
    position: absolute;
    z-index: 3;
    top: 80px;
    right: 3%;
    color: var(--teal);
    font-size: clamp(1.2rem, 2.2vw, 1.8rem);
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    transform: rotate(-8deg);
  }
  .exam-notice {
    margin-top: 1.8rem;
  }
  .exam-process-heading {
    max-width: 750px;
    margin-bottom: 2rem;
  }
  .exam-process-heading p {
    margin-top: 0.75rem;
  }
  .exam-steps {
    --progress: 0%;
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .exam-steps::before,
  .exam-steps::after {
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    border-radius: 3px;
    content: '';
  }
  .exam-steps::before {
    width: 100%;
    background: var(--line);
  }
  .exam-steps::after {
    width: var(--progress);
    background: linear-gradient(90deg, var(--brand), var(--blue));
    transition: width 400ms ease;
  }
  .exam-steps[data-exam-progress='1'] {
    --progress: 25%;
  }
  .exam-steps[data-exam-progress='2'] {
    --progress: 50%;
  }
  .exam-steps[data-exam-progress='3'] {
    --progress: 75%;
  }
  .exam-steps[data-exam-progress='4'] {
    --progress: 100%;
  }
  .exam-steps li {
    min-width: 0;
    padding-top: 18px;
  }
  .exam-steps button {
    width: 100%;
    height: 100%;
    padding: 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background 250ms ease,
      border-color 250ms ease,
      transform 250ms ease;
  }
  .exam-steps button:hover {
    transform: translateY(-3px);
    background: var(--brand-soft);
  }
  .exam-steps li.active button {
    border-color: #a5d9d1;
    background: var(--brand-soft);
    box-shadow: inset 0 3px 0 var(--brand);
  }
  .exam-step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--brand-dark);
    font-size: 0.8rem;
    font-weight: 750;
  }
  .exam-step-top img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .exam-steps strong,
  .exam-steps small {
    display: block;
  }
  .exam-steps strong {
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .exam-steps small {
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }
  .exam-step-details {
    margin-top: 1.5rem;
  }
  .exam-step-details article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.4rem;
    padding: 2rem;
    border: 1px solid #a5d9d1;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--brand-soft), white 74%);
  }
  .exam-step-details article[hidden] {
    display: none;
  }
  .exam-detail-number {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #21457f;
    color: white;
    font-weight: 800;
  }
  .exam-step-details h3 {
    font-size: clamp(1.25rem, 2vw, 1.55rem);
  }
  .exam-step-details p {
    max-width: 900px;
    margin-top: 0.55rem;
    line-height: 1.7;
  }
  .exam-faq h2 {
    margin-bottom: 1.5rem;
  }
  .exam-faq label {
    display: block;
    font-weight: 650;
    margin-bottom: 0.5rem;
  }
  .exam-faq input {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    background: white;
    color: var(--ink);
    font: inherit;
  }
  .exam-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 1rem 0;
  }
  .exam-chips button {
    min-height: 44px;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: white;
    color: var(--ink);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 650;
  }
  .exam-chips button[aria-pressed='true'] {
    background: var(--brand-dark);
    color: white;
    border-color: var(--brand-dark);
  }
  .exam-count {
    margin: 1rem 0;
    font-size: 0.9rem;
  }
  .exam-list {
    background: white;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .exam-list details + details {
    border-top: 1px solid var(--line);
  }
  .exam-list summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
    padding: 1rem 1.25rem;
    list-style: none;
    cursor: pointer;
    color: var(--ink);
    font-weight: 650;
  }
  .exam-list summary::-webkit-details-marker {
    display: none;
  }
  .exam-list summary span {
    color: var(--brand-dark);
    font-size: 1.3rem;
    line-height: 1;
  }
  .exam-list details[open] summary span {
    transform: rotate(45deg);
  }
  .exam-answer {
    padding: 0 1.25rem 1.25rem;
    white-space: pre-line;
  }
  .exam-empty {
    padding: 2rem;
    background: white;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .exam-empty p {
    margin: 0.75rem 0 1.25rem;
  }
  .exam-contact .lead {
    margin: 1rem 0 1.5rem;
  }
  .exam-form,
  .exam-success {
    background: white;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: clamp(1.2rem, 5vw, 2rem);
  }
  .exam-form {
    display: grid;
    gap: 1.1rem;
  }
  .exam-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }
  .exam-form label {
    display: grid;
    gap: 0.4rem;
    font-weight: 650;
  }
  .exam-form input,
  .exam-form select,
  .exam-form textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 0.85rem 1rem;
    background: white;
    color: var(--ink);
    font: inherit;
  }
  .exam-form textarea {
    resize: vertical;
  }
  .exam-form .exam-hp {
    position: absolute;
    left: -10000px;
  }
  .exam-form button {
    justify-self: start;
  }
  .exam-form [role='alert'] {
    color: var(--danger);
  }
  .exam-success {
    background: var(--brand-soft);
  }
  .exam-success h3 {
    color: var(--brand-dark);
    margin-bottom: 0.7rem;
  }
  @media (max-width: 1050px) {
    .exam-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .exam-steps::before,
    .exam-steps::after {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .exam-hero-inner {
      min-height: 380px;
    }
    .exam-hero-copy {
      max-width: 76%;
      padding: 3rem 0;
    }
    .exam-hero-bubak {
      right: 1%;
      height: 160px;
    }
    .exam-hero-note {
      display: none;
    }
    .exam-hero-shape-left {
      right: 1%;
    }
    .exam-hero-shape-right {
      right: -45%;
    }
    .exam-steps {
      grid-template-columns: 1fr;
    }
    .exam-steps li {
      padding-top: 0;
    }
    .exam-steps button {
      padding: 1rem 1.15rem;
    }
    .exam-step-top {
      margin-bottom: 0.35rem;
    }
    .exam-step-details article {
      grid-template-columns: 1fr;
      gap: 0.8rem;
      padding: 1.4rem;
    }
  }
  @media (max-width: 560px) {
    .exam-hero-copy {
      max-width: 100%;
      padding: 3rem 0;
    }
    .exam-hero-bubak {
      opacity: 0.22;
      right: -2%;
      height: 175px;
    }
    .exam-hero .lead {
      max-width: 27rem;
    }
    .exam-fields {
      grid-template-columns: 1fr;
    }
    .exam-form button {
      width: 100%;
    }
    .section {
      padding-block: 3rem;
    }
    .exam-list summary {
      padding-inline: 1rem;
    }
    .exam-answer {
      padding-inline: 1rem;
    }
  }
</style>
