---
import Base from '../../layouts/Base.astro';
import FinalCta from '../../components/FinalCta.astro';
import { getArticles, type ArticleEntry } from '../../lib/articles';
import manualCar from '../../assets/courses/b-manual-fabia.png';
export const prerender = true;
export async function getStaticPaths() {
  return getArticles().map((article) => ({ params: { slug: article.id }, props: { article } }));
}
interface Props {
  article: ArticleEntry;
}
const { article } = Astro.props;
const Content = article.Content;
const a = article.data;
const related = getArticles()
  .filter((item) => item.id !== article.id)
  .slice(0, 3);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: a.title,
  description: a.description,
  datePublished: a.publishedAt.toISOString(),
  dateModified: a.updatedAt.toISOString(),
  articleSection: a.category,
  inLanguage: 'cs-CZ',
  mainEntityOfPage: a.canonical,
  image: `https://www.autoskolabubu.cz${manualCar.src}`,
  author: { '@type': 'Organization', name: a.author },
  publisher: {
    '@type': 'Organization',
    name: 'Autoškola BuBu',
    url: 'https://www.autoskolabubu.cz',
  },
};
---

<Base title={a.title} description={a.description} schema={schema}>
  <article>
    <header class="article-hero">
      <div class="container article-hero-grid">
        <div>
          <nav class="breadcrumbs" aria-label="Drobečková navigace">
            <a href="/">Domů</a><span>/</span><a href="/blog">Blog</a><span>/</span><span
              >{a.category}</span>
          </nav>
          <span class="article-category">{a.category}</span><h1>{a.title}</h1><p
            class="article-perex"
          >
            {a.perex}
          </p>
          <p class="article-byline">
            <span>{a.author}</span><i aria-hidden="true">·</i><time
              datetime={a.publishedAt.toISOString()}
              >{a.publishedAt.toLocaleDateString('cs-CZ')}</time
            ><i aria-hidden="true">·</i>{a.readingTime ?? 5} min čtení
          </p>
        </div><figure class="article-cover">
          <img src={manualCar.src} alt="Výcvikový vůz Autoškoly BuBu" />
        </figure>
      </div>
    </header>
    <div class="section article-layout">
      <div class="container article-layout-grid">
        <aside class="article-aside" aria-label="Navigace článku">
          <p>V článku najdete</p><ul data-article-toc></ul><a href="#article-cta">Vybrat si kurz →</a>
        </aside>
        <div class="article-body content">
          {Content && <Content />}
          <section class="article-cta" id="article-cta">
            <span>Jste připravení začít?</span><h2>Řidičák bez zbytečného stresu.</h2><p>
              Vyberte si kurz a pobočku. Se zbytkem vám pomůžeme při zápisu.
            </p><a class="btn primary" href="/kurzy">Prohlédnout kurzy →</a>
          </section>
          <p class="source small">
            Text článku je převzat v původním znění z archivu Autoškoly BuBu.
          </p>
        </div>
      </div>
    </div>
  </article>
  {
    related.length > 0 && (
      <section class="section related-section">
        <div class="container">
          <>
            <div class="section-heading">
              <>
                <div>
                  <>
                    <span class="eyebrow">Pokračujte ve čtení</span>
                    <h2>Mohlo by vás zajímat</h2>
                  </>
                </div>
                <a class="text-link" href="/blog">
                  Všechny články →
                </a>
              </>
            </div>
            <div class="related-grid">
              {related.map((item) => (
                <a href={`/blog/${item.id}`}>
                  <span>{item.data.category}</span>
                  <strong>{item.data.title}</strong>
                  <small>{item.data.readingTime ?? 5} min čtení</small>
                </a>
              ))}
            </div>
          </>
        </div>
      </section>
    )
  }
  <FinalCta />
</Base>
<script>
  const content = document.querySelector('.article-body');
  const toc = document.querySelector('[data-article-toc]');
  if (content && toc) {
    const articleTitle = document.querySelector('h1')?.textContent?.trim();
    const headings = Array.from(content.querySelectorAll('h2')).filter((heading) => {
      const label = heading.textContent?.trim() ?? '';
      return label.length > 3 && label !== articleTitle && !/^\d+[.)]\s/.test(label);
    });
    headings.forEach((heading, index) => {
      const id = heading.id || `sekce-${index + 1}`;
      heading.id = id;
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = `#${id}`;
      link.textContent = heading.textContent;
      item.append(link);
      toc.append(item);
    });
    if (!toc.children.length) toc.closest('.article-aside')?.remove();
  }
</script>
<style>
  .article-hero {
    overflow: hidden;
    background: linear-gradient(135deg, #f7fbfb, #e0f5f1);
    border-bottom: 1px solid var(--line);
  }
  .article-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.7fr);
    align-items: center;
    gap: 55px;
    padding-bottom: 60px;
  }
  .article-category {
    display: inline-block;
    padding: 6px 11px;
    border-radius: 999px;
    background: #fff;
    color: var(--brand-dark);
    font-size: 0.69rem;
    font-weight: 750;
    margin-bottom: 16px;
  }
  .article-hero h1 {
    font-size: clamp(2.15rem, 4.1vw, 4rem);
    max-width: 820px;
  }
  .article-perex {
    margin-top: 20px;
    max-width: 720px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .article-byline {
    margin-top: 22px;
    font-size: 0.76rem;
    color: var(--muted);
  }
  .article-byline span {
    font-weight: 750;
    color: var(--ink);
  }
  .article-byline i {
    font-style: normal;
    margin: 0 7px;
  }
  .article-cover {
    margin: 0;
    min-height: 280px;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 20px 44px #17335f24;
  }
  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-layout {
    padding-top: 62px;
  }
  .article-layout-grid {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px);
    gap: 65px;
    justify-content: center;
  }
  .article-aside {
    position: sticky;
    top: 22px;
    align-self: start;
    background: #f3faf8;
    border: 1px solid #d7ebe6;
    border-radius: 14px;
    padding: 19px;
    font-size: 0.74rem;
  }
  .article-aside > p {
    color: var(--ink);
    font-weight: 800;
    margin-bottom: 10px;
  }
  .article-aside ul {
    display: grid;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .article-aside li {
    margin: 0;
  }
  .article-aside ul a {
    display: block;
    padding: 6px 0;
    color: var(--brand-dark);
    font-weight: 650;
    line-height: 1.35;
    text-decoration: none !important;
  }
  .article-aside ul a:hover {
    color: var(--brand);
  }
  .article-aside > a {
    color: var(--brand-dark);
    text-decoration: none !important;
  }
  .article-aside > a {
    display: block;
    border-top: 1px solid #cae7e0;
    padding-top: 13px;
    margin-top: 15px;
    font-weight: 750;
  }
  .article-body :global(h2) {
    color: var(--ink);
    font-size: clamp(1.45rem, 2.2vw, 2rem);
    margin-top: 45px;
    scroll-margin-top: 24px;
  }
  .article-body :global(h3) {
    color: var(--ink);
    font-size: 1.22rem;
    margin-top: 30px;
  }
  .article-body :global(p),
  .article-body :global(li) {
    font-size: 0.98rem;
    line-height: 1.78;
  }
  .article-body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 26px 0 32px;
    border: 1px solid #cce6e1;
    border-radius: 12px;
    background: white;
    box-shadow: 0 8px 24px #17335f0a;
    font-size: 0.85rem;
  }
  .article-body :global(th),
  .article-body :global(td) {
    border-bottom: 1px solid #dcebe8;
    padding: 12px 14px;
    text-align: left;
    line-height: 1.48;
  }
  .article-body :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .article-body :global(tbody tr:nth-child(even)) {
    background: #f5fbfa;
  }
  .article-body :global(th) {
    background: var(--brand-dark);
    color: white;
    border-bottom: 0;
    font-weight: 750;
  }
  .article-cta {
    margin-top: 48px;
    padding: 30px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--brand-dark), #1c9184);
    color: white;
  }
  .article-cta span {
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #bdf5ed;
  }
  .article-cta h2 {
    color: white !important;
    margin: 8px 0 !important;
  }
  .article-cta p {
    color: white !important;
    max-width: 580px;
    margin-bottom: 20px;
  }
  .article-cta .btn {
    background: white;
    color: var(--brand-dark);
  }
  .source {
    margin-top: 30px !important;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .related-section {
    background: var(--canvas);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .related-grid a {
    padding: 22px;
    border-radius: 14px;
    background: white;
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      transform var(--ease),
      box-shadow var(--ease);
  }
  .related-grid a:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .related-grid span,
  .related-grid small {
    display: block;
    color: var(--brand-dark);
    font-size: 0.68rem;
    font-weight: 750;
  }
  .related-grid strong {
    display: block;
    font-size: 1rem;
    line-height: 1.32;
    margin: 9px 0 16px;
  }
  .related-grid small {
    color: var(--muted);
    font-weight: 550;
  }
  @media (max-width: 850px) {
    .article-hero-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .article-cover {
      max-height: 310px;
    }
    .article-layout-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .article-aside {
      position: static;
    }
    .article-aside ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 20px;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .article-aside ul {
      grid-template-columns: 1fr;
    }
    .article-body :global(table) {
      font-size: 0.79rem;
    }
    .article-body :global(th),
    .article-body :global(td) {
      min-width: 130px;
      padding: 10px 11px;
    }
  }
</style>
