---
export const prerender = true;
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FinalCta from '../../components/FinalCta.astro';
const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<Base
  title="Blog – rady na cestu k řidičáku"
  description="První jízda, nejistota za volantem i příprava ke zkoušce. Přečtěte si články Autoškoly BuBu."
  ><section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Drobečková navigace">
        <a href="/">Domů</a><span>/</span><span>Blog</span>
      </nav><span class="eyebrow">Čtení před první jízdou</span><h1>
        O řidičáku.<br />Bez zbytečných otázek.
      </h1><p class="lead">Rady z autoškoly pro chvíle, kdy chcete vědět trochu víc.</p>
    </div>
  </section><section class="section">
    <div class="container">
      <div class="grid">
        {
          articles.map((article) => (
            <article class="card">
              <>
                <span class="eyebrow">{article.data.category}</span>
                <h2 class="article-title">
                  <a href={`/blog/${article.id}`}>{article.data.title}</a>
                </h2>
                <p>{article.data.description}</p>
                <p class="small">
                  {article.data.author} ·{' '}
                  <time datetime={article.data.publishedAt.toISOString()}>
                    {article.data.publishedAt.toLocaleDateString('cs-CZ')}
                  </time>
                </p>
                <a class="text-link" href={`/blog/${article.id}`}>
                  Přečíst článek ↗
                </a>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section><FinalCta /></Base
><style>
  .article-title {
    font-size: 1.4rem;
    line-height: 1.3;
  }
  .article-title a {
    text-decoration: none;
  }
</style>
