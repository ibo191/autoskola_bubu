---
export const prerender = true;
import Base from '../layouts/Base.astro';
import FinalCta from '../components/FinalCta.astro';
import {
  branches,
  courses,
  fees,
  money,
  priceSource,
  examAuthorities,
  prices,
} from '../lib/catalog';

const priceRows = [
  { name: 'Skupina B', variant: 'manuál', price: [25900, 20000, 25900], slug: 'ridicak-skupina-b' },
  {
    name: 'Skupina BA',
    variant: 'automat · kód 78',
    price: [25900, null, null],
    slug: 'ridicak-skupina-b-automat',
  },
  { name: 'L17', variant: 'manuál', price: [25900, 20000, 25900], slug: 'l17' },
  { name: 'BA-L17', variant: 'automat · kód 78', price: [25900, null, null], slug: 'l17' },
  ...(['AM', 'A2', 'A'] as const).flatMap((group) => [
    {
      name: `Skupina ${group}`,
      variant: 'Moto Základ',
      price: [prices.motoBasic, null, null],
      slug: `ridicak-skupina-${group.toLowerCase()}`,
    },
    {
      name: `Skupina ${group}`,
      variant: 'Moto Jistota',
      price: [prices.motoConfidence, null, null],
      slug: `ridicak-skupina-${group.toLowerCase()}`,
    },
  ]),
  {
    name: 'Skupina A1',
    variant: 'Moto Jistota',
    price: [prices.motoConfidence, null, null],
    slug: 'ridicak-skupina-a1',
  },
  {
    name: 'Rozšíření A2 / A',
    variant: 'doplňovací zkouška při splnění podmínek',
    price: [prices.supplement, null, null],
    slug: 'ridicak-skupina-a2',
  },
  { name: 'Rozšíření B96', variant: 'přívěs', price: [prices.b96, null, null], slug: 'b96' },
  { name: 'Skupina B+E', variant: 'přívěs', price: [prices.be, null, null], slug: 'be' },
  {
    name: 'Kondiční jízdy',
    variant: 'manuál · 90 minut',
    price: [1600, 1600, 1600],
    slug: 'kondicni-jizdy',
  },
  {
    name: 'Kondiční jízdy',
    variant: 'automat · 90 minut',
    price: [1600, null, null],
    slug: 'kondicni-jizdy',
  },
] as const;
---

<Base
  title="Ceník autoškoly 2026 | Praha 8, Kladno, Statenice"
  description="Aktuální ceník Autoškoly BuBu pro řidičák skupiny B, L17, motorky, přívěsy a kondiční jízdy v Praze 8, Kladně a Statenicích."
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Drobečková navigace">
        <a href="/">Domů</a><span>/</span><span>Ceník</span>
      </nav>
      <span class="eyebrow">Jasný výběr. Jasná cena.</span><h1>
        Vyberte si kurz.<br />Cenu víte hned.
      </h1>
      <p class="lead">
        Stačí pár odpovědí a ukážeme vám kurz, který odpovídá tomu, co chcete řídit, kde chcete
        jezdit a jakou variantu výcviku preferujete.
      </p>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="decision-header">
        <span class="eyebrow">Průvodce ceníkem</span><h2>Pojďme najít správný kurz.</h2><p>
          Odpovězte na pár otázek a hned uvidíte cenu kurzu pro vás.
        </p>
      </div>

      <div class="decision-card" id="pricing-wizard">
        <div class="wizard-progress">
          <div>
            <span id="wizard-step-label">Krok 1</span><button
              type="button"
              id="wizard-restart"
              class="text-link">Začít znovu</button
            >
          </div><div
            class="progress-track"
            role="progressbar"
            aria-label="Postup výběru kurzu"
            aria-valuemin="1"
            aria-valuemax="5"
            aria-valuenow="1"
          >
            <span id="wizard-progress-fill"></span>
          </div><nav id="wizard-path" aria-label="Upravit výběr"></nav>
        </div>
        <fieldset class="question">
          <legend><span>01</span> Co chcete řídit?</legend><div
            class="choice-grid category-choices"
          >
            <button type="button" data-category="auto" aria-pressed="false"
              ><img src="/icons/ui/blue-car.webp" alt="" width="192" height="192" /><span
                ><strong>Auto / L17</strong><small
                  >Řidičák skupiny B, včetně možnosti od 17 let.</small
                ></span
              ></button
            >
            <button type="button" data-category="moto" aria-pressed="false"
              ><img src="/icons/ui/blue-motorcycle.webp" alt="" width="192" height="192" /><span
                ><strong>Motorku</strong><small>Vyberte skupinu podle věku a oprávnění.</small
                ></span
              ></button
            >
            <button type="button" data-category="prives" aria-pressed="false"
              ><img
                src="/icons/ui/trailer-blue.jpeg"
                alt=""
                width="192"
                height="192"
                class="trailer-blue"
              /><img
                src="/icons/ui/trailer-mint.jpeg"
                alt=""
                width="192"
                height="192"
                class="trailer-mint"
              />Auto s přívěsem <small>B96 nebo B+E podle toho, co potřebujete táhnout.</small
              ></button
            >
            <button type="button" data-category="kondicni" aria-pressed="false">
              <img src="/icons/ui/blue-hands-wheel.webp" alt="" width="192" height="192" />
              <span
                ><strong>Kondiční jízdy</strong><small
                  >Řidičák už máte. Teď zpátky za volant s jistotou.</small
                ></span
              >
            </button>
          </div>
        </fieldset>

        <fieldset class="question next-question" id="branch-question" hidden>
          <legend><span>02</span> Kde chcete kurz absolvovat?</legend><div
            class="choice-grid compact"
          >
            {
              branches.map((item) => (
                <button
                  type="button"
                  data-branch={item.id}
                  data-b-price={item.bPrice}
                  aria-pressed="false"
                >
                  {item.name}
                  <small>{item.locality}</small>
                </button>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="question next-question" id="transmission-question" hidden>
          <legend><span>03</span> Jak chcete jezdit?</legend><div class="choice-grid compact">
            <button type="button" data-transmission="manual" aria-pressed="false">Manuál</button>
            <button type="button" data-transmission="automatic" aria-pressed="false"
              >Automat<small>pouze Střížkov</small></button
            >
          </div><p class="question-note">
            Vyberte převodovku, se kterou chcete absolvovat výcvik.
          </p><p class="question-note" id="transmission-note"></p>
        </fieldset>

        <fieldset class="question next-question" id="driving-blocks-question" hidden>
          <legend><span>04</span> Kolik času chcete za volantem?</legend>
          <p class="question-note">
            Dopřejte si čas na návrat do provozu. Jeden 90minutový blok stojí 1 600 Kč (2 × 45 minut
            za 800 Kč).
          </p>
          <label
            >Počet 90minutových bloků
            <select id="pricing-driving-blocks">
              <option value="0">Vyberte počet jízd</option>
              {
                Array.from({ length: 20 }, (_, i) => i + 1).map((n) => (
                  <option value={n}>
                    {n} × 90 minut · {(n * 1600).toLocaleString('cs-CZ')} Kč
                  </option>
                ))
              }
            </select>
          </label>
        </fieldset>
        <fieldset class="question next-question offer-picker" id="mode-question" hidden>
          <legend>Chcete začít už v 17 letech?</legend><p class="picker-intro">
            S L17 můžete získat řidičák skupiny B už v 17 letech a do osmnácti jezdit se zapsaným
            mentorem.
          </p><div class="choice-grid compact marketing-choices">
            <button type="button" data-mode="standard" aria-pressed="false">
              <span class="choice-kicker">Klasická cesta</span><strong>Kurz skupiny B</strong><span
                class="choice-copy">Kompletní výuka a výcvik pro získání řidičáku na auto.</span
              ><span class="choice-price" data-auto-card-price></span><small
                >* bez poplatků za zkoušku</small
              >
            </button>
            <button type="button" data-mode="l17" aria-pressed="false">
              <span class="choice-kicker">Řidičák od 17 let</span><strong>Kurz L17</strong><span
                class="choice-copy">Po zkoušce jezdíte do 18 let bezpečně s mentorem.</span
              ><span class="choice-price" data-auto-card-price></span><small
                >* bez poplatků za zkoušku</small
              >
            </button>
          </div>
        </fieldset>

        <fieldset class="question next-question" id="moto-target-question" hidden>
          <legend><span>03</span> Jakou skupinu chcete?</legend><div class="choice-grid four">
            {
              (['am', 'a1', 'a2', 'a'] as const).map((id) => (
                <button type="button" data-moto-target={id} aria-pressed="false">
                  {id.toUpperCase()}
                </button>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="question next-question" id="licence-status-question" hidden>
          <legend><span>04</span> Máte už nějaký řidičák?</legend><p class="question-note">
            Podle vašeho současného oprávnění vám ukážeme správnou variantu kurzu a cenu.
          </p><div class="choice-grid compact">
            <button type="button" data-licence-status="none" aria-pressed="false"
              >Nemám žádné</button
            >
            <button type="button" data-licence-status="yes" aria-pressed="false">Ano, mám</button>
          </div>
        </fieldset>

        <fieldset class="question next-question" id="licences-question" hidden>
          <legend><span>05</span> Označte všechny skupiny, které držíte</legend><div
            class="check-grid"
          >
            {
              ['B', 'AM', 'A1', 'A2', 'A'].map((licence) => (
                <label>
                  <>
                    <input type="checkbox" name="held-licence" value={licence} />
                    <span>{licence}</span>
                  </>
                </label>
              ))
            }
            <label
              ><input type="checkbox" name="held-licence" value="other" /><span>Jiná skupina</span
              ></label
            >
          </div><p class="question-note">Můžete označit více oprávnění současně.</p>
        </fieldset>

        <fieldset class="question next-question" id="period-question" hidden>
          <legend><span>06</span> Jak dlouho držíte rozhodující moto skupinu?</legend><div
            class="choice-grid compact"
          >
            <button type="button" data-period="less-than-two" aria-pressed="false"
              >2 roky nebo méně</button
            >
            <button type="button" data-period="more-than-two" aria-pressed="false"
              >Déle než 2 roky</button
            >
          </div>
        </fieldset>

        <fieldset class="question next-question offer-picker" id="package-question" hidden>
          <legend>Vyberte si moto balíček</legend><p class="picker-intro">
            Obě varianty vás připraví na zkoušku. Jistota přidává více času pro klidnější výcvik.
          </p><div class="choice-grid compact marketing-choices package-choices">
            <button
              type="button"
              class="recommended-choice"
              data-package="moto-confidence"
              aria-pressed="false"
            >
              <span class="recommendation">Doporučujeme</span><span class="choice-kicker"
                >Více prostoru na jistotu</span
              ><strong>Moto Jistota</strong><span class="choice-copy"
                >20 hodin jízd pro důkladnější nácvik a větší klid před zkouškou.</span
              ><span class="choice-price">31 900 Kč*</span><small>* bez poplatků za zkoušku</small>
            </button>
            <button type="button" data-package="moto-basic" aria-pressed="false">
              <span class="choice-kicker">Úspornější rozsah</span><strong>Moto Základ</strong><span
                class="choice-copy">13 hodin jízd pro žadatele, kteří potřebují kratší výcvik.</span
              ><span class="choice-price">24 900 Kč*</span><small>* bez poplatků za zkoušku</small>
            </button>
          </div>
        </fieldset>

        <fieldset class="question next-question" id="trailer-question" hidden>
          <legend><span>03</span> Jaké oprávnění potřebujete?</legend><div
            class="choice-grid compact"
          >
            <button type="button" data-trailer="b96" aria-pressed="false"
              ><img
                src="/icons/ui/trailer-blue.jpeg"
                alt=""
                width="192"
                height="192"
                class="trailer-blue"
              /><img
                src="/icons/ui/trailer-mint.jpeg"
                alt=""
                width="192"
                height="192"
                class="trailer-mint"
              />Rozšíření B96</button
            >
            <button type="button" data-trailer="be" aria-pressed="false"
              ><img
                src="/icons/ui/trailer-blue.jpeg"
                alt=""
                width="192"
                height="192"
                class="trailer-blue"
              /><img
                src="/icons/ui/trailer-mint.jpeg"
                alt=""
                width="192"
                height="192"
                class="trailer-mint"
              />Skupina B+E</button
            >
          </div>
        </fieldset>
        <div class="wizard-navigation">
          <button type="button" id="wizard-back" class="text-link" hidden>← Zpět</button><button
            type="button"
            id="wizard-licences-next"
            class="btn secondary"
            hidden>Potvrdit oprávnění →</button
          >
        </div>
        <section
          id="pricing-results"
          class="pricing-results"
          hidden
          aria-labelledby="result-title"
          aria-live="polite"
        >
          <div id="result-loading" class="result-loading" role="status" aria-live="polite" hidden>
            <span class="eyebrow">Váš kurz</span>
            <h2>Načítáme vaši cenu…</h2>
            <p>Vybranou variantu právě ověřujeme v aktuálním ceníku.</p>
          </div>
          <div class="result-heading" hidden>
            <div>
              <span class="eyebrow">Váš kurz</span><h2 id="result-title">
                Tohle je varianta pro vás.
              </h2>
            </div><button type="button" class="text-link reset-selection">Začít znovu</button>
          </div>
          <article class="offer-card" hidden>
            <div>
              <span class="eyebrow" id="offer-label"></span><h3 id="offer-title"></h3><p
                id="offer-description"
              >
              </p><p id="offer-summary"></p><p>Podle vašeho výběru vám doporučujeme:</p><p
                class="offer-variant"
                id="offer-variant"
              >
              </p>
            </div>
            <div class="offer-price">
              <strong id="offer-price"></strong><span id="offer-price-asterisk">*</span><small
                id="offer-price-note"
                >Cena odpovídá zvolené pobočce a variantě kurzu. * Nezahrnuje poplatky za zkoušku.</small
              >
            </div>
            <div class="offer-actions">
              <button class="btn primary" data-order disabled>Chci se přihlásit ↗</button><a
                id="moto-interest-link"
                class="btn primary"
                href="/motorky-2027"
                hidden>Odeslat předběžný zájem ↗</a
              ><a id="offer-detail" class="text-link" href="/cenik">Podrobnosti o kurzu</a>
            </div>
          </article>
        </section>

        <section id="contact-result" class="contact-result notice" hidden aria-live="polite">
          <h2>Výběr potřebujeme ověřit osobně.</h2><p id="contact-message"></p><a
            class="btn secondary"
            href="/kontakt">Kontaktovat Střížkov</a
          >
        </section>
      </div>

      <section class="price-list" aria-labelledby="price-list-title" data-reveal>
        <div class="price-list-heading">
          <span class="eyebrow">Všechny ceny pohromadě</span>
          <h2 id="price-list-title">Přehledný ceník kurzů</h2>
          <p>Chcete ceny raději porovnat najednou? Tady jsou aktuální varianty podle pobočky.</p>
        </div>
        <div
          class="price-table-wrap"
          tabindex="0"
          role="region"
          aria-label="Tabulka cen kurzů podle pobočky"
        >
          <table>
            <thead
              ><tr
                ><th scope="col">Kurz</th><th scope="col">Střížkov</th><th scope="col">Kladno</th
                ><th scope="col">Statenice</th></tr
              ></thead
            >
            <tbody>
              {
                priceRows.map((row) => (
                  <tr>
                    <th scope="row">
                      <>
                        <a href={`/kurzy/${row.slug}`}>{row.name}</a>
                        <small>{row.variant}</small>
                      </>
                    </th>
                    {row.price.map((amount) => (
                      <td>
                        {amount === null ? (
                          <span class="unavailable" aria-label="Není dostupné">
                            —
                          </span>
                        ) : (
                          money(amount)
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="price-table-note">
          Motocyklové kurzy: nyní sbíráme pouze předběžný zájem na sezonu 2027. Cena varianty závisí
          na vašem dosavadním oprávnění. Částky nezahrnují samostatné poplatky za zkoušku.
        </p>
      </section>
      <aside class="fees" data-reveal>
        <div class="section-heading">
          <div>
            <span class="eyebrow">Mimo cenu kurzu</span><h2>S čím ještě počítat?</h2><p>
              Ať víte předem, kolik vás celý proces bude stát. Tyto poplatky nejsou součástí ceny
              kurzu a hradí se samostatně.
            </p>
          </div>
        </div>
        <div class="fee-grid">
          <article>
            <img
              src="/icons/ui/blue-settings.webp"
              alt=""
              width="192"
              height="192"
              loading="lazy"
            /><h3>Autoškole za organizaci první zkoušky</h3><strong
              >{money(fees.schoolOrganization)}</strong
            ><p>Poplatek za administrativu a zajištění prvního termínu závěrečné zkoušky.</p>
          </article>
          <article class="authority-fees">
            <img
              src="/icons/ui/blue-classroom-outline.webp"
              alt=""
              width="192"
              height="192"
              loading="lazy"
            /><h3>Úřadu za první zkoušku</h3><p>
              Správní poplatek hrazený úřadu při první závěrečné zkoušce.
            </p>{
              examAuthorities.map((item) => (
                <p>
                  <>
                    <span>{item.office}</span>
                    <strong>{money(item.firstExam)}</strong>
                  </>
                </p>
              ))
            }
          </article>
          <article>
            <img
              src="/icons/ui/blue-warning.webp"
              alt=""
              width="192"
              height="192"
              loading="lazy"
            /><h3>Autoškole za opakovanou zkoušku</h3><strong>{money(fees.schoolRepeatExam)}</strong
            ><p>
              Za každý opakovaný termín zkoušky se autoškole hradí tento poplatek. K tomu se hradí i
              příslušný úřední poplatek podle opakované části zkoušky.
            </p><p>Test z předpisů <strong>100 Kč</strong></p><p>
              Ovládání a údržba <strong>200 Kč</strong>
            </p><p>Praktická jízda <strong>400 Kč</strong></p>
          </article>
        </div><p class="small source-note">
          Úřední poplatky jsou jednotné podle platného sazebníku. Zdroj: <a
            href="https://portal.gov.cz/sluzby-vs/zkouska-k-ziskani-ridicskeho-opravneni-S47728"
            >Portál veřejné správy</a
          >. Ceny kurzů: <a href={priceSource.url}>aktuální ceník Autoškoly BuBu</a>, ověřeno 28. 8.
          2026.
        </p>
        <div class="payment-note">
          <strong>Platba kurzu</strong><p>
            Kurzovné můžete uhradit v hotovosti při zápisu nebo bankovním převodem na účet autoškoly
            do 5 dnů od zápisu. Autoškola umožňuje také platbu na splátky podle svých podmínek.
          </p><p>
            Ve třech splátkách přibližně po třetinách: první při zápisu nebo do 5 dnů, druhá v
            průběhu kurzu a třetí nejpozději při poslední jízdě nebo před přihlášením na závěrečnou
            zkoušku. Pokud není kurzovné uhrazené podle sjednaných podmínek, student nebude
            přihlášen k závěrečné zkoušce.
          </p>
        </div>
      </aside>
    </div>
  </section>
  <FinalCta />
</Base>

<script
  is:inline
  type="application/json"
  id="course-catalog"
  set:html={JSON.stringify(courses).replace(/</g, '\u003c')}
/>
<script>
  import '../scripts/pricing-wizard';
</script>

<style>
  .page-hero .container {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .page-hero .lead {
    max-width: 690px;
  }
  .decision-header {
    max-width: 760px;
    margin: 0 auto 30px;
    text-align: center;
  }
  .decision-header p {
    margin-top: 14px;
  }
  .decision-card {
    display: grid;
    gap: 18px;
    max-width: 900px;
    margin-inline: auto;
    padding: clamp(16px, 3vw, 30px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow);
  }
  .wizard-progress > div:first-child {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    color: var(--ink);
    font-weight: 700;
  }
  .progress-track {
    height: 7px;
    margin: 12px 0;
    overflow: hidden;
    border-radius: 99px;
    background: #e4eef3;
  }
  .progress-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--brand);
    transition: width 180ms ease;
  }
  #wizard-path {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  :global(#wizard-path button) {
    padding: 8px 13px;
    border: 1px solid #bad9d5;
    border-radius: 99px;
    background: #eff8f6;
    color: var(--blue);
    cursor: pointer;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 650;
    line-height: 1.2;
  }
  :global(#wizard-path button:hover),
  :global(#wizard-path button:focus-visible) {
