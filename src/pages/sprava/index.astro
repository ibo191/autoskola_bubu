---
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
import Base from '../../layouts/Base.astro';
import { branches, courses, money } from '../../lib/catalog';
import { requireLiveRepository } from '../../lib/server/live-order';

const repositoryReady = Boolean(process.env.SUPABASE_URL && process.env.SUPABASE_SERVICE_ROLE_KEY);
const repository = repositoryReady ? requireLiveRepository(process.env) : null;
const url = new URL(Astro.request.url);
const today = new Date().toISOString().slice(0, 10);
const from = url.searchParams.get('from') ?? today;
const to =
  url.searchParams.get('to') ?? new Date(Date.now() + 31 * 86400000).toISOString().slice(0, 10);
const course = url.searchParams.get('course') || '';
const branch = url.searchParams.get('branch') || '';
const status = url.searchParams.get('status') || '';
const query = url.searchParams.get('q') || '';
const appointmentDate = url.searchParams.get('appointmentDate') || today;
const rawAppointmentMonth = url.searchParams.get('appointmentMonth') || appointmentDate.slice(0, 7);
const appointmentMonth = /^\d{4}-\d{2}$/.test(rawAppointmentMonth)
  ? rawAppointmentMonth
  : today.slice(0, 7);
const appointmentBranch = url.searchParams.get('appointmentBranch') || branch || '';
const calendarParts = appointmentMonth.split('-').map(Number);
const calendarYear = calendarParts[0] ?? Number(today.slice(0, 4));
const calendarMonth = calendarParts[1] ?? Number(today.slice(5, 7));
const daysInMonth = new Date(calendarYear, calendarMonth, 0).getDate();
const firstDayOffset = (new Date(calendarYear, calendarMonth - 1, 1).getDay() + 6) % 7;
const adminCookie = Astro.cookies.get('bubu_admin_session')?.value ?? '';
let loginFailed = false;
let currentUser: { email: string; name: string } | null = null;
let configError = !repositoryReady;

function cookieOptions() {
  return {
    httpOnly: true,
    secure: Astro.url.protocol === 'https:',
    sameSite: 'strict' as const,
    path: '/sprava',
    maxAge: 60 * 60 * 8,
  };
}

if (repository && adminCookie) {
  const session = await repository.adminSession(adminCookie).catch(() => ({ ok: false as const }));
  if (session.ok) currentUser = session.user;
}

if (repository && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'login');
  if (intent === 'logout') {
    if (adminCookie) await repository.adminLogout(adminCookie).catch(() => null);
    Astro.cookies.delete('bubu_admin_session', { path: '/sprava' });
    return Astro.redirect('/sprava', 303);
  }
  const email = String(form.get('email') ?? '');
  const password = String(form.get('password') ?? '');
  const login = await repository
    .adminLogin({ email, password })
    .catch(() => ({ ok: false as const }));
  if (login.ok) {
    currentUser = login.user;
    Astro.cookies.set('bubu_admin_session', login.token, cookieOptions());
    return Astro.redirect('/sprava', 303);
  }
  loginFailed = true;
}

const summary =
  repository && currentUser
    ? await repository.adminSummary({
        from: `${from}T00:00:00.000Z`,
        to: `${to}T23:59:59.999Z`,
        course: course || null,
      })
    : null;
const orders =
  repository && currentUser
    ? await repository.adminOrders({
        from: `${from}T00:00:00.000Z`,
        to: `${to}T23:59:59.999Z`,
        course: course || null,
        branch: branch || null,
        status: status || null,
        query: query || null,
        limit: 250,
      })
    : [];
const appointments =
  repository && currentUser
    ? await repository.adminAppointments({
        date: appointmentDate,
        branch: appointmentBranch || null,
      })
    : [];
const nextAppointmentDay =
  repository && currentUser
    ? await repository.adminNextAppointmentDay({ from: today, branch: appointmentBranch || null })
    : null;
const calendarDates = Array.from({ length: daysInMonth }, (_, index) => {
  const day = index + 1;
  const date = `${appointmentMonth}-${String(day).padStart(2, '0')}`;
  return { day, date };
});
const appointmentDays =
  repository && currentUser
    ? (
        await Promise.all(
          calendarDates.map(async (item) => ({
            ...item,
            count: (
              await repository.adminAppointments({
                date: item.date,
                branch: appointmentBranch || null,
              })
            ).length,
          })),
        )
      ).filter((item) => item.count > 0)
    : [];
const appointmentDayMap = new Map(appointmentDays.map((item) => [item.date, item.count]));

const courseLabel = (id: string) => courses.find((item) => item.id === id)?.label ?? id;
const branchLabel = (id: string) => branches.find((item) => item.id === id)?.name ?? id;
const packageLabel = (id: string) =>
  ({
    single: 'Samostatný kurz',
    'moto-basic': 'Moto základ',
    'moto-confidence': 'Moto Jistota',
    supplement: 'Doplňovací zkouška',
  })[id] ?? id;
const statusLabel = (value: string) =>
  ({
    provisional: 'Rozpracované',
    confirmed: 'Potvrzené',
    rescheduled: 'Přeplánované',
    cancelled: 'Zrušené',
    attended: 'Dorazil/a',
    no_show: 'Nedorazil/a',
    enrolled: 'Zařazen/a do kurzu',
    expired: 'Expirované',
  })[value] ?? value;
const formatDateTime = (value: string) =>
  new Intl.DateTimeFormat('cs-CZ', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Europe/Prague',
  }).format(new Date(value));
const formatTime = (value: string) =>
  new Intl.DateTimeFormat('cs-CZ', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Prague',
  }).format(new Date(value));
const statuses = [
  'confirmed',
  'rescheduled',
  'cancelled',
  'enrolled',
  'attended',
  'no_show',
  'expired',
  'provisional',
];
const buildAdminUrl = (updates: Record<string, string>) => {
  const params = new URLSearchParams();
  const current = {
    from,
    to,
    branch,
    course,
    status,
    q: query,
    appointmentDate,
    appointmentMonth,
    appointmentBranch,
    ...updates,
  };
  Object.entries(current).forEach(([key, value]) => {
    if (value) params.set(key, value);
  });
  return `/sprava?${params.toString()}`;
};
const calendarDays = calendarDates.map((item) => ({
  ...item,
  count: appointmentDayMap.get(item.date) ?? 0,
}));
---

<Base title="Interní správa" description="Interní správa Autoškoly BuBu." noindex>
  <section class="section admin-section">
    <div class="container content">
      <div class="admin-topline">
        <div>
          <span class="eyebrow">Interní část</span><h1>Správa Autoškoly BuBu</h1>
        </div>
        {
          currentUser && (
            <form method="post">
              <input type="hidden" name="intent" value="logout" />
              <span class="admin-user">{currentUser.name}</span>
              <button class="btn secondary" type="submit">
                Odhlásit
              </button>
            </form>
          )
        }
      </div>

      {
        configError ? (
          <div class="notice">Pro zobrazení správy nastavte Supabase proměnné na Vercelu.</div>
        ) : !currentUser ? (
          <form class="admin-login" method="post">
            <input type="hidden" name="intent" value="login" />
            {loginFailed && <div class="error">Neplatný e-mail nebo heslo.</div>}
            <label>
              E-mail
              <input name="email" type="email" autocomplete="username" required />
            </label>
            <label>
              Heslo
              <input name="password" type="password" autocomplete="current-password" required />
            </label>
            <button class="btn primary" type="submit">
              Přihlásit se
            </button>
          </form>
        ) : (
          <>
            <section class="admin-panel">
              <h2>Přehled</h2>
              <form class="admin-filters" method="get">
                <label>
                  Od
                  <input type="date" name="from" value={from} />
                </label>
                <label>
                  Do
                  <input type="date" name="to" value={to} />
                </label>
                <label>
                  Pobočka
                  <select name="branch">
                    <option value="">Všechny pobočky</option>
                    {branches.map((item) => (
                      <option value={item.id} selected={branch === item.id}>
                        {item.name}
                      </option>
                    ))}
                  </select>
                </label>
                <label>
                  Skupina
                  <select name="course">
                    <option value="">Všechny skupiny</option>
                    {courses.map((item) => (
                      <option value={item.id} selected={course === item.id}>
                        {item.label}
                      </option>
                    ))}
                  </select>
                </label>
                <label>
                  Stav
                  <select name="status">
                    <option value="">Všechny stavy</option>
                    {statuses.map((item) => (
                      <option value={item} selected={status === item}>
                        {statusLabel(item)}
                      </option>
                    ))}
                  </select>
                </label>
                <label>
                  Hledat
                  <input name="q" value={query} placeholder="jméno, e-mail, telefon, kód" />
                </label>
                <button class="btn primary" type="submit">
                  Filtrovat
                </button>
              </form>
              <div class="admin-grid">
                <article>
                  <>
                    <span>Objednávky celkem</span>
                    <strong>{summary?.ordersTotal ?? 0}</strong>
                  </>
                </article>
                <article>
                  <>
                    <span>Potvrzené objednávky</span>
                    <strong>{summary?.ordersConfirmed ?? 0}</strong>
                  </>
                </article>
                <article>
                  <>
                    <span>Zápisy v kalendáři</span>
                    <strong>{summary?.appointmentsTotal ?? 0}</strong>
                  </>
                </article>
                <article class="next-day">
                  <span>Nejbližší den zápisu</span>
                  <strong>
                    {nextAppointmentDay
                      ? new Intl.DateTimeFormat('cs-CZ', { dateStyle: 'medium' }).format(
                          new Date(`${nextAppointmentDay.date}T12:00:00`),
                        )
                      : 'Žádný'}
                  </strong>
                  <p>
                    {nextAppointmentDay
                      ? `${nextAppointmentDay.count} lidí čeká na zápis.`
                      : 'Zatím není rezervovaný žádný budoucí zápis.'}
                  </p>
                  {nextAppointmentDay && (
                    <a
                      class="mini-link"
                      href={buildAdminUrl({
                        appointmentDate: nextAppointmentDay.date,
                        appointmentMonth: nextAppointmentDay.date.slice(0, 7),
                      })}
                    >
                      Otevřít den
                    </a>
                  )}
                </article>
              </div>
            </section>

            <section class="admin-panel">
              <h2>Objednávky</h2>
              <div class="table-wrap orders-desktop">
                <table>
                  <thead>
                    <tr>
                      <>
                        <th>Kód</th>
                        <th>Datum</th>
                        <th>Kontakt</th>
                        <th>Kurz</th>
                        <th>Pobočka</th>
                        <th>Balíček</th>
                        <th>Doplňky</th>
                        <th>Termín zápisu</th>
                        <th>Stav</th>
                        <th>Cena</th>
                      </>
                    </tr>
                  </thead>
                  <tbody>
                    {orders.length ? (
                      orders.map((order) => (
                        <tr>
                          <td>
                            <strong>{order.publicCode}</strong>
                          </td>
                          <td>{formatDateTime(order.createdAt)}</td>
                          <td>
                            {order.contact.firstName} {order.contact.lastName}
                            <br />
                            <a href={`mailto:${order.contact.email}`}>{order.contact.email}</a>
                            <br />
                            <a href={`tel:${order.contact.phone}`}>{order.contact.phone}</a>
                          </td>
                          <td>{courseLabel(order.course)}</td>
                          <td>{branchLabel(order.branch)}</td>
                          <td>{packageLabel(order.package)}</td>
                          <td>
                            {order.addons.length
                              ? order.addons
                                  .map((item) => `${item.title} × ${item.quantity}`)
                                  .join(', ')
                              : '—'}
                          </td>
                          <td>
                            {order.appointment
                              ? `${formatDateTime(order.appointment.startsAt)}–${formatTime(order.appointment.endsAt)}`
                              : '—'}
                          </td>
                          <td>
                            <span class={`status-chip status-${order.status}`}>
                              {statusLabel(order.status)}
                            </span>
                          </td>
                          <td>{money(order.totalCzk)}</td>
                        </tr>
                      ))
                    ) : (
                      <tr>
                        <td colspan="10">Zvoleným filtrům neodpovídá žádná objednávka.</td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
              <div class="order-card-list">
                {orders.length ? (
                  orders.map((order) => (
                    <article class="order-card">
                      <div class="order-card-head">
                        <strong>{order.publicCode}</strong>
                        <span class={`status-chip status-${order.status}`}>
                          {statusLabel(order.status)}
                        </span>
                      </div>
                      <h3>
                        {order.contact.firstName} {order.contact.lastName}
                      </h3>
                      <p>
                        {courseLabel(order.course)} · {branchLabel(order.branch)} ·{' '}
                        {packageLabel(order.package)}
                      </p>
                      <dl>
                        <div>
                          <dt>Vytvořeno</dt>
                          <dd>{formatDateTime(order.createdAt)}</dd>
                        </div>
                        <div>
                          <dt>Cena</dt>
                          <dd>{money(order.totalCzk)}</dd>
                        </div>
                        <div>
                          <dt>Kontakt</dt>
                          <dd>
                            <a href={`tel:${order.contact.phone}`}>{order.contact.phone}</a>
                            <br />
                            <a href={`mailto:${order.contact.email}`}>{order.contact.email}</a>
                          </dd>
                        </div>
                        <div>
                          <dt>Doplňky</dt>
                          <dd>
                            {order.addons.length
                              ? order.addons
                                  .map((item) => `${item.title} × ${item.quantity}`)
                                  .join(', ')
                              : '—'}
                          </dd>
                        </div>
                        <div>
                          <dt>Termín zápisu</dt>
                          <dd>
                            {order.appointment
                              ? `${formatDateTime(order.appointment.startsAt)}–${formatTime(order.appointment.endsAt)}`
                              : '—'}
                          </dd>
                        </div>
                      </dl>
                    </article>
                  ))
                ) : (
                  <div class="notice">Zvoleným filtrům neodpovídá žádná objednávka.</div>
                )}
              </div>
            </section>

            <section class="admin-panel">
              <h2>Zápisy podle kalendáře</h2>
              <form class="admin-filters calendar-filter" method="get">
                <input type="hidden" name="from" value={from} />
                <input type="hidden" name="to" value={to} />
                <input type="hidden" name="branch" value={branch} />
                <input type="hidden" name="course" value={course} />
                <input type="hidden" name="status" value={status} />
                <input type="hidden" name="q" value={query} />
                <label>
                  Měsíc
                  <input type="month" name="appointmentMonth" value={appointmentMonth} />
                </label>
                <label>
                  Den zápisu
                  <input type="date" name="appointmentDate" value={appointmentDate} />
                </label>
                <label>
                  Pobočka zápisu
                  <select name="appointmentBranch">
                    <option value="">Všechny pobočky</option>
                    {branches.map((item) => (
                      <option value={item.id} selected={appointmentBranch === item.id}>
                        {item.name}
                      </option>
                    ))}
                  </select>
                </label>
                <button class="btn primary" type="submit">
                  Zobrazit den
                </button>
              </form>
              <div class="appointment-calendar-shell">
                <div class="appointment-calendar-header">
                  <div>
                    <strong>Zápisové dny v měsíci</strong>
                    <span>Číslo v políčku ukazuje počet rezervovaných zápisů.</span>
                  </div>
                  {appointmentDays.length > 0 && (
                    <div class="appointment-day-chips" aria-label="Rychlé otevření zápisových dnů">
                      {appointmentDays.map((item) => (
                        <a
                          href={buildAdminUrl({
                            appointmentDate: item.date,
                            appointmentMonth: item.date.slice(0, 7),
                          })}
                        >
                          {new Intl.DateTimeFormat('cs-CZ', {
                            day: 'numeric',
                            month: 'short',
                          }).format(new Date(`${item.date}T12:00:00`))}
                          <strong>{item.count}</strong>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
                <div class="calendar-weekdays" aria-hidden="true">
                  <span>Po</span>
                  <span>Út</span>
                  <span>St</span>
                  <span>Čt</span>
                  <span>Pá</span>
                  <span>So</span>
                  <span>Ne</span>
                </div>
                <div class="appointment-calendar-grid">
                  {Array.from({ length: firstDayOffset }, () => (
                    <span class="calendar-empty" />
                  ))}
                  {calendarDays.map((item) => (
                    <a
                      class:list={[
                        'calendar-day',
                        item.count > 0 && 'has-appointments',
                        item.date === appointmentDate && 'selected',
                      ]}
                      href={buildAdminUrl({ appointmentDate: item.date, appointmentMonth })}
                      aria-label={`Otevřít ${item.date}, zápisů: ${item.count}`}
                    >
                      <span>{item.day}</span>
                      {item.count > 0 && <strong>{item.count}</strong>}
                    </a>
                  ))}
                </div>
              </div>
              <p class="lead small-lead">
                Na zvolený den čeká <strong>{appointments.length}</strong> zápisů.
              </p>
              <div class="appointment-list">
                {appointments.length ? (
                  appointments.map((item) => (
                    <article>
                      <time>
                        {formatTime(item.startsAt)}–{formatTime(item.endsAt)}
                      </time>
                      <div>
                        <strong>
                          {item.contact.firstName} {item.contact.lastName}
                        </strong>
                        <br />
                        {courseLabel(item.course)} · {branchLabel(item.branch)} · {item.publicCode}
                        <br />
                        <a href={`tel:${item.contact.phone}`}>{item.contact.phone}</a> ·{' '}
                        <a href={`mailto:${item.contact.email}`}>{item.contact.email}</a>
                      </div>
                      <span class={`status-chip status-${item.status}`}>
                        {statusLabel(item.status)}
                      </span>
                    </article>
                  ))
                ) : (
                  <div class="notice">Na tento den není rezervovaný žádný zápis.</div>
                )}
              </div>
            </section>
          </>
        )
      }
      <a class="text-link" href="/">Zpět na web</a>
    </div>
  </section>
</Base>

<style>
  .admin-section {
    background: var(--canvas);
  }
  .admin-section .container {
    max-width: 1720px;
  }
  .admin-topline {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: start;
    margin-bottom: 28px;
  }
  .admin-topline h1 {
    max-width: 820px;
    font-size: clamp(2.75rem, 5.6vw, 5.5rem);
    line-height: 0.95;
  }
  .admin-topline form {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .admin-user {
    font-weight: 750;
  }
  .admin-login,
  .admin-filters {
    display: grid;
    gap: 16px;
  }
  .admin-login {
    max-width: 460px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 28px;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .admin-filters {
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    align-items: end;
  }
  .admin-login label,
  .admin-filters label {
    display: grid;
    gap: 6px;
    font-weight: 700;
  }
  .admin-login input,
  .admin-filters input,
  .admin-filters select {
    width: 100%;
    border: 1px solid #cbd9d9;
    border-radius: 0.75rem;
    padding: 11px 12px;
    background: #fff;
    color: var(--ink);
  }
  .admin-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    padding: clamp(22px, 2.4vw, 42px);
    margin-bottom: 28px;
    box-shadow: var(--shadow);
  }
  .admin-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 24px 0 0;
  }
  .admin-grid article {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(18px, 1.6vw, 28px);
    background: var(--canvas);
    min-height: 150px;
  }
  .admin-grid span {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .admin-grid strong {
    display: block;
    font-size: 2rem;
    margin-top: 8px;
  }
  .next-day p {
    margin-top: 8px;
    font-size: 0.9rem;
  }
  .mini-link {
    display: inline-flex;
    margin-top: 12px;
    color: var(--brand-dark);
    font-weight: 800;
    text-decoration: none;
  }
  .table-wrap {
    overflow: auto;
  }
  .order-card-list {
    display: none;
  }
  table {
    min-width: 1280px;
    width: 100%;
    border-collapse: collapse;
    margin-top: 16px;
  }
  th,
  td {
    border-bottom: 1px solid var(--line);
    padding: 12px;
    text-align: left;
    vertical-align: top;
    font-size: 0.9rem;
  }
  th {
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .status-chip {
    display: inline-flex;
    border-radius: 999px;
    padding: 5px 10px;
    background: var(--brand-soft);
    color: var(--brand-dark);
    font-size: 0.76rem;
    font-weight: 750;
    white-space: nowrap;
  }
  .status-cancelled,
  .status-expired {
    background: #f8e6e4;
    color: var(--danger);
  }
  .calendar-filter {
    grid-template-columns: minmax(160px, 220px) minmax(160px, 220px) minmax(180px, 260px) auto;
    max-width: 920px;
  }
  .appointment-calendar-shell {
    display: grid;
    gap: 14px;
    margin-top: 24px;
    max-width: 980px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(16px, 2vw, 24px);
    background: var(--canvas);
  }
  .appointment-calendar-header {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
  }
  .appointment-calendar-header strong,
  .appointment-calendar-header span {
    display: block;
  }
  .appointment-calendar-header span {
    color: var(--muted);
    font-size: 0.92rem;
    margin-top: 4px;
  }
  .appointment-day-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
  }
  .appointment-day-chips a {
    display: inline-flex;
    align-items: center;
