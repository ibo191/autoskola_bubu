---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { Content as Terms, getHeadings } from '../content/legal/vop.md';

const chapters = getHeadings().filter(({ depth }) => depth === 2);
---

<Base
  title="Obchodní podmínky"
  description="Všeobecné obchodní podmínky Autoškoly BuBu s.r.o."
  noindex
>
  <section class="section">
    <div class="container content legal-document">
      <span class="eyebrow">Autoškola BuBu s.r.o.</span>
      <h1>Obchodní podmínky</h1>
      <div class="notice">
        Tento dokument upravuje podmínky výuky a výcviku, kurzovné, odstoupení od smlouvy, zkoušky
        odborné způsobilosti a souhlas se zpracováním osobních údajů.
      </div>
      <nav class="legal-toc" aria-label="Obsah obchodních podmínek">
        <strong>Obsah</strong>
        <ul>
          {
            chapters.map(({ slug, text }) => (
              <li>
                <a href={`#${slug}`}>{text}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <article class="legal-text">
        <Terms />
      </article>
      <a class="text-link" href="/cenik">Zpět na ceník</a>
    </div>
  </section>
</Base>

<style>
  .legal-toc {
    margin-block: 24px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .legal-toc ul {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
  }
  .legal-text {
    margin-block: 32px;
    line-height: 1.75;
  }
  .legal-text :global(h2) {
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-weight: 750;
    scroll-margin-top: 24px;
  }
  .legal-text :global(h3) {
    font-weight: 750;
  }
  .legal-text :global(a),
  .legal-toc a {
    color: var(--brand-dark);
  }
</style>
