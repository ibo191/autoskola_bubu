---
import type { Course } from '../lib/catalog';
import { courseFaqs } from '../lib/course-faq';
interface Props {
  course: Course;
}
const { course } = Astro.props;
const questions = courseFaqs(course);
const heading = `${course.label} bez nejasností.`;
---

<section class="section course-faq" id="faq">
  <div class="container">
    <div class="faq-head">
      <div><span class="eyebrow">Časté otázky</span><h2>{heading}</h2></div><p>
        Praktické odpovědi před objednávkou. Pokud zde něco chybí, napište nám nebo zavolejte.
      </p>
    </div><div class="faq-list">
      {
        questions.map(([question, answer]) => (
          <details>
            <>
              <summary>
                {question}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{answer}</p>
            </>
          </details>
        ))
      }
    </div>
  </div>
</section>
<style>
  .course-faq {
    background: var(--canvas);
  }
  .faq-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 36px;
    margin-bottom: 28px;
  }
  .faq-head p {
    max-width: 440px;
    font-size: 0.9rem;
  }
  .faq-list {
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: white;
  }
  details + details {
    border-top: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 19px 22px;
    cursor: pointer;
    font-weight: 720;
    font-size: 0.93rem;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    color: var(--brand-dark);
    font-size: 1.3rem;
  }
  details[open] summary span {
    transform: rotate(45deg);
  }
  details p {
    padding: 0 22px 20px;
    max-width: 860px;
    font-size: 0.9rem;
    line-height: 1.7;
  }
  @media (max-width: 680px) {
    .faq-head {
      display: block;
    }
    .faq-head p {
      margin-top: 16px;
    }
    summary {
      padding: 17px;
    }
    details p {
      padding: 0 17px 18px;
    }
  }
</style>
