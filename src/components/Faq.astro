---
import source from '../content/faq-source.md?raw';

type Item = { question: string; answer: string };
type Group = { title: string; items: Item[] };

function escapeHtml(value: string) {
  return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function formatAnswer(value: string) {
  const lines = value.trim().split(/\n{2,}/);
  return lines
    .map((block) => {
      const text = escapeHtml(block)
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\n/g, '<br />');
      if (block.split('\n').every((line) => /^\* /.test(line))) {
        return `<ul>${block
          .split('\n')
          .map(
            (line) =>
              `<li>${escapeHtml(line.replace(/^\* /, '')).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')}</li>`,
          )
          .join('')}</ul>`;
      }
      if (/^\d+\. /.test(block)) {
        return `<ol>${block
          .split('\n')
          .map(
            (line) =>
              `<li>${escapeHtml(line.replace(/^\d+\. /, '')).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')}</li>`,
          )
          .join('')}</ol>`;
      }
      return `<p>${text}</p>`;
    })
    .join('');
}

const groups: Group[] = [];
let active: Group | undefined;
let question = '';
let answer: string[] = [];
for (const line of source.replace(/\r/g, '').split('\n')) {
  if (line.startsWith('# ')) {
    if (active && question)
      active.items.push({ question, answer: formatAnswer(answer.join('\n')) });
    active = { title: line.slice(2), items: [] };
    groups.push(active);
    question = '';
    answer = [];
  } else if (line.startsWith('## ')) {
    if (active && question)
      active.items.push({ question, answer: formatAnswer(answer.join('\n')) });
    question = line.slice(3);
    answer = [];
  } else if (active && question) {
    answer.push(line);
  }
}
if (active && question) active.items.push({ question, answer: formatAnswer(answer.join('\n')) });
---

<section class="section tinted">
  <div class="container faq-layout">
    <aside>
      <span class="eyebrow">Vše na jednom místě</span><h2>Časté otázky</h2><p>
        Vyberte si téma a rozbalte odpověď. Nenašli jste ji? Ozvěte se nám.
      </p><a class="text-link" href="/kontakt">Kontakty na pobočky ↗</a>
    </aside>
    <div class="faq-groups">
      {
      groups.filter((group) => group.items.length > 0).map((group) => (
          <section class="faq-group">
            <h3>{group.title}</h3>
            {group.items.map((item) => (
              <details>
                <summary>
                  {item.question}
                  <span aria-hidden="true">+</span>
                </summary>
                <div class="faq-answer" set:html={item.answer} />
              </details>
            ))}
          </section>
        ))
      }
    </div>
  </div>
</section>
<style>
  .faq-layout {
    display: grid;
    gap: 70px;
    grid-template-columns: 0.7fr 1.3fr;
  }
  aside {
    align-self: start;
    position: sticky;
    top: 24px;
  }
  aside h2 {
    margin: 8px 0 16px;
  }
  aside p {
    margin: 0 0 20px;
  }
  .faq-groups {
    display: grid;
    gap: 34px;
  }
  .faq-group {
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(207, 223, 226, 0.8);
    border-radius: 18px;
    padding: 23px 25px 5px;
  }
  .faq-group h3 {
    align-items: center;
    color: var(--brand-dark);
    display: flex;
    font-size: clamp(1.35rem, 2.3vw, 1.72rem);
    font-weight: 800;
    gap: 14px;
    letter-spacing: -0.025em;
    margin: 0 0 8px;
  }
  .faq-group h3::before {
    background: var(--teal);
    border-radius: 99px;
    content: '';
    height: 9px;
    width: 9px;
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    cursor: pointer;
    display: flex;
    font-size: 0.95rem;
    font-weight: 650;
    gap: 20px;
    justify-content: space-between;
    list-style: none;
    padding: 19px 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    color: var(--brand-dark);
    font-size: 1.35rem;
    line-height: 0.8;
  }
  details[open] summary span {
    transform: rotate(45deg);
  }
  .faq-answer :global(p),
  .faq-answer :global(li) {
    font-size: 0.91rem;
    line-height: 1.6;
  }
  .faq-answer :global(p) {
    margin: 0 0 14px;
  }
  .faq-answer :global(ul),
  .faq-answer :global(ol) {
    margin: 0 0 16px;
    padding-left: 22px;
  }
  .faq-answer {
    padding: 0 34px 10px 0;
  }
  @media (max-width: 760px) {
    .faq-layout {
      gap: 34px;
      grid-template-columns: 1fr;
    }
    aside {
      position: static;
    }
  }
</style>
