---
import { faqGroups as groups } from '../lib/faqs';

interface Props {
  compact?: boolean;
  quiet?: boolean;
}

const { compact = false, quiet = false } = Astro.props;
const homeFaqs = [
  {
    question: 'Jak se přihlásím do autoškoly?',
    answer:
      'Online si vyberete kurz, pobočku a termín zápisu. Potvrzení s dalším postupem vám pošleme e-mailem.',
  },
  {
    question: 'Jak probíhá kurz skupiny B?',
    answer:
      'Navazujeme teorií, praktickými jízdami a přípravou na závěrečnou zkoušku. Tempo postupně přizpůsobujeme tomu, jak získáváte jistotu.',
  },
  {
    question: 'Mohu si vybrat manuál, automat nebo L17?',
    answer:
      'Ano. Manuál a L17 nabízíme na všech pobočkách; automatická převodovka je dostupná ve Střížkově.',
  },
  {
    question: 'Kolik kurz stojí?',
    answer:
      'Aktuální cenu podle kurzu a pobočky najdete v ceníku. Při zápisu s vámi projdeme také možnosti platby.',
  },
  {
    question: 'Co potřebuji přinést k zápisu?',
    answer:
      'Připravte si občanský průkaz, zdravotní posudek a vyplněnou žádost o přijetí k výuce a výcviku.',
  },
];
const displayedGroups = compact ? [{ title: 'Nejčastější dotazy', items: homeFaqs }] : groups;
---

<section class="section tinted">
  <div class:list={['container', 'faq-layout', { quiet }]}>
    <aside>
      <span class="eyebrow">Vše na jednom místě</span><h2>Časté otázky</h2><p>
        Vyberte si téma a rozbalte odpověď. Nenašli jste ji? Ozvěte se nám.
      </p><a class="text-link" href="/kontakt">Kontakty na pobočky ↗</a>
    </aside>
    <div class="faq-groups">
      {
        displayedGroups
          .filter((group) => group.items.length > 0)
          .map((group) => (
            <section class:list={['faq-group', { compact, quiet }]}>
              {!compact && <h3>{group.title}</h3>}
              {group.items.map((item) => (
                <details>
                  <summary>
                    {item.question}
                    <span aria-hidden="true">+</span>
                  </summary>
                  <div class="faq-answer" set:html={item.answer} />
                </details>
              ))}
            </section>
          ))
      }
    </div>
  </div>
</section>
<style>
  .faq-layout {
    display: grid;
    gap: 70px;
    grid-template-columns: 0.7fr 1.3fr;
  }
  aside {
    align-self: start;
    position: sticky;
    top: 24px;
  }
  aside h2 {
    margin: 8px 0 16px;
  }
  aside p {
    margin: 0 0 20px;
  }
  .faq-groups {
    display: grid;
    gap: 34px;
  }
  .faq-group {
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(207, 223, 226, 0.8);
    border-radius: 18px;
    padding: 23px 25px 5px;
  }
  .faq-group h3 {
    align-items: center;
    color: var(--brand-dark);
    display: flex;
    font-size: clamp(1.35rem, 2.3vw, 1.72rem);
    font-weight: 800;
    gap: 14px;
    letter-spacing: -0.025em;
    margin: 0 0 8px;
  }
  .faq-group h3::before {
    background: var(--teal);
    border-radius: 99px;
    content: '';
    height: 9px;
    width: 9px;
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    cursor: pointer;
    display: flex;
    font-size: 0.95rem;
    font-weight: 650;
    gap: 20px;
    justify-content: space-between;
    list-style: none;
    padding: 19px 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    color: var(--brand-dark);
    font-size: 1.35rem;
    line-height: 0.8;
  }
  details[open] summary span {
    transform: rotate(45deg);
  }
  .faq-answer :global(p),
  .faq-answer :global(li) {
    font-size: 0.91rem;
    line-height: 1.6;
  }
  .faq-answer :global(p) {
    margin: 0 0 14px;
  }
  .faq-answer :global(ul),
  .faq-answer :global(ol) {
    margin: 0 0 16px;
    padding-left: 22px;
  }
  .faq-answer {
    padding: 0 34px 10px 0;
  }
  .faq-group.compact {
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0;
  }
  .faq-group.compact details:first-of-type {
    border-top: 1px solid var(--line);
  }
  .faq-group.compact summary {
    font-size: 1rem;
  }
  .faq-layout.quiet {
    gap: 58px;
  }
  .faq-group.quiet {
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0;
  }
  .faq-group.quiet h3 {
    color: var(--brand-dark);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 650;
    margin: 0 0 4px;
  }
  .faq-group.quiet h3::before {
    height: 7px;
    width: 7px;
  }
  .faq-group.quiet details:first-of-type {
    border-top: 1px solid var(--line);
  }
  .faq-group.quiet summary {
    font-size: clamp(1rem, 1.45vw, 1.12rem);
    font-weight: 500;
    line-height: 1.45;
    padding: 21px 0;
  }
  .faq-group.quiet summary span {
    color: var(--teal);
    font-size: 1.25rem;
  }
  .faq-group.quiet .faq-answer {
    max-width: 780px;
    padding-bottom: 16px;
  }
  @media (max-width: 760px) {
    .faq-layout {
      gap: 34px;
      grid-template-columns: 1fr;
    }
    aside {
      position: static;
    }
  }
</style>
