---
import { branches, courses } from '../lib/catalog';
---

<dialog id="order-dialog" aria-labelledby="order-title" aria-describedby="order-intro">
  <div class="dialog-head">
    <span class="dialog-brand">AUTOŠKOLA <strong>BuBu</strong></span><button
      type="button"
      class="close-dialog"
      aria-label="Zavřít objednávku">×</button
    >
  </div>
  <div class="dialog-body">
    <span class="eyebrow">První krok k řidičáku</span><h2 id="order-title">
      Pojďme vybrat váš kurz.
    </h2><p id="order-intro">Nejprve kurz, potom kontakt a osobní zápis na pobočce.</p>
    <ol class="wizard-steps" aria-label="Kroky objednávky">
      <li aria-current="step">1. Kurz</li><li>2. Kontakt</li><li>3. Osobní zápis</li>
    </ol>
    <form id="order-form" novalidate>
      <fieldset data-step="0">
        <legend class="sr-only">Výběr kurzu, pobočky a doplňků</legend><div class="form-grid">
          <label
            >Pobočka<select name="branch" required
              ><option value="">Vyberte pobočku</option>{
                branches.map((b) => <option value={b.id}>{b.name}</option>)
              }</select
            ></label
          >
          <label
            >Kurz<select name="course" required
              ><option value="">Vyberte kurz</option>{
                courses.map((c) => (
                  <option value={c.id}>
                    {c.label} – {c.name}
                  </option>
                ))
              }</select
            ></label
          >
          <label id="transmission-field" hidden
            >Převodovka<select name="transmission"
              ><option value="manual">Manuální</option><option value="automatic"
                >Automatická (Střížkov)</option
              ></select
            ></label
          >
          <label id="licence-field" hidden
            >Jaké oprávnění už máte?<select name="heldLicence"
              ><option value="">Zatím žádné</option><option value="B">B</option><option value="A1"
                >A1</option
              ><option value="A2">A2</option><option value="AM">AM</option><option value="A"
                >A</option
              ><option value="other">Jiné nebo více skupin</option></select
            ></label
          >
          <label id="period-field" hidden
            >Jak dlouho oprávnění držíte?<select name="holdingPeriod"
              ><option value="unknown">Vyberte dobu držení</option><option value="less-than-two"
                >Méně než 2 roky</option
              ><option value="exactly-two">Přesně 2 roky</option><option value="more-than-two"
                >Více než 2 roky</option
              ></select
            ></label
          >
          <label id="package-field" hidden>
            Varianta výcviku<select name="package">
              <option value="single">Jednotná cena</option>
            </select>
          </label>
        </div>
        <div id="moto-package-cards" class="moto-package-cards" hidden aria-live="polite">
          <div class="moto-package-intro">
            <span class="eyebrow">Balíčky MOTO</span>
            <h3>Vyberte si rozsah, který vám dá smysl.</h3>
            <p>
              Moto Jistotu doporučujeme hlavně začátečníkům. Dává víc času na ovládání motorky,
              cvičiště i bezpečný pocit před zkouškou.
            </p>
          </div>
          <div class="moto-package-grid" id="moto-package-options"></div>
        </div>
        <div class="upsell-panel" aria-labelledby="upsell-title">
          <div>
            <span class="eyebrow">Doporučujeme ke kurzu</span>
            <h3 id="upsell-title">Doplňky k objednávce</h3>
            <p>Volitelné položky přičteme k celkové ceně kurzu.</p>
          </div>
          <label class="addon-card">
            <input type="checkbox" name="addonBook" />
            <span
              ><strong>Knížka Autoškola Pohodlně</strong><small
                >Praktická příprava ke zkoušce · 300 Kč</small
              ></span
            >
          </label>
          <div class="addon-card addon-quantity">
            <span><strong>Mikina Autoškola BuBu</strong><small>500 Kč/ks s DPH</small></span>
            <label
              >Množství<input
                type="number"
                name="addonHoodieQty"
                min="0"
                max="10"
                value="0"
                inputmode="numeric"
              /></label
            >
          </div>
          <div class="addon-card addon-quantity">
            <span><strong>Tričko Autoškola BuBu</strong><small>500 Kč/ks s DPH</small></span>
            <label
              >Množství<input
                type="number"
                name="addonShirtQty"
                min="0"
                max="10"
                value="0"
                inputmode="numeric"
              /></label
            >
          </div>
        </div>
        <div class="quote-box" aria-live="polite">
          <span id="quote-label">Cena vaší objednávky</span><strong id="quote-amount"
            >Vyberte kurz a pobočku</strong
          ><p id="quote-note"></p>
        </div>
      </fieldset>
      <fieldset data-step="1" hidden>
        <legend class="sr-only">Kontaktní údaje</legend><div class="notice">
          Kontaktní údaje použijeme jen pro zpracování objednávky a rezervaci osobního zápisu.
        </div><div class="form-grid">
          <label
            >Jméno<input
              name="firstName"
              autocomplete="given-name"
              required
              maxlength="80"
            /></label
          ><label
            >Příjmení<input
              name="lastName"
              autocomplete="family-name"
              required
              maxlength="80"
            /></label
          ><label
            >E-mail<input
              type="email"
              name="email"
              autocomplete="email"
              required
              maxlength="254"
            /></label
          ><label
            >Telefon<input
              type="tel"
              name="phone"
              autocomplete="tel"
              required
              maxlength="20"
            /></label
          >
        </div><p class="small">Doklady, adresu ani zdravotní údaje online nevyplňujete.</p>
      </fieldset>
      <fieldset data-step="2" hidden>
        <legend class="sr-only">Osobní zápis</legend><div class="notice">
          Vyberte si termín zápisu na pobočce. Jeden termín je dlouhý 10 minut.
        </div><div id="order-summary"></div>
        <input type="hidden" name="slotId" id="slot-field" required />
        <div class="booking-calendar" aria-live="polite">
          <div class="calendar-head">
            <button type="button" class="btn secondary" id="calendar-prev">‹</button>
            <strong id="calendar-title">Načítáme termíny…</strong>
            <button type="button" class="btn secondary" id="calendar-next">›</button>
          </div>
          <div class="calendar-weekdays" aria-hidden="true">
            <span>Po</span><span>Út</span><span>St</span><span>Čt</span><span>Pá</span><span
              >So</span
            ><span>Ne</span>
          </div>
          <div id="calendar-days" class="calendar-days"></div>
          <div id="slot-list" class="slot-list"><p>Vyberte zvýrazněný den v kalendáři.</p></div>
        </div>
        <label class="checkbox"
          ><input type="checkbox" name="terms" required /><span
            >Souhlasím s <a href="/obchodni-podminky" target="_blank" rel="noreferrer"
              >obchodními podmínkami</a
            >.</span
          ></label
        ><label class="checkbox"
          ><input type="checkbox" name="privacy" required /><span
            >Beru na vědomí
            <a href="/ochrana-osobnich-udaju" target="_blank" rel="noreferrer"
              >zpracování osobních údajů</a
            > potřebné pro objednávku a rezervaci zápisu.</span
          ></label
        ><label class="checkbox"
          ><input type="checkbox" name="marketing" /><span
            >Chci dostávat novinky a praktické informace od Autoškoly BuBu.</span
          ></label
        ><button type="submit" id="order-submit" class="btn primary">Odeslat objednávku</button>
      </fieldset>
      <p id="order-error" class="error" role="alert"></p><div class="wizard-actions">
        <button type="button" id="order-back" class="btn secondary" hidden>Zpět</button><button
          type="button"
          id="order-next"
          class="btn primary">Pokračovat →</button
        >
      </div>
    </form><div id="discard-question" hidden role="alert">
      <p>Chcete zavřít rozpracovaný výběr? Vyplněné údaje se smažou.</p><div class="actions">
        <button class="btn secondary" id="keep-order">Pokračovat ve výběru</button><button
          class="btn"
          id="discard-order">Zahodit a zavřít</button
        >
      </div>
    </div>
  </div>
</dialog>
<script src="../scripts/order.ts"></script>
<style>
  dialog {
    border: 0;
    border-radius: 20px;
    padding: 0;
    max-width: 760px;
    width: calc(100% - 32px);
    max-height: 92dvh;
    color: var(--ink);
    box-shadow: 0 30px 100px #0003;
  }
  dialog::backdrop {
    background: #122e2ba8;
    backdrop-filter: blur(5px);
  }
  .dialog-head {
    padding: 22px 30px;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .dialog-brand {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .dialog-brand strong {
    font-size: 1.3rem;
    letter-spacing: -0.04em;
  }
  .close-dialog {
    background: transparent;
    border: 0;
    font-size: 2rem;
    width: 44px;
    height: 44px;
    line-height: 1;
  }
  .dialog-body {
    padding: 32px;
  }
  .dialog-body h2 {
    font-size: 2rem;
  }
  .dialog-body > p {
    font-size: 0.9rem;
    margin-top: 14px;
  }
  .wizard-steps {
    list-style: none;
    display: flex;
    gap: 14px;
    padding: 0;
    margin: 28px 0;
    font-size: 0.75rem;
    font-weight: 650;
  }
  .wizard-steps li {
    flex: 1;
    border-bottom: 3px solid var(--line);
    padding-bottom: 12px;
  }
  .wizard-steps [aria-current] {
    border-color: var(--brand-dark);
    color: var(--brand-dark);
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin: 20px 0;
  }
  label {
    display: flex;
    flex-direction: column;
    font-size: 0.8rem;
    font-weight: 650;
    gap: 8px;
  }
  input,
  select {
    padding: 12px;
    border: 1px solid #9aada5;
    border-radius: 6px;
    min-height: 49px;
    background: #fff;
    color: var(--ink);
    width: 100%;
    min-width: 0;
    font-size: 0.85rem;
  }
  .checkbox {
    flex-direction: row;
    align-items: start;
    margin: 22px 0;
    font-weight: 500;
  }
  .checkbox input {
    width: 20px;
    min-height: 20px;
    flex-shrink: 0;
    margin: 2px 8px 0 0;
  }
  #package-field {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .moto-package-cards {
    border: 1px solid #c4d8cb;
    border-radius: 18px;
    padding: 20px;
    margin: 22px 0;
    background: linear-gradient(135deg, #f7fbfa, #eaf7f4);
  }
  .moto-package-intro h3 {
    font-size: 1.35rem;
    margin: 4px 0 8px;
  }
  .moto-package-intro p {
    font-size: 0.86rem;
    max-width: 620px;
  }
  .moto-package-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 18px;
  }
  .moto-package-card {
    border: 1px solid #cddfd9;
    border-radius: 16px;
    padding: 18px;
    background: #fff;
    text-align: left;
    color: var(--ink);
    display: grid;
    gap: 12px;
    min-height: 100%;
    cursor: pointer;
    transition:
      transform var(--ease),
      border-color var(--ease),
      box-shadow var(--ease),
      background var(--ease);
  }
  .moto-package-card:hover {
    transform: translateY(-2px);
    border-color: var(--brand);
    background: #f8fffd;
  }
  .moto-package-card[aria-pressed='true'] {
    border-color: var(--brand-dark);
    box-shadow: 0 14px 34px #126b6020;
    background: #eefaf7;
  }
  .moto-package-card.recommended {
    border-color: var(--brand);
    position: relative;
  }
  .moto-package-card.recommended::before {
    content: 'Doporučujeme';
    justify-self: start;
    border-radius: 999px;
    background: var(--brand);
    color: #102f48;
    padding: 5px 10px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .moto-package-card h4 {
    font-size: 1.18rem;
    margin: 0;
  }
  .moto-package-card .package-price {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .moto-package-card ul {
    padding-left: 18px;
    margin: 0;
  }
  .moto-package-card li {
    margin: 6px 0;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .moto-package-grid.single {
    grid-template-columns: 1fr;
  }
  .upsell-panel {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
    display: grid;
    gap: 12px;
    background: #f8fbfa;
  }
  .upsell-panel h3 {
    margin: 4px 0;
    font-size: 1.25rem;
  }
  .upsell-panel p,
  .addon-card small {
    font-size: 0.78rem;
    color: #51625c;
  }
  .addon-card {
    border: 1px solid #d7e4df;
    border-radius: 12px;
    padding: 14px;
    background: #fff;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .addon-card input[type='checkbox'] {
    width: 22px;
    min-height: 22px;
    flex: 0 0 auto;
  }
  .addon-card span {
    display: grid;
    gap: 4px;
  }
  .addon-quantity label {
    max-width: 110px;
    margin-left: auto;
  }
  .quote-box {
    background: var(--brand-soft);
    border-radius: 10px;
    padding: 22px;
    margin-top: 24px;
  }
  .quote-box > span {
    display: block;
    font-size: 0.75rem;
  }
  .quote-box strong {
    font-size: 1.5rem;
    display: block;
    margin-top: 5px;
  }
  .quote-box p {
    font-size: 0.75rem;
    margin-top: 8px;
  }
  .booking-calendar {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 16px;
    background: #fff;
  }
  .calendar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .calendar-weekdays,
  .calendar-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    text-align: center;
  }
  .calendar-weekdays {
    font-size: 0.7rem;
    font-weight: 700;
    color: #60716b;
    margin-bottom: 6px;
  }
  .calendar-day {
    min-height: 42px;
    border: 1px solid #e2ece8;
    border-radius: 10px;
    background: #f7faf9;
    color: #8a9a94;
    font-weight: 700;
  }
  .calendar-day.available {
    background: #e7f6f4;
    color: var(--brand-dark);
    border-color: #9bd5cf;
    cursor: pointer;
  }
  .calendar-day.available:hover,
  .calendar-day.selected {
    background: var(--brand);
    color: #fff;
    border-color: var(--brand);
  }
  .calendar-day:disabled {
    cursor: not-allowed;
  }
  .slot-list {
    margin-top: 16px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .slot-list p {
    font-size: 0.8rem;
  }
  .slot-option {
    border: 1px solid #9bd5cf;
    border-radius: 999px;
    padding: 9px 13px;
    background: #fff;
    cursor: pointer;
    font-weight: 700;
  }
  .slot-option:hover,
  .slot-option[aria-pressed='true'] {
    background: var(--brand-dark);
    color: #fff;
    border-color: var(--brand-dark);
  }
  .wizard-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
  }
  #order-error {
    margin-top: 18px;
  }
  #order-summary {
    padding: 20px 0;
    font-weight: 600;
  }
  #discard-question {
    border-top: 1px solid var(--line);
    margin-top: 24px;
    padding-top: 24px;
  }
  #discard-question p {
    font-size: 0.85rem;
  }
  @media (max-width: 600px) {
    dialog {
      width: 100%;
      max-width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      border-radius: 0;
      margin: 0;
    }
    .dialog-head {
      padding: 12px 20px;
    }
    .dialog-body {
      padding: 24px 20px;
    }
    .dialog-body h2 {
      font-size: 1.7rem;
    }
    .form-grid {
      grid-template-columns: 1fr;
    }
    .wizard-steps {
      gap: 8px;
      font-size: 0.65rem;
    }
    .addon-card {
      align-items: flex-start;
    }
    .moto-package-grid {
      grid-template-columns: 1fr;
    }
    .calendar-day {
      min-height: 36px;
    }
  }
</style>
