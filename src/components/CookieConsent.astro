---

---

<section class="cookie-consent" data-cookie-consent hidden aria-live="polite">
  <div class="cookie-card" data-cookie-banner>
    <div>
      <span class="eyebrow">Soukromí na webu</span>
      <h2 id="cookie-title">Cookies máme pod kontrolou</h2>
      <p>
        Nezbytné cookies drží web funkční. Analytiku a marketing zapneme jen tehdy, když nám k tomu
        dáte souhlas. Google ani Meta skripty teď bez souhlasu nespouštíme.
      </p>
    </div>
    <div class="cookie-actions" aria-labelledby="cookie-title">
      <button type="button" class="btn primary" data-cookie-accept>Souhlasím se vším</button>
      <button type="button" class="btn secondary" data-cookie-reject>Jen nezbytné</button>
      <button type="button" class="cookie-link" data-cookie-settings>Nastavit cookies</button>
    </div>
  </div>
  <div
    class="cookie-card cookie-settings"
    data-cookie-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="cookie-settings-title"
    hidden
  >
    <div>
      <span class="eyebrow">Nastavení cookies</span>
      <h2 id="cookie-settings-title">Vyberte, s čím souhlasíte</h2>
      <p>Volbu můžete kdykoliv změnit odkazem v patičce webu.</p>
    </div>
    <div class="cookie-options">
      <label class="cookie-option">
        <input type="checkbox" checked disabled />
        <span
          ><strong>Nezbytné cookies</strong><small
            >Bez nich nejde objednávka, správa relace a základní bezpečnost.</small
          ></span
        >
      </label>
      <label class="cookie-option">
        <input type="checkbox" data-cookie-category="analytics" />
        <span
          ><strong>Analytické cookies</strong><small
            >Pomohou nám pochopit návštěvnost a vylepšovat web.</small
          ></span
        >
      </label>
      <label class="cookie-option">
        <input type="checkbox" data-cookie-category="marketing" />
        <span
          ><strong>Marketingové cookies</strong><small
            >Budou sloužit pro měření kampaní a remarketing až po zapnutí reklamních nástrojů.</small
          ></span
        >
      </label>
    </div>
    <div class="cookie-actions">
      <button type="button" class="btn primary" data-cookie-save>Uložit nastavení</button>
      <button type="button" class="btn secondary" data-cookie-reject>Jen nezbytné</button>
      <button type="button" class="cookie-link" data-cookie-close>Zpět</button>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const COOKIE_NAME = 'bubu_cookie_consent';
    const VERSION = 1;
    const YEAR = 60 * 60 * 24 * 365;
    const HALF_YEAR = 60 * 60 * 24 * 180;
    const root = document.querySelector('[data-cookie-consent]');
    if (!root) return;
    const banner = root.querySelector('[data-cookie-banner]');
    const panel = root.querySelector('[data-cookie-panel]');
    let lastFocus = null;

    function readCookie() {
      const row = document.cookie.split('; ').find((item) => item.startsWith(`${COOKIE_NAME}=`));
      if (!row) return null;
      try {
        const parsed = JSON.parse(decodeURIComponent(row.slice(COOKIE_NAME.length + 1)));
        if (parsed.version !== VERSION) return null;
        return parsed;
      } catch {
        return null;
      }
    }

    function writeConsent(analytics, marketing, maxAge = YEAR) {
      const value = encodeURIComponent(
        JSON.stringify({
          version: VERSION,
          necessary: true,
          analytics: Boolean(analytics),
          marketing: Boolean(marketing),
          decidedAt: new Date().toISOString(),
        }),
      );
      const secure = location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = `${COOKIE_NAME}=${value}; Path=/; SameSite=Lax; Max-Age=${maxAge}${secure}`;
      root.hidden = true;
      banner.hidden = false;
      panel.hidden = true;
      document.dispatchEvent(
        new CustomEvent('bubu:cookie-consent-updated', { detail: readCookie() }),
      );
    }

    function setPanelValues(consent) {
      root.querySelectorAll('[data-cookie-category]').forEach((input) => {
        input.checked = Boolean(consent?.[input.dataset.cookieCategory]);
      });
    }

    function firstFocusable(scope) {
      return scope.querySelector(
        'button, [href], input:not([disabled]), select, textarea, [tabindex]:not([tabindex="-1"])',
      );
    }

    function openBanner() {
      root.hidden = false;
      banner.hidden = false;
      panel.hidden = true;
    }

    function openSettings() {
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      setPanelValues(readCookie());
      root.hidden = false;
      banner.hidden = true;
      panel.hidden = false;
      firstFocusable(panel)?.focus();
    }

    function closeSettings() {
      if (!readCookie()) {
        openBanner();
        firstFocusable(banner)?.focus();
        return;
      }
      root.hidden = true;
      panel.hidden = true;
      banner.hidden = false;
      lastFocus?.focus?.();
    }

    root.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      if (target.closest('[data-cookie-accept]')) writeConsent(true, true);
      if (target.closest('[data-cookie-reject]')) writeConsent(false, false, HALF_YEAR);
      if (target.closest('[data-cookie-settings]')) openSettings();
      if (target.closest('[data-cookie-save]')) {
        const analytics =
          root.querySelector('[data-cookie-category="analytics"]')?.checked ?? false;
        const marketing =
          root.querySelector('[data-cookie-category="marketing"]')?.checked ?? false;
        writeConsent(analytics, marketing);
      }
      if (target.closest('[data-cookie-close]')) closeSettings();
    });

    root.addEventListener('keydown', (event) => {
      if (panel.hidden) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeSettings();
      }
      if (event.key !== 'Tab') return;
      const focusable = Array.from(
        panel.querySelectorAll(
          'button, [href], input:not([disabled]), select, textarea, [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => el.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    document.addEventListener('click', (event) => {
      const target =
        event.target instanceof Element
          ? event.target.closest('[data-open-cookie-settings]')
          : null;
      if (!target) return;
      event.preventDefault();
      openSettings();
    });

    document.addEventListener('bubu:open-cookie-settings', openSettings);
    if (!readCookie()) openBanner();
  })();
</script>

<style>
  .cookie-consent {
    position: fixed;
    z-index: 1000;
    inset: auto 18px 18px;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .cookie-card {
    width: min(960px, 100%);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 22px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 24px 80px #17335f24;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 22px;
    align-items: center;
    pointer-events: auto;
  }
  .cookie-card h2 {
    font-size: clamp(1.35rem, 2vw, 1.8rem);
  }
  .cookie-card p,
  .cookie-option small {
    font-size: 0.82rem;
  }
  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }
  .cookie-link {
    border: 0;
    background: transparent;
    color: var(--brand-dark);
    font-weight: 750;
    text-decoration: underline;
    text-underline-offset: 4px;
    padding: 8px;
  }
  .cookie-settings {
    grid-template-columns: 1fr;
    max-width: 720px;
  }
  .cookie-options {
    display: grid;
    gap: 12px;
  }
  .cookie-option {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    border: 1px solid #d7e4df;
    border-radius: 14px;
    padding: 14px;
    background: #f8fbfa;
  }
  .cookie-option input {
    width: 22px;
    height: 22px;
    margin-top: 3px;
  }
  .cookie-option span {
    display: grid;
    gap: 3px;
  }
  .cookie-option small {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .cookie-consent {
      inset: auto 10px 10px;
    }
    .cookie-card {
      grid-template-columns: 1fr;
      padding: 18px;
      max-height: calc(100dvh - 20px);
      overflow: auto;
    }
    .cookie-actions,
    .cookie-actions .btn,
    .cookie-link {
      width: 100%;
    }
  }
</style>
