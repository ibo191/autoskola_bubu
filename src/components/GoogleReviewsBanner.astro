---
import { fallbackGoogleReviews } from '../lib/google/reviews';
const fallback = fallbackGoogleReviews;
const fallbackReviews = fallback.reviews.slice(0, 5);
const stars = '★★★★★';
---

<section class="section google-reviews" data-reveal data-google-reviews>
  <div class="container">
    <div class="google-board">
      <div class="google-summary">
        <span class="eyebrow">Google recenze</span>
        <div class="google-logo" aria-label="Google">
          <span>G</span><span>o</span><span>o</span><span>g</span><span>l</span><span>e</span>
        </div>
        <h2>Žáci oceňují klid, respekt a&nbsp;jasný plán.</h2>
        <div class="rating-row">
          <strong data-rating>{fallback.rating.toFixed(1).replace('.', ',')}</strong>
          <span class="stars" aria-label={`${fallback.rating} z 5 hvězdiček`}>{stars}</span>
          <span class="review-count" data-review-count>{fallback.userRatingCount} recenzí</span>
        </div>
        <p>Reálné recenze načítáme z veřejného Google profilu pobočky Autoškola BuBu Střížkov.</p>
        <a
          class="all-reviews"
          data-google-link
          href={fallback.googleMapsUri}
          target="_blank"
          rel="noopener noreferrer"
        >
          Zobrazit všechny recenze na Google
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="reviews-panel">
        <div class="carousel-top">
          <span>Nejnovější zkušenosti žáků</span>
          <div class="carousel-actions" aria-label="Posun recenzí">
            <button type="button" data-reviews-prev aria-label="Předchozí recenze">←</button>
            <button type="button" data-reviews-next aria-label="Další recenze">→</button>
          </div>
        </div>
        <div class="reviews-list" data-reviews-list>
          {
            fallbackReviews.map((review) => (
              <article class="review-card">
                <div class="review-head">
                  <div class="avatar" aria-hidden="true">
                    {review.authorName.charAt(0)}
                  </div>
                  <div>
                    <strong>{review.authorName}</strong>
                    <span>{review.relativeTime}</span>
                  </div>
                </div>
                <span class="stars" aria-label={`${review.rating} z 5 hvězdiček`}>
                  {stars.slice(0, Math.round(review.rating))}
                </span>
                <p>{review.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type GoogleReview = {
    id: string;
    authorName: string;
    authorUri?: string;
    authorPhotoUri?: string;
    rating: number;
    text: string;
    relativeTime?: string;
    reviewUri?: string;
  };

  type ReviewsPayload = {
    configured: boolean;
    placeName: string;
    rating: number;
    userRatingCount: number;
    googleMapsUri: string;
    reviews: GoogleReview[];
  };

  const section = document.querySelector<HTMLElement>('[data-google-reviews]');
  const list = section?.querySelector<HTMLElement>('[data-reviews-list]');
  const rating = section?.querySelector<HTMLElement>('[data-rating]');
  const count = section?.querySelector<HTMLElement>('[data-review-count]');
  const link = section?.querySelector<HTMLAnchorElement>('[data-google-link]');
  const prev = section?.querySelector<HTMLButtonElement>('[data-reviews-prev]');
  const next = section?.querySelector<HTMLButtonElement>('[data-reviews-next]');

  const entityMap: Record<string, string> = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
  };
  const escapeText = (value: string) => value.replace(/[&<>"]/g, (char) => entityMap[char] ?? char);

  const renderStars = (value: number) =>
    '★★★★★'.slice(0, Math.max(1, Math.min(5, Math.round(value))));

  const renderReview = (review: GoogleReview) => {
    const author = escapeText(review.authorName || 'Google uživatel');
    const text = escapeText(review.text || '');
    const time = escapeText(review.relativeTime || 'Google recenze');
    const stars = renderStars(review.rating || 5);
    const photo = review.authorPhotoUri
      ? `<img src="${escapeText(review.authorPhotoUri)}" alt="" loading="lazy" referrerpolicy="no-referrer" />`
      : escapeText(author.charAt(0));
    const reviewLink = review.reviewUri
      ? `<a class="review-link" href="${escapeText(review.reviewUri)}" target="_blank" rel="noopener noreferrer">Zobrazit na Google ↗</a>`
      : '';
    return `<article class="review-card">
      <div class="review-head">
        <div class="avatar" aria-hidden="true">${photo}</div>
        <div><strong>${author}</strong><span>${time}</span></div>
      </div>
      <span class="stars" aria-label="${escapeText(String(review.rating || 5))} z 5 hvězdiček">${stars}</span>
      <p>${text}</p>
      ${reviewLink}
    </article>`;
  };

  const cardStep = () => {
    const firstCard = list?.querySelector<HTMLElement>('.review-card');
    if (!firstCard || !list) return 380;
    const gap = Number.parseFloat(getComputedStyle(list).columnGap || '18') || 18;
    return firstCard.getBoundingClientRect().width + gap;
  };

  const loadReviews = async () => {
    if (!section || !list || !rating || !count || !link) return;
    try {
      const response = await fetch('/api/google-reviews', {
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) return;
      const data = (await response.json()) as ReviewsPayload;
      rating.textContent = data.rating.toFixed(1).replace('.', ',');
      count.textContent = `${data.userRatingCount} recenzí`;
      link.href = data.googleMapsUri;
      link.innerHTML = `Zobrazit všech ${data.userRatingCount} recenzí na Google <span aria-hidden="true">↗</span>`;
      if (data.reviews.length) list.innerHTML = data.reviews.slice(0, 5).map(renderReview).join('');
    } catch {
      /* The static fallback stays visible when Google reviews are unavailable. */
    }
  };

  prev?.addEventListener('click', () => {
    list?.scrollBy({ left: -cardStep(), behavior: 'smooth' });
  });

  next?.addEventListener('click', () => {
    list?.scrollBy({ left: cardStep(), behavior: 'smooth' });
  });

  loadReviews();
</script>

<style is:global>
  [data-google-reviews].google-reviews {
    background: #f8fafc;
    border-block: 1px solid var(--line);
  }
  [data-google-reviews] .google-board {
    display: grid;
    grid-template-columns: minmax(260px, 0.38fr) minmax(0, 0.62fr);
    gap: clamp(20px, 4vw, 38px);
    align-items: stretch;
    border: 1px solid #dadce0;
    border-radius: 26px;
    background: #fff;
    padding: clamp(18px, 3vw, 30px);
    box-shadow: 0 16px 42px rgba(60, 64, 67, 0.11);
  }
  [data-google-reviews] .google-summary {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
  }
  [data-google-reviews] .google-logo {
    display: flex;
    align-items: center;
    margin-top: 10px;
    font-family: Arial, sans-serif;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
  }
  [data-google-reviews] .google-logo span:nth-child(1),
  [data-google-reviews] .google-logo span:nth-child(4) {
    color: #4285f4;
  }
  [data-google-reviews] .google-logo span:nth-child(2),
  [data-google-reviews] .google-logo span:nth-child(6) {
    color: #ea4335;
  }
  [data-google-reviews] .google-logo span:nth-child(3) {
    color: #fbbc05;
  }
  [data-google-reviews] .google-logo span:nth-child(5) {
    color: #34a853;
  }
  [data-google-reviews] .google-summary h2 {
    max-width: 420px;
    margin-top: 12px;
    color: var(--ink);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.08;
  }
  [data-google-reviews] .google-summary p {
    max-width: 410px;
    margin-top: 14px;
    color: #5f6368;
    font-size: 0.9rem;
  }
  [data-google-reviews] .rating-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin-top: 18px;
  }
  [data-google-reviews] .rating-row strong {
    color: #202124;
    font-size: 2rem;
    line-height: 1;
  }
  [data-google-reviews] .stars {
    color: #fbbc04;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  [data-google-reviews] .review-count {
    color: #5f6368;
    font-size: 0.88rem;
    font-weight: 650;
  }
  [data-google-reviews] .all-reviews,
  [data-google-reviews] .review-link {
    color: #1a73e8;
    font-size: 0.86rem;
    font-weight: 750;
    text-decoration: none;
  }
  [data-google-reviews] .all-reviews {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    border: 1px solid #dadce0;
    border-radius: 999px;
    padding: 10px 15px;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  [data-google-reviews] .all-reviews:hover {
    border-color: #c6dafc;
    background: #f1f6ff;
    box-shadow: 0 6px 18px rgba(26, 115, 232, 0.12);
  }
  [data-google-reviews] .reviews-panel {
    min-width: 0;
  }
  [data-google-reviews] .carousel-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
  }
  [data-google-reviews] .carousel-top span {
    color: #5f6368;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  [data-google-reviews] .carousel-actions {
    display: flex;
    gap: 8px;
  }
  [data-google-reviews] .carousel-actions button {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid #dadce0;
    border-radius: 999px;
    background: #fff;
    color: #3c4043;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 850;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  [data-google-reviews] .carousel-actions button:hover {
    transform: translateY(-1px);
    border-color: #c6dafc;
    background: #f1f6ff;
    color: #1a73e8;
  }
  [data-google-reviews] .reviews-list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 18px) / 2);
    gap: 18px;
    overflow-x: auto;
    padding: 3px 2px 16px;
    scroll-padding-inline: 2px;
    scroll-snap-type: x mandatory;
    scrollbar-color: #dadce0 transparent;
  }
  [data-google-reviews] .review-card {
    display: flex;
    min-width: 0;
    min-height: 220px;
    flex-direction: column;
    gap: 10px;
    border: 1px solid #e0e3e7;
    border-radius: 18px;
    background: #fff;
    padding: 18px;
    box-shadow: 0 4px 14px rgba(60, 64, 67, 0.08);
    scroll-snap-align: start;
  }
  [data-google-reviews] .review-head {
    display: flex;
    min-width: 0;
    gap: 11px;
    align-items: center;
  }
  [data-google-reviews] .review-head > div:last-child {
    min-width: 0;
  }
  [data-google-reviews] .review-head strong,
  [data-google-reviews] .review-head span {
    display: block;
  }
  [data-google-reviews] .review-head strong {
    overflow: hidden;
    color: #202124;
    font-size: 0.92rem;
    font-weight: 750;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  [data-google-reviews] .review-head span {
    color: #70757a;
    font-size: 0.76rem;
  }
  [data-google-reviews] .avatar {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    place-items: center;
    overflow: hidden;
    border-radius: 999px;
    background: #e8f0fe;
    color: #1a73e8;
    font-family: Arial, sans-serif;
    font-weight: 800;
  }
  [data-google-reviews] .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  [data-google-reviews] .review-card p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    color: #3c4043;
    font-size: 0.86rem;
    line-height: 1.55;
  }
  [data-google-reviews] .review-link {
    margin-top: auto;
  }
  @media (max-width: 980px) {
    [data-google-reviews] .google-board {
      grid-template-columns: 1fr;
    }
    [data-google-reviews] .google-summary h2,
    [data-google-reviews] .google-summary p {
      max-width: 640px;
    }
  }
  @media (max-width: 640px) {
    [data-google-reviews] .google-board {
      border-radius: 22px;
      padding: 18px;
    }
    [data-google-reviews] .carousel-top {
      align-items: flex-start;
    }
    [data-google-reviews] .carousel-actions button {
      width: 34px;
      height: 34px;
    }
    [data-google-reviews] .reviews-list {
      grid-auto-columns: min(86vw, 330px);
    }
    [data-google-reviews] .review-card {
      min-height: 215px;
    }
    [data-google-reviews] .all-reviews {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
