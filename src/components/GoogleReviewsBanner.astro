---
import { fallbackGoogleReviews } from '../lib/google/reviews';
const fallback = fallbackGoogleReviews;
const fallbackReviews = fallback.reviews.slice(0, 5);
const stars = '★★★★★';
---

<section class="section google-reviews" data-reveal data-google-reviews>
  <div class="container reviews-shell">
    <div class="reviews-copy">
      <span class="eyebrow">Proč právě BuBu</span>
      <h2>Autoškola, kde vás připravíme na skutečný provoz.</h2>
      <p>
        Učíme klidně, lidsky a s jasným plánem. Nechceme jen odjezdit povinné hodiny — chceme,
        abyste se za volantem nebo na motorce cítili bezpečně, samostatně a připraveně na reálnou
        zkoušku.
      </p>
      <div class="rating-card">
        <span class="google-label">Google</span>
        <strong data-rating>{fallback.rating.toFixed(1).replace('.', ',')}</strong>
        <span class="stars" aria-label={`${fallback.rating} z 5 hvězdiček`}>{stars}</span>
        <a data-google-link href={fallback.googleMapsUri} target="_blank" rel="noopener noreferrer">
          Zobrazit všechny recenze na Google ↗
        </a>
      </div>
    </div>
    <div class="reviews-carousel">
      <div class="carousel-top">
        <span>Co o nás říkají žáci</span>
        <div class="carousel-actions" aria-label="Posun recenzí">
          <button type="button" data-reviews-prev aria-label="Předchozí recenze">←</button>
          <button type="button" data-reviews-next aria-label="Další recenze">→</button>
        </div>
      </div>
      <div class="reviews-list" data-reviews-list>
        {
          fallbackReviews.map((review) => (
            <article class="review-card">
              <div class="review-head">
                <div class="avatar" aria-hidden="true">
                  {review.authorName.charAt(0)}
                </div>
                <div>
                  <strong>{review.authorName}</strong>
                  <span>{review.relativeTime}</span>
                </div>
              </div>
              <span class="stars" aria-label={`${review.rating} z 5 hvězdiček`}>
                {stars.slice(0, Math.round(review.rating))}
              </span>
              <p>{review.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  type GoogleReview = {
    id: string;
    authorName: string;
    authorUri?: string;
    authorPhotoUri?: string;
    rating: number;
    text: string;
    relativeTime?: string;
    reviewUri?: string;
  };

  type ReviewsPayload = {
    configured: boolean;
    placeName: string;
    rating: number;
    userRatingCount: number;
    googleMapsUri: string;
    reviews: GoogleReview[];
  };

  const section = document.querySelector<HTMLElement>('[data-google-reviews]');
  const list = section?.querySelector<HTMLElement>('[data-reviews-list]');
  const rating = section?.querySelector<HTMLElement>('[data-rating]');
  const link = section?.querySelector<HTMLAnchorElement>('[data-google-link]');
  const prev = section?.querySelector<HTMLButtonElement>('[data-reviews-prev]');
  const next = section?.querySelector<HTMLButtonElement>('[data-reviews-next]');

  const entityMap: Record<string, string> = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
  };
  const escapeText = (value: string) => value.replace(/[&<>"]/g, (char) => entityMap[char] ?? char);

  const renderStars = (value: number) =>
    '★★★★★'.slice(0, Math.max(1, Math.min(5, Math.round(value))));

  const renderReview = (review: GoogleReview) => {
    const author = escapeText(review.authorName || 'Google uživatel');
    const text = escapeText(review.text || '');
    const time = escapeText(review.relativeTime || 'Google recenze');
    const stars = renderStars(review.rating || 5);
    const photo = review.authorPhotoUri
      ? `<img src="${escapeText(review.authorPhotoUri)}" alt="" loading="lazy" referrerpolicy="no-referrer" />`
      : escapeText(author.charAt(0));
    const reviewLink = review.reviewUri
      ? `<a class="review-link" href="${escapeText(review.reviewUri)}" target="_blank" rel="noopener noreferrer">Zobrazit na Google ↗</a>`
      : '';
    return `<article class="review-card">
      <div class="review-head">
        <div class="avatar" aria-hidden="true">${photo}</div>
        <div><strong>${author}</strong><span>${time}</span></div>
      </div>
      <span class="stars" aria-label="${escapeText(String(review.rating || 5))} z 5 hvězdiček">${stars}</span>
      <p>${text}</p>
      ${reviewLink}
    </article>`;
  };

  const loadReviews = async () => {
    if (!section || !list || !rating || !link) return;
    try {
      const response = await fetch('/api/google-reviews', {
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) return;
      const data = (await response.json()) as ReviewsPayload;
      rating.textContent = data.rating.toFixed(1).replace('.', ',');
      link.href = data.googleMapsUri;
      link.textContent = `Zobrazit všech ${data.userRatingCount} recenzí na Google ↗`;
      if (data.reviews.length) list.innerHTML = data.reviews.slice(0, 5).map(renderReview).join('');
    } catch {
      /* The static fallback stays visible when Google reviews are unavailable. */
    }
  };

  prev?.addEventListener('click', () => {
    list?.scrollBy({ left: -360, behavior: 'smooth' });
  });

  next?.addEventListener('click', () => {
    list?.scrollBy({ left: 360, behavior: 'smooth' });
  });

  loadReviews();
</script>

<style>
  .google-reviews {
    background: linear-gradient(135deg, #ffffff 0%, #f3f8f7 58%, #e0f4f0 100%);
    border-block: 1px solid var(--line);
  }
  .reviews-shell {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .reviews-copy p {
    max-width: 520px;
    margin-top: 18px;
  }
  .rating-card {
    display: grid;
    gap: 8px;
    max-width: 320px;
    margin-top: 28px;
    border: 1px solid rgba(74, 185, 171, 0.35);
    border-radius: var(--radius);
    background: #fff;
    padding: 24px;
    box-shadow: var(--shadow);
  }
  .google-label {
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .rating-card strong {
    color: var(--ink);
    font-size: 3.7rem;
    line-height: 0.95;
  }
  .stars {
    color: #f5ad2d;
    font-size: 1rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .rating-card a,
  .review-link {
    color: var(--brand-dark);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
  }
  .reviews-carousel {
    min-width: 0;
  }
  .carousel-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }
  .carousel-top span {
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .carousel-actions {
    display: flex;
    gap: 8px;
  }
  .carousel-actions button {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(74, 185, 171, 0.42);
    border-radius: 999px;
    background: #fff;
    color: var(--brand-dark);
    cursor: pointer;
    font-size: 1.2rem;
    font-weight: 900;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }
  .carousel-actions button:hover {
    transform: translateY(-1px);
    background: var(--brand);
    color: #fff;
  }
  .reviews-list {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding: 4px 4px 18px;
    scroll-padding-inline: 4px;
    scroll-snap-type: x mandatory;
    scrollbar-color: rgba(74, 185, 171, 0.7) transparent;
  }
  .review-card {
    display: flex;
    min-width: min(31vw, 330px);
    min-height: 270px;
    flex-direction: column;
    gap: 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    padding: 22px;
    box-shadow: 0 12px 32px rgba(23, 51, 95, 0.07);
    scroll-snap-align: start;
  }
  .review-head {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .review-head strong,
  .review-head span {
    display: block;
  }
  .review-head strong {
    font-size: 0.92rem;
  }
  .review-head span {
    color: var(--muted);
    font-size: 0.76rem;
  }
  .avatar {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    place-items: center;
    overflow: hidden;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-dark);
    font-weight: 900;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .review-card p {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 0;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    font-size: 0.9rem;
  }
  .review-link {
    margin-top: auto;
  }
  @media (max-width: 980px) {
    .reviews-shell {
      grid-template-columns: 1fr;
    }
    .review-card {
      min-width: min(46vw, 340px);
    }
  }
  @media (max-width: 640px) {
    .carousel-top {
      align-items: flex-start;
    }
    .carousel-actions button {
      width: 38px;
      height: 38px;
    }
    .review-card {
      min-width: min(86vw, 340px);
      min-height: 250px;
    }
    .rating-card {
      max-width: none;
    }
  }
</style>
