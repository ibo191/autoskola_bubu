---
import { Image } from 'astro:assets';
import manualCar from '../assets/courses/b-manual-fabia.png';
import automaticCar from '../assets/courses/b-automatic-scala.png';
import moto from '../assets/moto.jpeg';
import trailer from '../assets/trailer.jpeg';
import { displayPrice, money, type Course, type BranchId } from '../lib/catalog';
interface Props {
  course: Course;
  branch?: BranchId;
  photo?: boolean;
}
const { course, branch = 'strizkov', photo = false } = Astro.props;
const asset =
  course.id === 'b-automat'
    ? automaticCar
    : course.category === 'auto'
      ? manualCar
      : course.category === 'moto'
        ? moto
        : trailer;
---

<article
  class:list={['course-card', { photographic: photo }]}
  data-category={course.category}
  data-course-url={`/kurzy/${course.slug}`}
  tabindex="0"
  role="link"
>
  {
    photo && (
      <Image
        src={asset}
        alt={
          course.id === 'b-automat'
            ? 'Černá Škoda Scala Autoškoly BuBu pro automat'
            : course.category === 'auto'
              ? 'Bílá Škoda Fabia Autoškoly BuBu pro manuál'
              : course.category === 'moto'
                ? 'Motocykly Autoškoly BuBu'
                : 'Auto s přívěsem Autoškoly BuBu'
        }
        widths={[360, 600]}
        sizes="(max-width:640px) 90vw, 360px"
        format="webp"
        loading="lazy"
      />
    )
  }
  <div class="course-body">
    <span class="eyebrow">{course.label}</span><h3>{course.name}</h3><p>{course.description}</p><div
      class="price"
    >
      {course.category === 'moto' && <small>od </small>}{money(displayPrice(course, branch))}
    </div><p class="small">
      {
        course.category === 'moto'
          ? 'Cena podle oprávnění a balíčku. Bez oprávnění pouze Moto Jistota.'
          : 'Jedna cena kurzu. Bez volby balíčku.'
      }
    </p><div class="card-actions">
      <button class="btn primary" data-order disabled data-course={course.id} data-branch={branch}
        >Vybrat kurz ↗</button
      ><span class="text-link" aria-hidden="true">Otevřít kurz →</span>
    </div>
  </div>
</article>
<script>
  document.querySelectorAll<HTMLElement>('[data-course-url]').forEach((card) => {
    const openCourse = () => {
      const url = card.dataset.courseUrl;
      if (url) window.location.assign(url);
    };
    card.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('button, a')) return;
      openCourse();
    });
    card.addEventListener('keydown', (event) => {
      if (event.target !== card || (event.key !== 'Enter' && event.key !== ' ')) return;
      event.preventDefault();
      openCourse();
    });
  });
</script>
<style>
  .course-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: white;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition:
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 280ms ease,
      border-color 280ms ease;
  }
  .course-card:hover {
    transform: translateY(-5px);
    border-color: #9ed6ce;
    box-shadow: var(--shadow);
  }
  .course-card:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 3px;
  }
  .course-card > img {
    width: 100%;
    aspect-ratio: 1.65;
    object-fit: cover;
  }
  .course-body {
    padding: 28px;
    display: flex;
    flex: 1;
    flex-direction: column;
  }
  .course-body .eyebrow {
    margin-bottom: 12px;
  }
  .course-body h3 {
    font-size: 1.4rem;
  }
  .course-body > p {
    font-size: 0.88rem;
    margin-top: 14px;
  }
  .course-body > p.small {
    font-size: 0.74rem;
    margin-top: 4px;
  }
  .price {
    margin-top: auto;
    padding-top: 25px;
    font-size: 1.9rem;
  }
  .card-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .card-actions .text-link {
    font-size: 0.78rem;
    font-weight: 600;
  }
  .card-actions .btn {
    font-size: 0.8rem;
    padding-inline: 16px;
  }
</style>
