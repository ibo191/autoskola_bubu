---
interface Props {
  mobileCarousel?: boolean;
}
const { mobileCarousel = false } = Astro.props;

const steps = [
  {
    title: 'Online objednávka',
    summary: 'Kurz, pobočku i termín zápisu si vyberete online.',
    detail:
      'Kurz si vyberete na našem webu a přihlásíte se do něj online. V posledním kroku si zvolíte datum a čas, kdy se dostavíte k osobnímu zápisu do autoškoly.',
    icon: 'pencil',
  },
  {
    title: 'Osobní zápis',
    summary: 'Dokumenty společně vyřídíme na vaší pobočce.',
    detail:
      'Při osobním zápisu spolu vyřídíme přihlášku a potřebné dokumenty. Domluvíme se na platbě kurzu, případně ji můžete rovnou uhradit, a oznámíme vám datum začátku kurzu. Přineste žádost o přijetí k výuce a výcviku a zdravotní posudek.',
    icon: 'calendar',
  },
  {
    title: 'Teorie',
    summary: 'Poznáte pravidla a připravíte se na provoz.',
    detail:
      'Při zápisu se dozvíte, kdy váš kurz začíná a kdy přijdete na první teorii. Po absolvování všech povinných bloků proběhne na pobočce interní teoretický test, při kterém si společně ověříme vaše znalosti.',
    icon: 'classroom-solid',
  },
  {
    title: 'Praktické jízdy',
    summary: 'Za volant usednete se svým přiděleným instruktorem.',
    detail:
      'Po úspěšném absolvování našeho interního ověření znalostí pravidel silničního provozu usednete do auta a začnete praktické jízdy za volantem se svým přiděleným instruktorem.',
    icon: 'car',
  },
  {
    title: 'Závěrečná zkouška',
    summary: 'Teoretická část a závěrečná praktická jízda.',
    detail:
      'Teoretická část závěrečné zkoušky zpravidla probíhá na příslušném úřadě podle vaší pobočky. Praktická jízda se koná v okolí pobočky autoškoly nebo příslušného úřadu.',
    icon: 'graduation',
  },
];
---

<section class="section roadmap-section" aria-labelledby="roadmap-title" data-reveal>
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Od přihlášky k řidičáku</span><h2 id="roadmap-title">
          Víte, co vás čeká.<br />Krok za krokem.
        </h2>
      </div><a class="text-link" href="/jak-probiha-vyuka">Jak probíhá výuka ↗</a>
    </div>
    <ol
      class:list={['roadmap', { 'roadmap-carousel': mobileCarousel }]}
      id={mobileCarousel ? 'learning-roadmap-steps' : undefined}
      data-road-progress="0"
    >
      {
        steps.map((step, i) => (
          <li class:list={{ active: i === 0 }}>
            <button
              type="button"
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`road-detail-${i}`}
              data-road-step={i}
            >
              <span class="step-top">
                <img
                  src={`/icons/ui/blue-${step.icon}.webp`}
                  alt=""
                  width="192"
                  height="192"
                  loading="lazy"
                />
                <span class="step-number">0{i + 1}</span>
              </span>
              <>
                <h3>{step.title}</h3>
                <p>{step.summary}</p>
              </>
            </button>
          </li>
        ))
      }
    </ol>
    {
      mobileCarousel && (
        <div class="roadmap-controls" role="group" aria-label="Ovládání kroků">
          <button
            type="button"
            data-road-direction="-1"
            aria-label="Předchozí krok"
            aria-controls="learning-roadmap-steps"
            aria-disabled="true"
          >
            <span aria-hidden="true">←</span>
          </button>
          <span data-road-position>1 / {steps.length}</span>
          <button
            type="button"
            data-road-direction="1"
            aria-label="Další krok"
            aria-controls="learning-roadmap-steps"
            aria-disabled="false"
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>
      )
    }
    <div class="roadmap-details" aria-live="polite">
      {
        steps.map((step, i) => (
          <article id={`road-detail-${i}`} data-road-detail={i} hidden={i !== 0}>
            <>
              <span class="detail-number">0{i + 1}</span>
              <div>
                <>
                  <h3>{step.title}</h3>
                  <p>{step.detail}</p>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLOListElement>('.roadmap').forEach((roadmap) => {
    const buttons = roadmap.querySelectorAll<HTMLButtonElement>('[data-road-step]');
    const details = roadmap.parentElement?.querySelectorAll<HTMLElement>('[data-road-detail]');
    const controls = roadmap.parentElement?.querySelector<HTMLElement>('.roadmap-controls');
    const directions = controls?.querySelectorAll<HTMLButtonElement>('[data-road-direction]');
    const position = controls?.querySelector<HTMLElement>('[data-road-position]');
    const isMobile = window.matchMedia('(max-width: 767px)');
    let activeIndex = 0;

    function activate(index: number) {
      activeIndex = index;
      buttons.forEach((step, stepIndex) => {
        const active = stepIndex === index;
        step.setAttribute('aria-pressed', String(active));
        step.setAttribute('aria-expanded', String(active));
        step.closest('li')?.classList.toggle('active', active);
        if (controls && isMobile.matches) step.tabIndex = active ? 0 : -1;
      });
      details?.forEach((detail, detailIndex) => (detail.hidden = detailIndex !== index));
      roadmap.dataset.roadProgress = String(index);
      if (position) position.textContent = `${index + 1} / ${buttons.length}`;
      directions?.[0]?.setAttribute('aria-disabled', String(index === 0));
      directions?.[1]?.setAttribute('aria-disabled', String(index === buttons.length - 1));
    }

    function moveTo(index: number, focusStep = false) {
      if (index < 0 || index >= buttons.length) return;
      activate(index);
      if (!controls || !isMobile.matches) return;
      roadmap.scrollLeft = roadmap.clientWidth * index;
      if (focusStep) buttons[index]?.focus({ preventScroll: true });
    }

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => moveTo(index));
    });

    if (!controls) return;
    directions?.forEach((button) => {
      button.addEventListener('click', () =>
        moveTo(activeIndex + Number(button.dataset.roadDirection)),
      );
    });
    roadmap.addEventListener('keydown', (event) => {
      if (!isMobile.matches) return;
      const indexByKey: Record<string, number> = {
        ArrowLeft: activeIndex - 1,
        ArrowRight: activeIndex + 1,
        Home: 0,
        End: buttons.length - 1,
      };
      const index = indexByKey[event.key];
      if (typeof index !== 'number') return;
      event.preventDefault();
      moveTo(index, true);
    });
    roadmap.addEventListener(
      'scroll',
      () => {
        if (!isMobile.matches || !roadmap.clientWidth) return;
        const index = Math.round(roadmap.scrollLeft / roadmap.clientWidth);
        if (index >= 0 && index < buttons.length && index !== activeIndex) {
          const stepHadFocus = document.activeElement === buttons[activeIndex];
          activate(index);
          if (stepHadFocus) buttons[index]?.focus({ preventScroll: true });
        }
      },
      { passive: true },
    );
    function syncViewport() {
      if (isMobile.matches) {
        moveTo(activeIndex);
      } else {
        buttons.forEach((button) => button.removeAttribute('tabindex'));
      }
    }
    isMobile.addEventListener('change', syncViewport);
    syncViewport();
  });
</script>
<style>
  .roadmap-controls {
    display: none;
  }
  .roadmap {
    --road-progress: 0%;
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .roadmap::before,
  .roadmap::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    border-radius: 3px;
  }
  .roadmap[data-road-progress='1'] {
    --road-progress: 25%;
  }
  .roadmap[data-road-progress='2'] {
    --road-progress: 50%;
  }
  .roadmap[data-road-progress='3'] {
    --road-progress: 75%;
  }
  .roadmap[data-road-progress='4'] {
    --road-progress: 100%;
  }
  .roadmap::before {
    width: 100%;
    background: var(--line);
  }
  .roadmap::after {
    width: var(--road-progress);
    background: linear-gradient(90deg, var(--brand), var(--blue));
    transition: width 460ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .roadmap li {
    position: relative;
    padding-top: 18px;
  }
  .roadmap button {
    width: 100%;
    height: 100%;
    padding: 16px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    text-align: left;
    transition:
      background 260ms ease,
      border-color 260ms ease,
      transform 260ms ease;
  }
  .roadmap button:hover {
    transform: translateY(-3px);
    background: var(--brand-soft);
  }
  .roadmap li.active button {
    background: var(--brand-soft);
    border-color: #a5d9d1;
    box-shadow: inset 0 3px 0 var(--brand);
  }
  .step-number {
    display: block;
    color: var(--brand-dark);
    font-size: 0.8rem;
    font-weight: 750;
  }
  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }
  .step-top img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .roadmap li.active .step-top img,
  .roadmap button:hover .step-top img {
    transform: scale(1.08) rotate(-2deg);
  }
  .roadmap h3 {
    font-size: 0.92rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }
  .roadmap p {
    margin-top: 10px;
    font-size: 0.76rem;
  }
  .roadmap-details {
    min-height: 190px;
    margin-top: 24px;
  }
  .roadmap-details article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 22px;
    padding: 30px;
    border: 1px solid #a5d9d1;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--brand-soft), #fff 74%);
    animation: detail-enter 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .roadmap-details article[hidden] {
    display: none;
  }
  .detail-number {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #21457f;
    color: #fff;
    font-weight: 800;
  }
  .roadmap-details h3 {
    font-size: clamp(1.25rem, 2vw, 1.55rem);
  }
  .roadmap-details p {
    max-width: 900px;
    margin-top: 9px;
    line-height: 1.7;
  }
  @keyframes detail-enter {
    from {
      transform: translateY(8px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  @media (max-width: 1050px) {
    .roadmap {
      grid-template-columns: repeat(3, 1fr);
    }
    .roadmap::before,
    .roadmap::after {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .roadmap {
      grid-template-columns: 1fr;
    }
    .roadmap li {
      padding: 6px 0 0;
    }
    .roadmap button {
      padding: 15px 18px;
    }
    .roadmap p {
      margin-top: 5px;
    }
    .roadmap-details {
      min-height: 260px;
      margin-top: 18px;
    }
    .roadmap-details article {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 23px;
    }
  }
  @media (max-width: 767px) {
    .roadmap-carousel {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .roadmap-carousel li {
      min-width: 0;
      padding: 4px;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
    .roadmap-carousel button:hover {
      transform: none;
    }
    .roadmap-carousel button:focus-visible {
      outline-offset: -3px;
    }
    .roadmap-controls {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 12px;
      margin-top: 10px;
      text-align: center;
      font-weight: 750;
      color: var(--brand-dark);
    }
    .roadmap-controls button {
      min-width: 44px;
      min-height: 44px;
      border: 1px solid var(--brand);
      border-radius: 12px;
      background: var(--brand-soft);
      color: var(--brand-dark);
      font-size: 1.3rem;
    }
    .roadmap-controls button[aria-disabled='true'] {
      opacity: 0.55;
      cursor: default;
    }
    .roadmap-carousel + .roadmap-controls + .roadmap-details {
      min-height: auto;
      margin-top: 12px;
    }
  }
</style>
