# Local stage A without cloud credentials.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:4321
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RECAPTCHA_ADAPTER=local
EMAIL_ADAPTER=local
ANALYTICS_ADAPTER=noop
RATE_LIMIT_SECRET=
ADMIN_ACCESS_TOKEN=
GENERAL_CONTACT_EMAIL=info@autoskolabubu.cz
LETTERMINT_PROJECT_TOKEN=
ORDER_NOTIFICATION_EMAIL=info@autoskolabubu.cz
REPORT_EMAIL=info@autoskolabubu.cz
CRON_SECRET=

# Database migration runner. Use only locally or in a secure terminal; never expose this in browser code.
LOCAL_DATABASE_URL=
SUPABASE_DB_URL=

