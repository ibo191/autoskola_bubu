{
  "name": "autoskola-bubu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs check && node scripts/astro.mjs build",
    "preview": "node scripts/serve-local.mjs",
    "check": "node scripts/astro.mjs check",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.json *.mjs",
    "format:check": "prettier --check src tests *.json *.mjs",
    "test:db": "node --env-file-if-exists=.env --import tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/node": "11.1.4",
    "astro": "7.2.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "lighthouse": "13.4.1",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
